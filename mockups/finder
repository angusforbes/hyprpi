#!/usr/bin/env node
// Agents and projects finder (Angus, 2026-09-29; SUPER+SHIFT+SPACE): the Omarchy menu, as the apps
// menu (SUPER+ALT+SPACE) shows it, listing every world's live and parked agents and its open
// projects: agents A–Z first, then projects A–Z. The search box reads "Agents…" (the prompt, Angus). Type to filter (the subtext counts too: "C3", "working"), ↑↓, Enter, Esc.
//   Enter on an agent    jump to its window (parked: brought back here)
//   Enter on a project   its card in that world's projects panel (the panel comes here)
// Plan: ~/Obsidian/Tinker/2026-09-29 Agents and projects finder.md
//
//   ~/Work/hyprpi/mockups/finder            open the menu
//   ~/Work/hyprpi/mockups/finder --list     print the rows instead (tests, a quick look)
//
// Pressing the key again while the menu is open closes it (like the apps menu toggle).
// omarchy-menu-select waits for the menu to write a "done" file; if the menu goes away without
// writing it (seen once: a picker polled for 35 h), we give up after TIMEOUT_S and kill it.
import fs from "node:fs";
import path from "node:path";
import { spawn, execFile } from "node:child_process";
import { request } from "../lib/client.mjs";
import * as hypr from "../lib/hypr.mjs";
// J333: an isolated hyprpi (test socket/state) opens no windows on the real desktop.
{ const why = hypr.hyprBlocked(); if (why) { console.error(`hypr actions disabled (isolated daemon: ${why}); HYPRPI_ALLOW_HYPR=1 allows them`); process.exit(1); } }
import { runtimeDir, loadConfig, wsLabel, WORLD_LETTERS, stateDir } from "../lib/paths.mjs";
import { worldHex, unnamed } from "../lib/tui/term.mjs";
import { isAppWindow, appLabel, stateNote } from "../lib/apps.mjs";
import { heldForSandboxes } from "../lib/held.mjs";
import { sbxIcon } from "../lib/sandbox-icon.mjs"; // J423

// Which pop-up (Angus, @hyprpi D8): "plugin" (default) is our own copy of the Omarchy menu, the
// omarchy-shell plugin agf.hyprpi-finder (shell-plugin/; the same look, plus colour: names in the
// agent's colour, the workspace in its world's colour, times grey). "menu" is the plain Omarchy menu.
// "finderStyle" in ~/.config/hyprpi/config.json; the menu is also the fallback when the plugin isn't
// installed or enabled (shell-plugin/install).
const PLUGIN = "agf.hyprpi-finder";
const STYLE = loadConfig().finderStyle === "menu" ? "menu" : "plugin";
const TIMEOUT_S = Number(process.env.HYPRPI_FINDER_TIMEOUT) || 600; // env only for tests
// Rows show only icon + name (Angus, 2026-09-29: one line each, so far more fit in the menu, which
// caps itself at 70% of the screen). "finderDetail": true in ~/.config/hyprpi/config.json brings
// back the grey line under each name (workspace · status · topic / world · members · where).
const DETAIL = loadConfig().finderDetail === true;
const here = new URL(".", import.meta.url).pathname;
// --summon (SUPER+S; Angus): the same pop-up, as the summon menu: THIS world's agents, hyprpi panels
// (TUIs) and projects (a project = its live members in this world). Tab toggles a light-grey mark
// (several come together); ⏎ summons the marked rows, or the one under the cursor if none is marked,
// to the workspace you're on. No search yet (typing does nothing). A summoned panel isn't a guest:
// SUPER+D on it closes it, and the next summon / SUPER+ALT+D moves it on unless it is pinned.
const SUMMON = process.argv.includes("--summon");
let S = null; // --summon: { room, workspace } (room.current)
// The hyprpi panels by their title's kind (lib/daemon.mjs PANEL_TITLE).
// Short names (Angus, J24: "Agents D", not "agents panel D").
// J404 (Angus "3 yes"): a sandboxed world's placeholder agent (sbx-world-g "world-g", sbx-doorman-g "Doorman-G") has no
// window: it is not listed (summoning it brought nothing). Its real windows are listed instead (summon only), marked 🐳
// (Linkpath's format): the world's agents and panels from its helper's host-only windows.json (trusted only when the live
// window at that address has the same pid), and a Doorman's window (class hyprpi-doorman-<name>) in place of its app row.
const sbxPlaceholder = (a) => /^sbx-/.test(a.id || "") && a.model === "sandboxed" && !a.address;
const safeText = (s, n = 40) => { const t = String(s || "").replace(/[\u0000-\u001f\u007f-\u009f]|\p{Cf}/gu, "").replace(/\s+/g, " ").trim(); return t.length > n ? t.slice(0, n - 1) + "…" : t; }; // (untrusted: set inside the sandbox)
function sandboxWindows(clients) { // address -> { kind, name } for windows a sandboxed world's helper launched (pid-checked)
  const base = path.join(stateDir(), "worlds"), out = {};
  let names = []; try { names = fs.readdirSync(base); } catch { return out; }
  for (const n of names) {
    let j; try { j = JSON.parse(fs.readFileSync(path.join(base, n, "windows.json"), "utf8")); } catch { continue; }
    for (const [addr, w] of Object.entries(j?.windows || {})) {
      const c = clients.find((x) => x.address === addr);
      if (!c || !Number.isInteger(w?.pid) || w.pid !== c.pid || !/^hyprpi\.[a-z]-/.test(c.class || "")) continue;
      out[addr] = { kind: String(w.kind || ""), name: safeText(w.name || "") };
    }
  }
  return out;
}
// J404 (Linkpath, J403): a HOST agent sitting on a sandboxed world's workspace is shown "⚠ host Name" (its window title
// says "⚠ host · …"). The ranges come from the helpers' windows.json (lo..hi).
function sandboxRanges() {
  const base = path.join(stateDir(), "worlds"), out = [];
  let names = []; try { names = fs.readdirSync(base); } catch { return out; }
  for (const n of names) { try { const j = JSON.parse(fs.readFileSync(path.join(base, n, "windows.json"), "utf8")); if (Number.isInteger(j.lo) && Number.isInteger(j.hi)) out.push([j.lo, j.hi]); } catch { /* none */ } }
  return out;
}
// J410 (Angus: G's panel rows like the host's): what a sandboxed world's panel row can say, from host-only, validated data
// only: worlds/<w>/agents.json (world-helper keeps just what g-status validateStatus passes; "at" is a heartbeat, so it is
// used for staleness only, never as an age). G's board and stream live inside the sandbox: a neutral line for those.
const SBX_STATUS = { blocked: "needs you", working: "working", background: "working", done: "done", idle: "idle" };
function sandboxReport(room) {
  const base = path.join(stateDir(), "worlds");
  let names = []; try { names = fs.readdirSync(base); } catch { return null; }
  for (const n of names) {
    try { const j = JSON.parse(fs.readFileSync(path.join(base, n, "agents.json"), "utf8")); if (j && j.room === room && Array.isArray(j.agents)) return j; } catch { /* none */ }
  }
  return null;
}
function sandboxPanelLine(room, kind) {
  if (kind === "room" || kind === "board") return "inside the sandbox";
  const j = sandboxReport(room);
  if (!j || !(Date.now() - Number(j.at || 0) < 90000)) return "not reporting";
  if (kind === "search" || kind === "thoughts") return ["running", "idle", "off"].includes(j.thoughts) ? `Thoughts-${room} ${j.thoughts}` : "inside the sandbox";
  const c = {}; for (const a of j.agents.slice(0, 12)) { const w = SBX_STATUS[a?.status]; if (w) c[w] = (c[w] || 0) + 1; }
  return ["needs you", "working", "done", "idle"].filter((w) => c[w]).map((w) => `${c[w]} ${w}`).join(" · ") || "no live agents";
}
// J411 (Angus: "the Doorman should also look similar to the other TUIs and have the > before it"): a Doorman's window
// (class hyprpi-doorman-<name>, host-launched) as a panel row: "🚪 >Doorman G 🐳 · G3", no age. Its line: how many items
// wait for Angus in it (the relay's own pending records for that Doorman and the sandbox it serves, as its window counts
// them: lib/held.mjs heldForSandboxes; a count only, no text), else "archive + decisions".
const DOORMAN_CLASS = /^hyprpi-doorman-([a-z0-9-]+)$/;
function doormanLine(name) {
  let c = {}; try { c = JSON.parse(fs.readFileSync(path.join(process.env.XDG_CONFIG_HOME || path.join(process.env.HOME || "", ".config"), "hyprpi", "sbx-relay.json"), "utf8")); } catch { /* none */ }
  const me = (Array.isArray(c.sandboxes) ? c.sandboxes : []).find((x) => x?.name === name) || {};
  let n = 0; try { n = heldForSandboxes([name, typeof me.doorman_for === "string" ? me.doorman_for : ""].filter(Boolean)).length; } catch { /* none */ }
  return n ? `${n} waiting for you` : "archive + decisions";
}
function doormanRow(c, wsWorld, kind) {
  const ws = c.workspace.id, loc = wsLabel(ws, WORLD_SIZE), nm = `>Doorman ${wsWorld}`, here = SUMMON && ws === S.workspace ? "already here" : "";
  return { kind, sortKind: "panel", id: c.address, room: wsWorld, sort: SUMMON ? "1" + nm : nm, recent: 0, mark: "▫", glyph: "▫", sandboxed: true,
    label: `🚪 ${nm} 🐳 · ${loc}`, rich: "🚪 " + font(worldColor(wsWorld), nm) + " 🐳" + font("dim", " · ") + font(worldColor(loc[0]), loc), sub: "",
    worlds: wsWorld, ws, subtitle: [here, doormanLine(DOORMAN_CLASS.exec(c.class)[1]), SUMMON ? stateNote(c) : ""].filter(Boolean).join(" · ") };
}
const PANEL_KIND = { router: ["👥", "Agents"], room: ["💬", "Stream"], search: ["💭", "Thoughts"], thoughts: ["💭", "Thoughts"], board: ["📋", "Projects"] };
const WORLD_SIZE = loadConfig().worldSize || 10;
const STATUS = { working: "working", blocked: "needs you", done: "done", idle: "idle" };
// The agents panel's marks (Angus): ● working · × needs you · ✓ finished (unseen) · ○ idle; ◌ parked.
// A project's mark comes from its live members, most urgent first (◌ when none is live).
const markOf = (a) => a.parked ? "◌" : a.status === "working" ? "●" : a.status === "background" ? "◐" : a.status === "blocked" ? "×" : a.status === "done" && !a.seen ? "✓" : "○";
const projMark = (p, byId) => { const ms = (p.members || []).map((id) => byId[id]).filter((a) => a && !a.parked).map(markOf); return ms.length ? ["×", "●", "◐", "✓"].find((k) => ms.includes(k)) || "○" : "◌"; };
const clean = (s) => String(s ?? "").replace(/[\t\n\r\x00-\x1f\x7f]+/g, " ").trim();

// When each agent last changed state (Angus: "order the whole thing by most recently worked", so
// whoever just finished or got blocked, i.e. just dinged him, is on top): the newest turn event in
// the worlds' activity logs (finished, blocked, started a task, aborted, resumed, joined), read from
// the end of each file (they survive daemon restarts, unlike the live lastActive). Tool calls don't
// count, or busy agents would always win.
const TURN = new Set(["done", "blocked", "prompt", "aborted", "resumed", "joined"]);
function lastTurns() {
  const last = {}, dir = path.join(stateDir(), "activity");
  let files = []; try { files = fs.readdirSync(dir).filter((f) => f.endsWith(".jsonl")); } catch { return last; }
  for (const f of files) {
    let fd; try { fd = fs.openSync(path.join(dir, f), "r"); } catch { continue; }
    try {
      const size = fs.fstatSync(fd).size, n = Math.min(size, 4 << 20), buf = Buffer.alloc(n);
      fs.readSync(fd, buf, 0, n, size - n);
      for (const line of buf.toString("utf8").split("\n")) {
        if (!line.includes('"kind"')) continue;
        let e; try { e = JSON.parse(line); } catch { continue; }
        if (e.agent?.id && TURN.has(e.kind) && e.ts > (last[e.agent.id] || 0)) last[e.agent.id] = e.ts;
      }
    } finally { fs.closeSync(fd); }
  }
  return last;
}

// The last lines of a JSONL file (the newest `bytes` of it), parsed; [] when missing.
function tailJson(file, bytes = 96 << 10) {
  let fd; try { fd = fs.openSync(file, "r"); } catch { return []; }
  try {
    const size = fs.fstatSync(fd).size, n = Math.min(size, bytes), buf = Buffer.alloc(n);
    fs.readSync(fd, buf, 0, n, size - n);
    const out = [];
    for (const line of buf.toString("utf8").split("\n")) { if (!line.startsWith("{")) continue; try { out.push(JSON.parse(line)); } catch { /* a cut line */ } }
    return out;
  } finally { fs.closeSync(fd); }
}
const firstLine = (s) => clean(String(s || "").split("\n").find((l) => l.trim()) || "");

// J196 (Angus: the ">" rows should have "some helpful info like the agents and projects do … the same
// timestamps … which worlds were inactive … what the current activity is"): per world, the time and
// one-line subtitle each panel row shows. Read once per world from the files the panels themselves read.
//   >Thoughts X  the newest entry in its thread (Angus or Thoughts) · Thoughts' last reply, first line
//   >Stream X    the newest event (a room post or any agent activity, tools too) · the newest room post
//   >Agents X    the newest turn of an agent in X · "2 working · 1 needs you · 3 idle"
//   >Projects X  the newest card change on board X · "@name: what it's doing now"
const panelInfoCache = {};
function panelInfo(room, kind, ctx) {
  const k = room + ":" + kind;
  if (k in panelInfoCache) return panelInfoCache[k];
  const st = stateDir();
  let t = 0, sub = "";
  if (kind === "thoughts") {
    const th = tailJson(path.join(st, "thoughts", room + ".thread.jsonl"));
    for (const e of th) if ((e.role === "you" || e.role === "thoughts") && e.ts > t) t = e.ts;
    const r = [...th].reverse().find((e) => e.role === "thoughts" && String(e.text || "").trim()) || [...th].reverse().find((e) => e.role === "you");
    if (r) { // its first line (the next one too when the first is a short lead-in like "Done (J192):"), markdown marks off
      const ls = String(r.text).replace(/^(?:↩ from|↪ to) [^\n]+\n/, "").split("\n").map((x) => x.replace(/^\s*(?:#+|>|[-*•]|\d+\.)\s+/, "").replace(/\[([^\]]+)\]\([^)]*\)/g, "$1").replace(/\*\*|__|~~|`/g, "").replace(/(^|[\s(])[*_]([^*_\s][^*_]*?)[*_](?=[\s).,:;!?]|$)/g, "$1$2").trim()).filter(Boolean);
      sub = clean(ls[0] && ls[0].length < 30 && ls[1] ? ls[0] + " " + ls[1] : ls[0] || "");
    }
  } else if (kind === "stream") {
    const posts = tailJson(path.join(st, "rooms", room + ".jsonl")), act = tailJson(path.join(st, "activity", room + ".jsonl"), 32 << 10);
    for (const e of [...posts, ...act]) if (e.ts > t) t = e.ts;
    const p = [...posts].reverse().find((e) => String(e.text || "").trim());
    if (p) sub = clean(`${p.author?.name || "?"}: ${firstLine(p.text)}`);
  } else if (kind === "agents") {
    const as = ctx.agents.filter((a) => a.room === room && !a.parked);
    for (const a of as) t = Math.max(t, ctx.turns[a.id] || a.since || 0);
    const n = (m) => as.filter((a) => markOf(a) === m).length;
    sub = [[n("×"), "needs you"], [n("●") + n("◐"), "working"], [n("✓"), "done"], [n("○"), "idle"]].filter(([c]) => c).map(([c, w]) => `${c} ${w}`).join(" · ") || "no live agents";
  } else if (kind === "board") {
    const ps = (ctx.boards[room]?.projects || []).filter((p) => p.status !== "archived");
    const p = ps.reduce((b, x) => ((x.updated || x.created || 0) > (b?.updated || b?.created || 0) ? x : b), null);
    if (p) { t = p.updated || p.created || 0; sub = clean(`@${p.name}: ${p.short || p.where?.text || p.title || ""}`); }
  }
  return (panelInfoCache[k] = { t, sub });
}

// The small line under an agent's name (J23, Angus): its current or last topic. (The time is on the
// top line: "2 mins", or "now" while it works.) A project's: what it is doing now / did last.
function activeLine(a) {
  return clean(a.topic || "");
}

// How long ago, at the end of each row's top line (Angus): "now" while it works (the solid ●), else
// "1 min" · "N mins" · "1 hour" · "N hours" · "1 day" · "N days" (no "ago": Angus).
function since(ts, mark = "") {
  if (mark === "●") return "now";
  if (!ts) return "";
  const m = Math.floor((Date.now() - ts) / 60000);
  if (m < 2) return "1 min";
  if (m < 60) return `${m} mins`;
  const h = Math.floor(m / 60);
  if (h < 2) return "1 hour";
  if (h < 24) return `${h} hours`;
  const d = Math.floor(h / 24);
  return d < 2 ? "1 day" : `${d} days`;
}

// Qt StyledText for the plugin's coloured labels ("dim" = the menu's grey, resolved in the plugin).
const esc = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const font = (color, s) => { const c = color === "dim" ? "dim" : /^#?[0-9a-f]{6}$/i.test(color || "") ? "#" + String(color).replace(/^#/, "") : ""; return c ? `<font color="${c}">${esc(s)}</font>` : esc(s); };
const worldColor = (room) => { const h = room && worldHex(room); return h ? "#" + h : ""; };

async function rows() {
  const turns = lastTurns();
  const l = await request("list");
  const out = [], sbxWs = sandboxRanges(), onSbx = (a) => !a.parked && Number.isInteger(a.workspace) && sbxWs.some(([lo, hi]) => a.workspace >= lo && a.workspace <= hi);
  for (const a of l.agents || []) {
    if (SUMMON && (a.room !== S.room || a.parked)) continue; // summon: this world's, not parked
    if (sbxPlaceholder(a)) continue; // J404: no window to summon or jump to
    const where = a.parked ? `parked${a.parked_from ? " (from " + a.parked_from + ")" : ""}`
      : Number.isInteger(a.workspace) && a.workspace > 0 ? wsLabel(a.workspace, WORLD_SIZE) : a.room || "";
    const sub = [where, a.parked ? "" : STATUS[a.status] || a.status, a.topic].map(clean).filter(Boolean).join(" · ");
    // Where it is, in the name (Angus): agents their workspace ("Sankey · C3"), parked ones "parked".
    const loc = a.parked ? "parked" : Number.isInteger(a.workspace) && a.workspace > 0 ? wsLabel(a.workspace, WORLD_SIZE) : a.room || "";
    // The mark first (in the menu's icon column), then the agent's own icon in the name (Angus).
    const mk = markOf(a), recent = turns[a.id] || a.since || 0;
    const wsRoom = a.parked ? "" : Number.isInteger(a.workspace) && a.workspace > 0 ? (a.workspace_label || "")[0] || a.room : a.room;
    const ic = onSbx(a) ? "⚠ host" : a.icon || "🤖"; // J404: a host agent on a sandboxed world's workspace (Linkpath's "⚠ host Name")
    const rich = esc(ic) + " " + (unnamed(a.display) ? esc(clean(a.display)) : font(a.color, clean(a.display))) + (loc ? font("dim", " · ") + (a.parked ? font("dim", "parked") : font(worldColor(wsRoom), loc)) : "") + (since(recent, mk) ? font("dim", " · " + since(recent, mk)) : "") + (a.compactions >= 1 ? font("dim", " · ⟳" + a.compactions) : ""); // J117
    out.push({ kind: "agent", id: a.id, sort: a.display, recent, mark: mk, glyph: mk, label: ic + " " + clean(a.display) + (loc ? " · " + loc : "") + (since(recent, mk) ? " · " + since(recent, mk) : "") + (a.compactions >= 1 ? " · ⟳" + a.compactions : ""), rich, sub, parked: !!a.parked, world: a.room || "",
      // J17: where it is, for "D" (one world letter) in the plugin: its workspace's world; parked: none.
      subtitle: activeLine(a), // J23: the topic; the time is on the top line
      worlds: a.parked ? "" : String(loc || "")[0] || "", ws: !a.parked && Number.isInteger(a.workspace) && a.workspace > 0 ? a.workspace : 0 });
  }
  const names = Object.fromEntries((l.agents || []).map((a) => [a.id, a.display]));
  const byId = Object.fromEntries((l.agents || []).map((a) => [a.id, a]));
  // A project's place: its writer's workspace (Angus: "wherever the main writer agent is"); with no
  // live writer, the workspace of that world's projects panel (where Enter takes you; Angus), else
  // just the world.
  const boardWs = {}, boards = {}, clients = await hypr.clients().catch(() => []);
  for (const c of clients) {
    const m = /^hyprpi-board ([A-Z])$/.exec(c.title || "");
    if (m && c.workspace?.id > 0 && !boardWs[m[1]]) boardWs[m[1]] = c.workspace.id;
  }
  const projWs = (p, room) => { // J17: the workspace number behind projLoc (0: just the world)
    const w = byId[p.writer];
    if (w && !w.parked && Number.isInteger(w.workspace) && w.workspace > 0) return w.workspace;
    return boardWs[room] || 0;
  };
  const projLoc = (p, room) => { const ws = projWs(p, room); return ws ? wsLabel(ws, WORLD_SIZE) : room; };
  for (const room of WORLD_LETTERS) {
    if (SUMMON && room !== S.room) continue;
    let b; try { b = await request("board.get", { room }); } catch { continue; }
    if (b?.room !== room) continue;
    boards[room] = b; // J196: the >Projects row's time and line
    for (const p of b.projects || []) {
      if (p.status === "archived") continue;
      if (SUMMON && !(p.members || []).some((id) => byId[id] && byId[id].room === S.room && !byId[id].parked)) continue; // summon: only with someone to bring
      const members = (p.members || []).map((id) => "@" + (b.names?.[id] || names[id] || id.slice(-4))).join(" ");
      const sub = [`world ${room}`, members, p.short || p.where?.text || p.title].map(clean).filter(Boolean).join(" · ");
      const pl = projLoc(p, room), pt = p.updated || p.created;
      const rich = esc(p.icon || "📋") + " @" + esc(clean(p.name)) + font("dim", " · ") + font(worldColor(/^[A-Z]\d/.test(pl) ? pl[0] : room), pl) + (since(pt, projMark(p, byId)) ? font("dim", " · " + since(pt, projMark(p, byId))) : "");
      out.push({ kind: "project", id: p.id, room, name: p.name, rich, sort: p.name, recent: p.updated || p.created || 0, mark: projMark(p, byId), glyph: projMark(p, byId), label: (p.icon || "📋") + " @" + clean(p.name) + " · " + projLoc(p, room) + (since(pt, projMark(p, byId)) ? " · " + since(pt, projMark(p, byId)) : ""), sub: sub.slice(0, 160),
        // J17: a project is in its board's world and in the world of the workspace it shows (its writer's).
        worlds: [...new Set([room, /^[A-Z]\d/.test(pl) ? pl[0] : room])].join(""), ws: projWs(p, room),
        subtitle: clean(p.short || p.where?.text || p.title || "") }); // its "where" summarised (the agents panel's projects line), else where / title
    }
  }
  // hyprpi panels (TUIs) by the workspace they are on. Summon: this world's, after the agents. The
  // finder (J195, Angus: "there is no way to jump to them … only to bring them to us"): every world's,
  // after the projects; Enter jumps to it. Named with a leading ">" the way projects lead with "@"
  // (Angus: "so that they are easier to search for"), so typing ">" lists only panels:
  // >Agents D, >Stream D, >Thoughts D, >Projects D.
  for (const c of clients) {
    const m = /^hyprpi-(router|room|search|board|thoughts) (\S+)/.exec(c.title || ""), ws = c.workspace?.id;
    const wsWorld = ws > 0 ? WORLD_LETTERS[Math.floor((ws - 1) / WORLD_SIZE)] : "";
    if (!m || !(ws > 0) || (SUMMON && wsWorld !== S.room)) continue;
    const [icon, what] = PANEL_KIND[m[1]], loc = wsLabel(ws, WORLD_SIZE), nm = `>${what} ${m[2]}`;
    const info = panelInfo(m[2], m[1] === "router" ? "agents" : m[1] === "room" ? "stream" : m[1] === "board" ? "board" : "thoughts", { agents: l.agents || [], turns, boards });
    const age = since(info.t);
    out.push({ kind: "panel", id: c.address, room: SUMMON ? S.room : m[2], sort: nm, recent: 0, seen: info.t, // recent 0: the order stays as in J195 (the time is only shown)
      mark: "▫", glyph: "▫", label: `${icon} ${nm} · ${loc}${age ? " · " + age : ""}`,
      rich: esc(icon) + " " + font(worldColor(m[2][0]), nm) + font("dim", " · ") + font(worldColor(loc[0]), loc) + (age ? font("dim", " · " + age) : ""), sub: "",
      worlds: [...new Set([wsWorld, m[2][0]])].join(""), ws, subtitle: [SUMMON && ws === S.workspace ? "already here" : "", info.sub].filter(Boolean).join(" · ") });
  }
  // J404: a sandboxed world's own agents and panels, marked 🐳 (J423: after the name, like the panels). Summon: that world's, after
  // the host agents (⏎ brings the window in); the finder (J404 v2, Angus: "alpha and beta are not appearing … either"):
  // every world's, its agents with the agents and its panels with the panels (⏎ jumps to the window).
  {
    const sw = sandboxWindows(clients);
    if (!SUMMON) for (const c of clients) { // J411: the finder lists a Doorman's window with the panels (⏎ jumps to it)
      const ws = c.workspace?.id;
      if (DOORMAN_CLASS.test(c.class || "") && ws > 0 && c.mapped !== false) out.push(doormanRow(c, WORLD_LETTERS[Math.floor((ws - 1) / WORLD_SIZE)], "panel"));
    }
    for (const c of clients) {
      const w = sw[c.address], ws = c.workspace?.id;
      const wsWorld = ws > 0 ? WORLD_LETTERS[Math.floor((ws - 1) / WORLD_SIZE)] : "";
      if (!w || !wsWorld || (SUMMON && wsWorld !== S.room)) continue;
      const loc = wsLabel(ws, WORLD_SIZE), agent = w.kind === "agent", here = SUMMON && ws === S.workspace ? "already here" : "";
      if (agent) {
        const nm = w.name || safeText(String(c.title || "").replace(/^(🐳 [A-Z]: )?π - /u, "").split(" - ")[0]) || "agent";
        // J423 (Angus: "the agents can still get their own icons, they'll just have the what at the end"): "🦊 Alpha 🐳 · G1",
        // its icon as reported from inside for this very window (validated again), else a steady default from its name
        const ic = sbxIcon((sandboxReport(wsWorld)?.agents || []).find((a) => a?.address === c.address)?.icon, nm);
        out.push({ kind: SUMMON ? "panel" : "sbxagent", id: c.address, room: wsWorld, sort: SUMMON ? "0" + nm : nm, recent: 0, mark: SUMMON ? "▫" : "○", glyph: "○", sandboxed: true, // (summon: one category, agents first by their sort key)
          label: `${ic} ${nm} 🐳 · ${loc}`, rich: esc(ic) + " " + font(worldColor(wsWorld), nm) + " 🐳" + font("dim", " · ") + font(worldColor(loc[0]), loc), sub: "",
          worlds: wsWorld, ws, subtitle: ["sandboxed agent", here].filter(Boolean).join(" · ") });
        continue;
      }
      // J410: a panel row like the host's ("👥 >Agents A · A2 · 5 mins / 3 done · 2 idle"): its kind's icon, ">Kind G", the
      // world's colour, then 🐳; no age (nothing host-side and trustworthy dates G's activity), a line from validated data.
      const [icon, what] = PANEL_KIND[w.kind === "router" ? "router" : w.kind] || ["▫", "Panel"], nm = `>${what} ${wsWorld}`;
      out.push({ kind: "panel", id: c.address, room: wsWorld, sort: SUMMON ? "1" + nm : nm, recent: 0, mark: "▫", glyph: "▫", sandboxed: true,
        label: `${icon} ${nm} 🐳 · ${loc}`, rich: esc(icon) + " " + font(worldColor(wsWorld), nm) + " 🐳" + font("dim", " · ") + font(worldColor(loc[0]), loc), sub: "",
        worlds: wsWorld, ws, subtitle: [here, sandboxPanelLine(wsWorld, w.kind)].filter(Boolean).join(" · ") });
    }
  }
  // Summon: this world's app windows (Angus, J28: "apply this summon logic to all apps"), two lines each:
  // app + a stable tag (profile, vault, folder, cwd) · workspace · last used; below, what it shows now.
  if (SUMMON) {
    const agentAddr = new Set((l.agents || []).map((a) => a.address).filter(Boolean));
    let used = {}; try { used = (await request("window.recent", {})).used || {}; } catch { /* an older daemon: no ages */ }
    for (const c of clients) {
      const ws = c.workspace?.id;
      if (!isAppWindow(c, { agentAt: (addr) => agentAddr.has(addr) }) || WORLD_LETTERS[Math.floor((ws - 1) / WORLD_SIZE)] !== S.room) continue;
      const L = appLabel(c), loc = wsLabel(ws, WORLD_SIZE), t = used[c.address] || 0, age = t ? since(t, "") : "";
      if (DOORMAN_CLASS.test(c.class || "")) { out.push(doormanRow(c, S.room, "app")); continue; } // J411: still summoned as an app window, listed with the panels
      const nm = [L.app, L.tag].filter(Boolean).join(" ");
      out.push({ kind: "app", id: c.address, room: S.room, sort: nm, recent: t, mark: "▫", glyph: "▫", label: `${L.icon} ${nm} · ${loc}${age ? " · " + age : ""}`,
        rich: esc(L.icon) + " " + esc(L.app) + (L.tag ? " " + font("dim", L.tag) : "") + font("dim", " · ") + font(worldColor(loc[0]), loc) + (age ? font("dim", " · " + age) : ""),
        sub: "", worlds: S.room, ws, subtitle: [L.line2, stateNote(c), ws === S.workspace ? "already here" : ""].filter(Boolean).join(" · ") });
    }
  }
  // Agents first, then projects (summon: agents, panels, projects). Within each, by category, then most recent first:
  // × needs you (blocked, a decision, a bonk) · ● working · ✓ finished, not seen yet · ○ idle (a finished one
  // already seen shows ○ too) · ◌ parked / nobody live (Angus, J92: "lets list blocked agents, then working
  // agents, then finished agents, then idle agents. I find myself looking for who is working more often than
  // who is done"; was × ✓ ● ○ ◌). A project's mark is its most urgent live member's (× ● ✓). "Recent": agents
  // their last turn event, projects their card's last change. Ties A–Z. (The SUPER+S pop-up has its own order.)
  const CAT = { "×": 0, "●": 1, "◐": 2, "✓": 3, "○": 4, "◌": 5 }; // ◐ background (J93): its turn ended, subagents still running
  const cat = (r) => CAT[r.mark] ?? 3;
  const KIND = SUMMON ? { agent: 0, panel: 1, app: 2, project: 3 } : { agent: 0, sbxagent: 0, project: 1, panel: 2 }; // finder: panels last (J195)
  out.sort((x, y) => KIND[x.sortKind || x.kind] - KIND[y.sortKind || y.kind] || cat(x) - cat(y) || (y.recent || 0) - (x.recent || 0) || x.sort.localeCompare(y.sort, undefined, { sensitivity: "base" }));
  // The menu returns "label<TAB>subtext" (or just the label without a subtext); make every one
  // unique so a pick maps back to one row.
  const seen = new Set();
  for (const r of out) {
    if (!DETAIL) { r.sub = ""; if (seen.has(r.label)) r.label += ` (${r.room || r.world || "?"})`; while (seen.has(r.label)) r.label += "·"; r.key = r.label; }
    else { let k = `${r.label}\t${r.sub}`; while (seen.has(k)) { r.sub += " "; k = `${r.label}\t${r.sub}`; } r.key = k; }
    seen.add(r.key);
  }
  return out;
}

async function act(r) {
  if (r.kind === "panel" || r.kind === "sbxagent") return hypr.focusWindow(r.id); // J195: go to its workspace and focus it (J404: a sandboxed agent's window too)
  if (r.kind === "agent") {
    if (r.parked) return request("agent.unpark", { agent: r.id });
    return request("agent.focus", { agent: r.id });
  }
  await request("board.open", { room: r.room, project: r.id }).catch(() => {});
  const env = { ...process.env }; delete env.HYPRPI_AGENT_ID;
  spawn(here + "panel-here", ["board", r.room], { detached: true, stdio: "ignore", env }).on("error", () => {}).unref();
}

// The menu's width, as narrow as the longest row allows (Angus). omarchy-menu-select takes it in the
// shell's spacing units (Style.space(w) = w × scale, scale = base-size / 12 from
// ~/.config/omarchy/shell.toml [font]). A row is: padding 18 + border/8 + icon 36 + 6 + LABEL + 6 +
// trail 14 + padding 18 = 106 units + the label. The label is the heading font (base-size × 1.333 px),
// monospace (JetBrains Mono: 0.6 em a character, wide characters count 2); the grey detail line is
// body-small (base-size × 0.917 px). + 3 characters of slack so nothing is cut off with "…".
function shellFont() {
  try {
    const t = fs.readFileSync(path.join(process.env.XDG_CONFIG_HOME || path.join(process.env.HOME || "", ".config"), "omarchy", "shell.toml"), "utf8");
    const sec = (name) => (new RegExp(`\\[${name}\\]([^\\[]*)`).exec(t) || [])[1] || "";
    const base = Number((/^\s*base-size\s*=\s*([\d.]+)/m.exec(sec("font")) || [])[1]) || 12;
    const scale = Number((/^\s*scale\s*=\s*([\d.]+)/m.exec(sec("spacing")) || [])[1]) || 1;
    return { base, scale };
  } catch { return { base: 12, scale: 1 }; }
}
const cells = (s) => [...new Intl.Segmenter().segment(String(s))].reduce((n, { segment: g }) => n + (/[\p{Extended_Pictographic}\u1100-\u115F\u2E80-\uA4CF\uAC00-\uD7A3\uF900-\uFAFF\uFF00-\uFF60]/u.test(g) ? 2 : 1), 0);
function menuWidth(rs) {
  const { base, scale } = shellFont();
  const unit = scale * (base / 12);                     // px per spacing unit
  const px = (chars, fontPx) => (chars + 3) * fontPx * 0.6;
  const label = Math.max(...rs.map((r) => px(cells(r.label), Math.round(base * 1.333))), px(cells("Agents…"), Math.round(base * 1.333)));
  const detail = DETAIL ? Math.max(0, ...rs.map((r) => px(cells(r.sub), Math.round(base * 0.917)))) : 0;
  return Math.ceil(106 + Math.max(label, detail) / unit);
}

// One finder at a time: a second press closes the open one.
const LOCK = path.join(runtimeDir(), SUMMON ? "summon.pid" : "finder.pid");
function toggleOff() {
  try {
    const pid = Number(fs.readFileSync(LOCK, "utf8"));
    if (pid && pid !== process.pid) { process.kill(pid, 0); execFile("omarchy-menu", ["close"], () => {}); execFile("omarchy-shell", ["shell", "hide", PLUGIN], () => {}); process.kill(pid, "SIGTERM"); return true; }
  } catch { /* none running */ }
  return false;
}

const main = async () => {
  const list = process.argv.includes("--list");
  let rs;
  try { if (SUMMON) S = await request("room.current", {}); rs = await rows(); } catch (e) { console.error("finder: " + e.message); process.exit(1); }
  const row = (r) => r.sub ? `${r.glyph}\t${r.label}\t${r.sub}` : `${r.glyph}\t${r.label}`; // "" glyph → a row without an icon
  if (list && process.argv.includes("--options")) { console.log(JSON.stringify(optionsOf(rs))); return; }
  if (list) {
    const ago = (t) => { const m = Math.round((Date.now() - t) / 60000); return m < 60 ? `${m}m` : m < 2880 ? `${Math.round(m / 60)}h` : `${Math.round(m / 1440)}d`; };
    for (const r of rs) console.log(row(r) + (process.argv.includes("--ages") ? `\t(${r.recent ? ago(r.recent) : "?"})` : "") + (process.argv.includes("--rich") ? `\n    ${r.rich}` : ""));
    if (process.argv.includes("--width")) console.log("width", menuWidth(rs));
    return;
  }
  if (toggleOff()) return;
  fs.mkdirSync(path.dirname(LOCK), { recursive: true });
  fs.writeFileSync(LOCK, String(process.pid));
  const unlock = () => { try { if (Number(fs.readFileSync(LOCK, "utf8")) === process.pid) fs.unlinkSync(LOCK); } catch { /* gone */ } };
  if (!rs.length) { unlock(); return; }
  const onPick = async (code, out) => {
    unlock();
    const pick = out.replace(/\n$/, "");
    if (code !== 0 || !pick) return;
    if (SUMMON) { // one value per line (several when marked with Tab)
      const ps = pick.split("\n").map((k) => rs.find((x) => x.key === k)).filter(Boolean);
      try { await request("guest.summon", { auto: true, workspace: S.workspace, agents: ps.filter((x) => x.kind === "agent").map((x) => x.id), projects: ps.filter((x) => x.kind === "project").map((x) => x.id), panels: ps.filter((x) => x.kind === "panel").map((x) => x.id), windows: ps.filter((x) => x.kind === "app").map((x) => x.id) }, { timeoutMs: 20000 }); }
      catch (e) { console.error("summon: " + e.message); execFile("notify-send", ["hyprpi summon", e.message], () => {}); }
      return;
    }
    const r = rs.find((x) => x.key === pick) || rs.find((x) => x.label === pick) || rs.find((x) => pick.startsWith(x.label + "\t") && x.key.trimEnd() === pick.trimEnd());
    if (!r) { console.error("finder: no row for " + JSON.stringify(pick)); return; }
    try { await act(r); } catch (e) { console.error("finder: " + e.message); }
  };
  if (STYLE === "plugin" && await pluginSelect(rs, onPick)) return;
  if (SUMMON) { // the plain menu can't multi-select: the old summon pop-up (a small kitty) instead
    unlock();
    const env = { ...process.env }; delete env.HYPRPI_AGENT_ID;
    spawn("kitty", ["--class", "hyprpi.summon", "--title", "hyprpi summon", "-o", "confirm_os_window_close=0", "-o", "remember_window_size=no", "node", here + "summon.mjs"], { detached: true, stdio: "ignore", env }).on("error", () => {}).unref();
    return;
  }
  const child = spawn("omarchy-menu-select", ["Agents", ...rs.map(row), "--", "--width", String(menuWidth(rs))], { stdio: ["ignore", "pipe", "ignore"] });
  let out = "";
  child.stdout.on("data", (d) => { out += d; });
  const t = setTimeout(() => child.kill("SIGTERM"), TIMEOUT_S * 1000);
  process.on("SIGTERM", () => { child.kill("SIGTERM"); unlock(); process.exit(0); });
  child.on("close", (code) => { clearTimeout(t); onPick(code, out); });
};

// The plugin's options (also --list --options, for tests).
const optionsOf = (rs) => rs.map((r) => ({ icon: r.glyph, label: r.label, detail: r.sub || "", rich: r.rich || "", value: r.key, worlds: r.worlds || "", ws: r.ws || 0, home: r.ws ? WORLD_LETTERS[Math.floor((r.ws - 1) / WORLD_SIZE)] || "" : "", slot: r.ws ? ((r.ws - 1) % WORLD_SIZE) + 1 : 0, name: r.sort || "", recent: r.recent || 0, subtitle: r.subtitle || "" })); // FinderRank.js: one world letter or workspace digit ranks first (J17)

// The plugin pop-up: omarchy-menu-select's protocol (a selection file, then a done file), with the
// rows as objects so the label can be coloured; the pick comes back as the row's key. false when
// the plugin isn't there or not enabled (the caller falls back to the plain menu).
function pluginSelect(rs, onPick) {
  const dir = fs.mkdtempSync(path.join(runtimeDir(), "finder-")), sel = path.join(dir, "pick"), done = path.join(dir, "done");
  const options = optionsOf(rs);
  const payload = JSON.stringify({ mode: "select", prompt: SUMMON ? `Summon to ${wsLabel(S.workspace, WORLD_SIZE)}` : "Agents", ...(SUMMON ? { multi: true, noFilter: true } : {}), options, selectionFile: sel, doneFile: done, width: menuWidth(rs), ...(process.env.HYPRPI_FINDER_DRY ? { dry: true } : {}) });
  const clean = () => fs.rmSync(dir, { recursive: true, force: true });
  return new Promise((resolve) => {
    execFile("omarchy-shell", ["shell", "summon", PLUGIN, payload], (err, stdout) => {
      if (err || String(stdout).trim() !== "ok") { clean(); return resolve(false); }
      resolve(true);
      const t0 = Date.now();
      process.on("SIGTERM", () => { execFile("omarchy-shell", ["shell", "hide", PLUGIN], () => { clean(); process.exit(0); }); });
      const iv = setInterval(() => {
        if (fs.existsSync(done)) { clearInterval(iv); let out = ""; try { out = fs.readFileSync(sel, "utf8"); } catch { /* cancelled */ } clean(); onPick(out ? 0 : 1, out); }
        else if (Date.now() - t0 > TIMEOUT_S * 1000) { clearInterval(iv); execFile("omarchy-shell", ["shell", "hide", PLUGIN], () => {}); clean(); onPick(1, ""); }
      }, 50);
    });
  });
}
main();
