#!/usr/bin/env node
// Agents and projects finder (Angus, 2026-09-29; SUPER+SHIFT+SPACE): the Omarchy menu, as the apps
// menu (SUPER+ALT+SPACE) shows it, listing every world's live and parked agents and its open
// projects: agents A–Z first, then projects A–Z. The search box reads "Agents…" (the prompt, Angus). Type to filter (the subtext counts too: "C3", "working"), ↑↓, Enter, Esc.
//   Enter on an agent    jump to its window (parked: brought back here)
//   Enter on a project   its card in that world's projects panel (the panel comes here)
// Plan: ~/Obsidian/Tinker/2026-09-29 Agents and projects finder.md
//
//   ~/Work/hyprpi/mockups/finder            open the menu
//   ~/Work/hyprpi/mockups/finder --list     print the rows instead (tests, a quick look)
//
// Pressing the key again while the menu is open closes it (like the apps menu toggle).
// omarchy-menu-select waits for the menu to write a "done" file; if the menu goes away without
// writing it (seen once: a picker polled for 35 h), we give up after TIMEOUT_S and kill it.
import fs from "node:fs";
import path from "node:path";
import { spawn, execFile } from "node:child_process";
import { request } from "../lib/client.mjs";
import * as hypr from "../lib/hypr.mjs";
import { runtimeDir, loadConfig, wsLabel, WORLD_LETTERS } from "../lib/paths.mjs";

const TIMEOUT_S = Number(process.env.HYPRPI_FINDER_TIMEOUT) || 600; // env only for tests
// Rows show only icon + name (Angus, 2026-09-29: one line each, so far more fit in the menu, which
// caps itself at 70% of the screen). "finderDetail": true in ~/.config/hyprpi/config.json brings
// back the grey line under each name (workspace · status · topic / world · members · where).
const DETAIL = loadConfig().finderDetail === true;
const here = new URL(".", import.meta.url).pathname;
const WORLD_SIZE = loadConfig().worldSize || 10;
const STATUS = { working: "working", blocked: "needs you", done: "done", idle: "idle" };
const clean = (s) => String(s ?? "").replace(/[\t\n\r\x00-\x1f\x7f]+/g, " ").trim();

async function rows() {
  const l = await request("list");
  const out = [];
  for (const a of l.agents || []) {
    const where = a.parked ? `parked${a.parked_from ? " (from " + a.parked_from + ")" : ""}`
      : Number.isInteger(a.workspace) && a.workspace > 0 ? wsLabel(a.workspace, WORLD_SIZE) : a.room || "";
    const sub = [where, a.parked ? "" : STATUS[a.status] || a.status, a.topic].map(clean).filter(Boolean).join(" · ");
    // Where it is, in the name (Angus): agents their workspace ("Sankey · C3"), parked ones "parked".
    const loc = a.parked ? "parked" : Number.isInteger(a.workspace) && a.workspace > 0 ? wsLabel(a.workspace, WORLD_SIZE) : a.room || "";
    out.push({ kind: "agent", id: a.id, sort: a.display, glyph: a.icon || "🤖", label: clean(a.display) + (loc ? " · " + loc : ""), sub, parked: !!a.parked, world: a.room || "" });
  }
  const names = Object.fromEntries((l.agents || []).map((a) => [a.id, a.display]));
  const byId = Object.fromEntries((l.agents || []).map((a) => [a.id, a]));
  // A project's place: its writer's workspace (Angus: "wherever the main writer agent is"); with no
  // live writer, the workspace of that world's projects panel (where Enter takes you; Angus), else
  // just the world.
  const boardWs = {};
  for (const c of await hypr.clients().catch(() => [])) {
    const m = /^hyprpi-board ([A-Z])$/.exec(c.title || "");
    if (m && c.workspace?.id > 0 && !boardWs[m[1]]) boardWs[m[1]] = c.workspace.id;
  }
  const projLoc = (p, room) => {
    const w = byId[p.writer];
    if (w && !w.parked && Number.isInteger(w.workspace) && w.workspace > 0) return wsLabel(w.workspace, WORLD_SIZE);
    return boardWs[room] ? wsLabel(boardWs[room], WORLD_SIZE) : room;
  };
  for (const room of WORLD_LETTERS) {
    let b; try { b = await request("board.get", { room }); } catch { continue; }
    if (b?.room !== room) continue;
    for (const p of b.projects || []) {
      if (p.status === "archived") continue;
      const members = (p.members || []).map((id) => "@" + (b.names?.[id] || names[id] || id.slice(-4))).join(" ");
      const sub = [`world ${room}`, members, p.short || p.where?.text || p.title].map(clean).filter(Boolean).join(" · ");
      out.push({ kind: "project", id: p.id, room, name: p.name, sort: p.name, glyph: p.icon || "📋", label: "@" + clean(p.name) + " · " + projLoc(p, room), sub: sub.slice(0, 160) });
    }
  }
  // Agents A–Z, then projects A–Z (Angus: a "(Project)" tag made every project match "p").
  out.sort((x, y) => (x.kind === y.kind ? 0 : x.kind === "agent" ? -1 : 1) || x.sort.localeCompare(y.sort, undefined, { sensitivity: "base" }));
  // The menu returns "label<TAB>subtext" (or just the label without a subtext); make every one
  // unique so a pick maps back to one row.
  const seen = new Set();
  for (const r of out) {
    if (!DETAIL) { r.sub = ""; if (seen.has(r.label)) r.label += ` (${r.room || r.world || "?"})`; while (seen.has(r.label)) r.label += "·"; r.key = r.label; }
    else { let k = `${r.label}\t${r.sub}`; while (seen.has(k)) { r.sub += " "; k = `${r.label}\t${r.sub}`; } r.key = k; }
    seen.add(r.key);
  }
  return out;
}

async function act(r) {
  if (r.kind === "agent") {
    if (r.parked) return request("agent.unpark", { agent: r.id });
    return request("agent.focus", { agent: r.id });
  }
  await request("board.open", { room: r.room, project: r.id }).catch(() => {});
  const env = { ...process.env }; delete env.HYPRPI_AGENT_ID;
  spawn(here + "panel-here", ["board", r.room], { detached: true, stdio: "ignore", env }).on("error", () => {}).unref();
}

// The menu's width, as narrow as the longest row allows (Angus). omarchy-menu-select takes it in the
// shell's spacing units (Style.space(w) = w × scale, scale = base-size / 12 from
// ~/.config/omarchy/shell.toml [font]). A row is: padding 18 + border/8 + icon 36 + 6 + LABEL + 6 +
// trail 14 + padding 18 = 106 units + the label. The label is the heading font (base-size × 1.333 px),
// monospace (JetBrains Mono: 0.6 em a character, wide characters count 2); the grey detail line is
// body-small (base-size × 0.917 px). + 3 characters of slack so nothing is cut off with "…".
function shellFont() {
  try {
    const t = fs.readFileSync(path.join(process.env.XDG_CONFIG_HOME || path.join(process.env.HOME || "", ".config"), "omarchy", "shell.toml"), "utf8");
    const sec = (name) => (new RegExp(`\\[${name}\\]([^\\[]*)`).exec(t) || [])[1] || "";
    const base = Number((/^\s*base-size\s*=\s*([\d.]+)/m.exec(sec("font")) || [])[1]) || 12;
    const scale = Number((/^\s*scale\s*=\s*([\d.]+)/m.exec(sec("spacing")) || [])[1]) || 1;
    return { base, scale };
  } catch { return { base: 12, scale: 1 }; }
}
const cells = (s) => [...new Intl.Segmenter().segment(String(s))].reduce((n, { segment: g }) => n + (/[\p{Extended_Pictographic}\u1100-\u115F\u2E80-\uA4CF\uAC00-\uD7A3\uF900-\uFAFF\uFF00-\uFF60]/u.test(g) ? 2 : 1), 0);
function menuWidth(rs) {
  const { base, scale } = shellFont();
  const unit = scale * (base / 12);                     // px per spacing unit
  const px = (chars, fontPx) => (chars + 3) * fontPx * 0.6;
  const label = Math.max(...rs.map((r) => px(cells(r.label), Math.round(base * 1.333))), px(cells("Agents…"), Math.round(base * 1.333)));
  const detail = DETAIL ? Math.max(0, ...rs.map((r) => px(cells(r.sub), Math.round(base * 0.917)))) : 0;
  return Math.ceil(106 + Math.max(label, detail) / unit);
}

// One finder at a time: a second press closes the open one.
const LOCK = path.join(runtimeDir(), "finder.pid");
function toggleOff() {
  try {
    const pid = Number(fs.readFileSync(LOCK, "utf8"));
    if (pid && pid !== process.pid) { process.kill(pid, 0); execFile("omarchy-menu", ["close"], () => {}); process.kill(pid, "SIGTERM"); return true; }
  } catch { /* none running */ }
  return false;
}

const main = async () => {
  const list = process.argv.includes("--list");
  let rs;
  try { rs = await rows(); } catch (e) { console.error("finder: " + e.message); process.exit(1); }
  const row = (r) => r.sub ? `${r.glyph}\t${r.label}\t${r.sub}` : `${r.glyph}\t${r.label}`; // "" glyph → a row without an icon
  if (list) { for (const r of rs) console.log(row(r)); if (process.argv.includes("--width")) console.log("width", menuWidth(rs)); return; }
  if (toggleOff()) return;
  fs.mkdirSync(path.dirname(LOCK), { recursive: true });
  fs.writeFileSync(LOCK, String(process.pid));
  const unlock = () => { try { if (Number(fs.readFileSync(LOCK, "utf8")) === process.pid) fs.unlinkSync(LOCK); } catch { /* gone */ } };
  if (!rs.length) { unlock(); return; }
  const child = spawn("omarchy-menu-select", ["Agents", ...rs.map(row), "--", "--width", String(menuWidth(rs))], { stdio: ["ignore", "pipe", "ignore"] });
  let out = "";
  child.stdout.on("data", (d) => { out += d; });
  const t = setTimeout(() => child.kill("SIGTERM"), TIMEOUT_S * 1000);
  process.on("SIGTERM", () => { child.kill("SIGTERM"); unlock(); process.exit(0); });
  child.on("close", async (code) => {
    clearTimeout(t); unlock();
    const pick = out.replace(/\n$/, "");
    if (code !== 0 || !pick) return;
    const r = rs.find((x) => x.key === pick) || rs.find((x) => x.label === pick) || rs.find((x) => pick.startsWith(x.label + "\t") && x.key.trimEnd() === pick.trimEnd());
    if (!r) { console.error("finder: no row for " + JSON.stringify(pick)); return; }
    try { await act(r); } catch (e) { console.error("finder: " + e.message); }
  });
};
main();
