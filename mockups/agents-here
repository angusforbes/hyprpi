#!/usr/bin/env node
// The current world's agents panel (panel 1, agents-tui): jump to it, or open it here.
//
//   ~/Work/hyprpi/mockups/agents-here [ROOM]
//
// What a click on the selected world in the top bar does (hyprwrlds runs `hyprpi room --toggle`,
// which hands over to this; it used to toggle the old Quickshell room window, now retired but
// kept in ui/). Angus, 2026-09-28 (a toggle that always acts HERE):
//   - the panel is open on the current workspace: close it;
//   - open on another workspace, or parked in Reprieve (a special workspace): bring it here,
//     out of fullscreen;
// Focus and the mouse pointer stay where they were (Angus): the panel is shown, not focused.
//   - not open: open it on the current workspace in the TOP-LEFT slot: dwindle's
//     "preselect l" on the top-left tiled window makes the new window open to its left.
import { spawn } from "node:child_process";
import * as hypr from "./../lib/hypr.mjs";
import { request } from "./../lib/client.mjs";

const here = new URL(".", import.meta.url).pathname;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const clients = () => hypr.clients().catch(() => []);

async function currentRoom() {
  try { const r = await request("room.current", {}); return r.room || ""; } catch { return ""; }
}

const main = async () => {
  const room = (process.argv[2] || "").toUpperCase() || await currentRoom();
  if (!room) { console.error("agents-here: no current world (is the hyprpi daemon running?)"); process.exit(1); }
  const title = new RegExp(`^hyprpi-router ${room}$`);
  const aw = await hypr.activeWorkspace().catch(() => null);
  const ws = aw && Number.isInteger(aw.id) && aw.id > 0 ? aw.id : null;
  const cs = await clients();
  // Several copies can exist: one here first, then any on a normal workspace, then a parked one.
  const rank = (c) => c.workspace?.id === ws ? 0 : c.workspace?.id > 0 ? 1 : 2;
  const found = cs.filter((c) => title.test(c.title || "")).sort((x, y) => rank(x) - rank(y))[0];
  if (!ws) { console.error("agents-here: no normal workspace is active"); process.exit(1); }
  if (found && found.workspace?.id === ws) {               // open here: close it
    await hypr.closeWindow(found.address);
    return console.log(`agents panel ${room}: closed on workspace ${ws}`);
  }
  if (found) {                                             // elsewhere (or parked): bring it here
    const from = found.workspace?.name || found.workspace?.id;
    if (found.fullscreen || found.fullscreenClient) await hypr.unfullscreen(found.address).catch(() => {});
    await hypr.moveWindow(found.address, String(ws));
    await sleep(150);
    await hypr.clearFullscreen(ws, [found.address]); // you want to see it: nothing fullscreen over it
    return console.log(`agents panel ${room}: brought here from ${from}`);
  }
  // Not open: the top-left slot. Focus the top-left tiled window here and preselect "left", so the
  // new window splits it and takes its left part (an empty workspace just gets the window).
  // The top-left trick and the new window both take focus; put focus and the pointer back after.
  const prev = await hypr.activeWindow().catch(() => null);
  const ptr = await hypr.cursorPos().catch(() => null);
  const restore = async () => {
    if (prev?.address) await hypr.focusWindow(prev.address).catch(() => {});
    if (ptr && Number.isFinite(ptr.x)) await hypr.moveCursor(ptr.x, ptr.y).catch(() => {});
  };
  const tiled = cs.filter((c) => c.workspace?.id === ws && !c.floating && c.mapped !== false && !c.hidden);
  const tl = tiled.sort((a, b) => (a.at[1] - b.at[1]) || (a.at[0] - b.at[0]))[0];
  if (tl) {
    await hypr.focusWindow(tl.address).catch(() => {});
    await hypr.dispatch('hl.dsp.layout("preselect l")').catch(() => {});
  }
  const env = { ...process.env }; delete env.HYPRPI_AGENT_ID;
  const before = new Set(cs.map((c) => c.address));
  spawn(`${here}agents-tui`, [room], { detached: true, stdio: "ignore", env }).unref();
  for (let i = 0; i < 80; i++) { // up to ~8 s for the window to map and set its title
    await sleep(100);
    const c = (await clients()).find((x) => title.test(x.title || "") && !before.has(x.address));
    if (c) { await restore(); return console.log(`agents panel ${room}: opened on workspace ${ws}`); }
  }
  await restore();
  console.error(`agents-here: the agents panel for ${room} did not appear`);
  process.exit(1);
};
main();
