#!/bin/sh
# Panel 1: the hyprpi agent panel, in its own kitty window.  agents-tui [ROOM]
# The loop: the panel exits with 75 to restart onto new code, in place (no stacked processes).
# Ctrl+click reaches the panel (it jumps to that agent): kitty's own Ctrl+click (links.conf opens
# links, and discards the press even when a program has the mouse) is unmapped while grabbed.
# SUPER+C / SUPER+V (Omarchy's universal copy / paste send Ctrl+Insert / Shift+Insert): copy kitty's
# selection (else the key reaches the panel: the box's selection), paste the CLIPBOARD (kitty's
# default Shift+Insert pastes the primary selection), as in the other panels (@hyprpi N49).
# J295: a sandboxed world's panels run inside its sandbox (class hyprpi.g-*); the host never opens one for it.
. "$(dirname "$(readlink -f "$0")")/../lib/isolated-guard.sh" # J333: no windows from an isolated hyprpi
if [ -z "$HYPRPI_SANDBOX_WORLD" ] && node "$(dirname "$(readlink -f "$0")")/../lib/sandboxed-world.mjs" "${1:-}"; then echo "agents-tui: world $1 is sandboxed: its panels run inside its sandbox" >&2; exit 0; fi
exec kitty --class hyprpi.agents -o confirm_os_window_close=0 -o copy_on_select=clipboard \
  -o 'map ctrl+insert copy_or_noop' \
  -o 'map shift+insert paste_from_clipboard' \
  -o "mouse_map=ctrl+left press grabbed" \
  -o "mouse_map=ctrl+left release grabbed" \
  -o 'map ctrl+tab send_text all \x1b[9;5u' \
  -o 'map ctrl+shift+tab send_text all \x1b[9;6u' \
  sh -c 'while :; do HYPRPI_AGENTS_TUI_LOOP=1 node "$0" "$@"; [ $? -eq 75 ] || break; done' "$(dirname "$(readlink -f "$0")")/agents-tui.mjs" "$@"
