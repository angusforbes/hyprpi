#!/usr/bin/env node
// Bring the hyprpi panels of one world to the current workspace (opening any that aren't open)
// and tile them as a 2 x 2 dwindle grid: A, B right of A, C below A, D below B. Other windows
// there stay; on an empty workspace the grid is clean:
//
//   agents (panel 1) │ Stream (panel 2; file room-tui, title "hyprpi-room C")
//   board (panel 4)  │ search (panel 3)
//
// --columns: the old side-by-side floating columns instead. --tile: the old dwindle columns.
//
//   ~/Work/hyprpi/mockups/panels [ROOM] [--workspace N] [--only 1,2]
//
// With a single panel (--only 2) it just brings that one here and focuses it (the
// SUPER+ALT+A / R / slash keys), leaving the layout alone.
//
// For each panel: if its window exists anywhere (another workspace, or parked in
// Reprieve) it is MOVED here; otherwise it is opened here. Then they are put in order
// (1 · 2 · 3, left to right) and given equal widths.
//
// How: dwindle's "preselect" (hl.dsp.layout("preselect r")) makes the next window open to
// the right of the focused one; windows that are merely moved land wherever dwindle puts
// them, so the order is fixed afterwards with swaps. An exact resize needs a non-zero
// height (hl.dsp.window.resize({ x = W, y = H, relative = false })).
import { spawn } from "node:child_process";
import fs from "node:fs";
import * as hypr from "./../lib/hypr.mjs";
import { request } from "./../lib/client.mjs";
import { strictClients, withPanelLock } from "./../lib/panel-find.mjs";

const args = process.argv.slice(2);
const opt = (n, d) => { const i = args.indexOf(n); if (i < 0) return d; const v = args[i + 1]; args.splice(i, 2); return v; };
let wantWs = Number(opt("--workspace")) || null;
// Exact columns by default: the panels float and are placed by pixel, so the widths are
// identical every time. --tile uses dwindle instead (tiled, but only as even as the tree).
const tiled = args.includes("--tile") && (args.splice(args.indexOf("--tile"), 1), true);
const gap = Number(opt("--gap")) || 12;
const only = (opt("--only") || "1,2,4,3").split(",").map((x) => x.trim());
const here = new URL(".", import.meta.url).pathname;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const clients = () => hypr.clients().catch(() => []);

// Window titles: "hyprpi-router C" (panel 1), "hyprpi-room C" (2), "hyprpi-search C" (3)
// — that is how an existing window is recognised. Deliberately no " · <ROOM>" ending: the
// daemon reads titles ending that way as its own room windows and repositions them.
const panelsFor = (room) => [
  { n: "1", cmd: `${here}agents-tui`, title: new RegExp(`^hyprpi-router ${room}$`) },
  { n: "2", cmd: `${here}room-tui`, title: new RegExp(`^hyprpi-room ${room}$`) },
  { n: "4", cmd: `${here}board-tui`, title: new RegExp(`^hyprpi-board ${room}$`) },
  { n: "3", cmd: `${here}search-tui`, title: new RegExp(`^hyprpi-search ${room}$`) },
].filter((p) => only.includes(p.n) && (p.n !== "4" || fs.existsSync(`${here}board-tui.mjs`))); // the board panel (4) once it exists

async function currentRoom() {
  try { const r = await request("room.current", {}); return r.room || ""; } catch { return ""; }
}

async function targetWorkspace() {
  if (wantWs) { // go there first: a new window always opens on the active workspace
    await hypr.dispatch(`hl.dsp.focus({ workspace = "${wantWs}" })`).catch(() => {});
    await sleep(250);
  }
  const w = await hypr.activeWorkspace().catch(() => null);
  return w && Number.isInteger(w.id) && w.id > 0 ? w.id : null;
}

// Bring one panel here: move its window if it exists anywhere, else open it. J34: under one lock per
// panel, and a failed window lookup opens nothing (it used to read as "none open": duplicates).
const KIND_OF = { "1": "agents", "2": "room", "4": "board", "3": "search" };
async function bring(p, ws, room) {
  return withPanelLock(`${KIND_OF[p.n]}-${room}`, () => bringLocked(p, ws, room));
}
async function bringLocked(p, ws, room) {
  let before;
  try { before = await strictClients(); } catch (e) { console.error("panels: " + e.message); return null; }
  // Several copies can exist: prefer one already here, then any on a normal workspace,
  // then a parked one (special: workspace).
  const rank = (c) => c.workspace?.id === ws ? 0 : c.workspace?.id > 0 ? 1 : 2;
  const found = before.filter((c) => p.title.test(c.title || "")).sort((x, y) => rank(x) - rank(y))[0];
  if (found) {
    if (found.workspace?.id !== ws) {
      // A fullscreen panel arrives as a normal window in the layout, not fullscreen there.
      if (found.fullscreen || found.fullscreenClient) await hypr.unfullscreen(found.address).catch(() => {});
      await hypr.moveWindow(found.address, String(ws)).catch(() => {});
      await sleep(200);
    }
    return found.address;
  }
  const env = { ...process.env }; delete env.HYPRPI_AGENT_ID;
  spawn(p.cmd, room ? [room] : [], { detached: true, stdio: "ignore", env }).unref();
  for (let i = 0; i < 80; i++) { // up to ~8 s for the window to map and set its title
    await sleep(100);
    const c = (await clients()).find((x) => p.title.test(x.title || "") && !before.some((b) => b.address === x.address));
    if (c) return c.address;
  }
  return null;
}

const win = async (addr) => (await clients()).find((c) => c.address === addr);
// hl.dsp.window.float() toggles, so drive it towards the state we want.
async function setFloat(addr, want) {
  for (let i = 0; i < 3; i++) {
    const c = await win(addr);
    if (!c || c.floating === want) return;
    await hypr.focusWindow(addr).catch(() => {});
    await hypr.dispatch("hl.dsp.window.float()").catch(() => {});
    await sleep(350);
  }
}

// Rebuild the columns deterministically: float everything (which empties the dwindle
// tree), then tile them back left to right with "preselect r" between, giving the
// canonical (1 | (2 | 3)) shape. Resizing windows one by one instead skews the tree —
// a window can end up 16 px wide — because each resize adjusts a different split.
async function relayout(addrs) {
  for (const a of addrs) await setFloat(a, true);
  for (let i = 0; i < addrs.length; i++) {
    await setFloat(addrs[i], false);
    await sleep(300);
    if (i < addrs.length - 1) {
      await hypr.focusWindow(addrs[i]).catch(() => {});
      await hypr.dispatch('hl.dsp.layout("preselect r")').catch(() => {});
    }
  }
}

// The default (Angus): a 2 x 2 grid in plain dwindle, tiled, in reading order
//   agents | room
//   board  | search
// Float them all (out of the tree), then tile them back with preselects: 1; 2 right of 1;
// 3 below 1; 4 below 2. Dwindle's 50/50 splits make the four equal. Fewer panels: the same
// order, as far as it goes.
async function grid(addrs) {
  for (const a of addrs) await setFloat(a, true);
  const place = [null, [0, "r"], [0, "d"], [1, "d"]]; // tile next to which one, and where
  for (let i = 0; i < addrs.length; i++) {
    if (place[i]) { await hypr.focusWindow(addrs[place[i][0]]).catch(() => {}); await hypr.dispatch(`hl.dsp.layout("preselect ${place[i][1]}")`).catch(() => {}); }
    await setFloat(addrs[i], false);
    await sleep(300);
  }
}

// Exact columns (--columns): float each panel and place it by pixel on the active monitor, inside
// its reserved area (the bar) with `gap` between and around. Deterministic, unlike
// resizing inside dwindle's tree.
async function exactColumns(addrs) {
  const mons = await hypr.hyprJson("monitors").catch(() => []);
  const mon = mons.find((m) => m.focused) || mons[0];
  if (!mon) return;
  const sc = mon.scale || 1;
  const L = Math.round(mon.x / sc), T = Math.round(mon.y / sc);
  const W = Math.round(mon.width / sc), H = Math.round(mon.height / sc);
  const r = mon.reserved || [0, 0, 0, 0]; // [left, top, right, bottom]
  const x0 = L + r[0] + gap, y0 = T + r[1] + gap;
  const usable = W - r[0] - r[2] - gap * 2;
  const height = H - r[1] - r[3] - gap * 2;
  const colW = Math.floor((usable - gap * (addrs.length - 1)) / addrs.length);
  for (let i = 0; i < addrs.length; i++) {
    await setFloat(addrs[i], true);
    const w = i === addrs.length - 1 ? usable - (colW + gap) * i : colW; // last one takes the rounding
    await hypr.focusWindow(addrs[i]).catch(() => {});
    await hypr.dispatch(`hl.dsp.window.resize({ x = ${w}, y = ${height}, relative = false })`).catch(() => {});
    await sleep(120);
    await hypr.dispatch(`hl.dsp.window.move({ x = ${x0 + i * (colW + gap)}, y = ${y0}, relative = false })`).catch(() => {});
    await sleep(120);
  }
  await hypr.focusWindow(addrs[0]).catch(() => {});
}

// Panel mode is "the panels are floating in their exact columns here". Pressing the key
// again tiles them back, so the workspace behaves normally.
const PANEL_TITLE = /^hyprpi-(router|room|board|search) /;
async function panelModeHere(ws) {
  const cs = await clients();
  const here = cs.filter((c) => c.workspace?.id === ws && PANEL_TITLE.test(c.title || ""));
  return here.filter((c) => c.floating).length >= 2 ? here : null;
}

// Back to regular mode: tile the panels again and leave dwindle's own proportions
// (50 / 25 / 25) — deliberately NOT even thirds, so one glance tells you which mode you
// are in: three identical columns = panel mode, a wide left column = normal.
async function unpanel(here) {
  const order = ["router", "room", "board", "search"];
  const sorted = here.slice().sort((a, b) => order.findIndex((k) => a.title.includes(k)) - order.findIndex((k) => b.title.includes(k)));
  const addrs = sorted.map((c) => c.address);
  await relayout(addrs);
  await hypr.focusWindow(addrs[0]).catch(() => {});
}

// Tiled mode: one exact resize of the left-most window makes thirds (the pair on its
// right rescales with it). Resizing each window in turn skews dwindle's tree instead.
async function evenTiles(addrs) {
  const cs = await clients();
  const mine = addrs.map((a) => cs.find((c) => c.address === a)).filter(Boolean);
  if (mine.length < 2) return;
  const total = mine.reduce((w, c) => w + c.size[0], 0);
  await hypr.focusWindow(mine[0].address).catch(() => {});
  await hypr.dispatch(`hl.dsp.window.resize({ x = ${Math.floor(total / mine.length)}, y = ${mine[0].size[1]}, relative = false })`).catch(() => {});
  await sleep(200);
}

// Restore-all (J8): the panel keys are a deliberate entry point. Make sure the daemon runs (after a
// crash or shutdown nothing else may have started it), then let it offer, once per daemon start,
// to restore the agents and panels that were open (a menu; it does nothing if there's nothing).
async function offerRestore() {
  const ping = () => request("ping", {}, { timeout: 800 }).then(() => true, () => false);
  if (!(await ping())) {
    const { execFile } = await import("node:child_process");
    await new Promise((r) => execFile(new URL("../bin/hyprpi", import.meta.url).pathname, ["ensure"], { timeout: 8000 }, () => r()));
  }
  await request("restore.offer", { from: "panels" }, { timeout: 1500, timeoutMs: 4000 }).catch(() => {});
}

const main = async () => {
  await offerRestore();
  const room = (args[0] || "").toUpperCase() || await currentRoom();
  // Always where you are (Angus): other windows there are left alone and dwindle fits the grid
  // around them; for a clean grid, go to an empty workspace and press SUPER+CTRL+ALT+P again.
  const ws = await targetWorkspace();
  if (!ws) { console.error("panels: no normal workspace is active (use --workspace N)"); process.exit(1); }
  const list = panelsFor(room);
  if (!list.length) { spawn("notify-send", ["hyprpi", "The projects panel (SUPER+ALT+P) isn't there: mockups/board-tui.mjs is missing"], { stdio: "ignore", detached: true }).on("error", () => {}).unref(); return; }
  // One panel (the single-panel keys: --only 1 / 2 / 3): bring it here and focus it, no layout.
  if (list.length === 1) {
    const addr = await bring(list[0], ws, room);
    if (!addr) { console.error(`panels: panel ${list[0].n} did not open`); process.exit(1); }
    await hypr.clearFullscreen(ws, [addr]); // you called it to see it: nothing fullscreen over it
    return hypr.focusWindow(addr).catch(() => {});
  }
  const already = await panelModeHere(ws);   // second press: back to regular mode
  if (already && !args.includes("--force")) return unpanel(already);
  const opened = [];
  for (const p of list) {
    const addr = await bring(p, ws, room);
    if (!addr) { console.error(`panels: panel ${p.n} did not open`); continue; }
    opened.push(addr);
    await hypr.focusWindow(addr).catch(() => {});
    if (p !== list[list.length - 1]) await hypr.dispatch('hl.dsp.layout("preselect r")').catch(() => {});
  }
  await hypr.clearFullscreen(ws, opened);
  if (opened.length < 2) return;
  if (args.includes("--columns")) return exactColumns(opened);
  if (!tiled) { await grid(opened); return hypr.focusWindow(opened[1] || opened[0]).catch(() => {}); }
  await relayout(opened);
  await evenTiles(opened);
  return hypr.focusWindow(opened[0]).catch(() => {});
};
main();
