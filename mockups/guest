#!/usr/bin/env node
// Summon & dismiss keys (hypr/hyprpi.lua): guest dismiss · guest dismiss --all · guest pin
//   SUPER+D      dismiss the focused agent (a hyprpi panel: closed, like its toggle key)
//   SUPER+ALT+D  dismiss all: every hyprpi window on this workspace except pinned ones and the focused one
//   SUPER+ALT+S  pin / unpin the focused agent or hyprpi panel (pinned ones stay; light blue border)
// A short notification says what happened when there's something to say (not for pin / unpin: the border shows it).
import { execFile } from "node:child_process";
import { request } from "../lib/client.mjs";
const [cmd, ...rest] = process.argv.slice(2);
// App name "hyprpi keys", not "hyprpi": a click on a toast focuses the window whose class matches the app
// name, and "hyprpi" matched the first hyprpi.agent window (Angus landed on Harbor in world B).
const toast = (t) => execFile("notify-send", ["-a", "hyprpi keys", "-t", "2500", t], () => {});
try {
  if (cmd === "dismiss") {
    const r = await request("guest.dismiss", { all: rest.includes("--all") });
    if (r.pinned) toast(`📌 ${r.agent} is pinned (SUPER+ALT+S unpins)`);
    else if (rest.includes("--all") && !r.dismissed?.length) toast("nothing to dismiss here");
  } else if (cmd === "pin") {
    await request("guest.pin", {}); // no toast (Angus, J27): the light blue border shows the state
  } else if (cmd === "keep") {
    const r = await request("guest.keep", {});
    toast(r.dismissed?.length ? `kept ${r.kept}; dismissed ${r.dismissed.length}: ${r.dismissed.join(", ")}` : `kept ${r.kept}; nothing else to dismiss`);
  } else { console.error("usage: guest dismiss [--all] | guest pin | guest keep"); process.exit(2); }
} catch (e) { toast("✗ " + e.message); process.exit(1); }
