#!/usr/bin/env node
// Jump to this world's hyprpi panel (J195, Angus): SUPER+SHIFT+ALT+P / R / slash go to the workspace
// where that panel is and focus it, where SUPER+ALT+P / R / slash bring it here (mockups/panels --only N).
// A panel that isn't open, or is parked in Reprieve, is brought here the usual way instead (there's
// nowhere to jump to).
//
//   ~/Work/hyprpi/mockups/panel-jump 1|2|3|4 [ROOM] [--dry]     (1 Agents · 2 Stream · 3 Thoughts · 4 Projects)
import { spawn } from "node:child_process";
import * as hypr from "../lib/hypr.mjs";
// J333: an isolated hyprpi (test socket/state) opens no windows on the real desktop.
{ const why = hypr.hyprBlocked(); if (why) { console.error(`hypr actions disabled (isolated daemon: ${why}); HYPRPI_ALLOW_HYPR=1 allows them`); process.exit(1); } }
import { request } from "../lib/client.mjs";

const args = process.argv.slice(2), dry = args.includes("--dry");
const [n, roomArg] = args.filter((a) => !a.startsWith("--"));
const KIND = { 1: "router", 2: "room", 3: "(?:search|thoughts)", 4: "board" };
if (!KIND[n]) { console.error("usage: panel-jump 1|2|3|4 [ROOM] [--dry]"); process.exit(2); }
// The world comes from the workspace Angus is on, read once (Knock, J195: asking the daemon raced a
// workspace switch and opened Stream C on D6).
const P = await import("../lib/paths.mjs"), size = P.loadConfig().worldSize || 10, L = P.WORLD_LETTERS;
const aw = await hypr.activeWorkspace().catch(() => null);
const hereWorld = aw?.id > 0 ? L[Math.floor((aw.id - 1) / size)] || "" : "";
const room = roomArg || hereWorld;
const re = new RegExp(`^hyprpi-${KIND[n]} ${room}$`);
// Two of the same panel (one summoned elsewhere): the one in its own world first.
const all = room ? (await hypr.clients().catch(() => [])).filter((w) => re.test(w.title || "") && w.workspace?.id > 0) : [];
const c = all.find((w) => L[Math.floor((w.workspace.id - 1) / size)] === room) || all[0];
// Not open on a workspace: bring it here the usual way, but ONLY when it is this world's panel and
// we're on a normal workspace; never open a panel of world X on another world's workspace.
const canBring = !c && room && room === hereWorld;
if (dry) { console.log(c ? `jump ${c.address} ws ${c.workspace.id} (${c.title})` : canBring ? `bring ${n} ${room} (not open on a workspace)` : `nothing (${room || "?"}'s panel isn't open; you're in ${hereWorld || "no world"})`); process.exit(0); }
if (c) await hypr.focusWindow(c.address);
else if (canBring) {
  const env = { ...process.env }; delete env.HYPRPI_AGENT_ID;
  spawn(new URL("./panels", import.meta.url).pathname, [...(room ? [room] : []), "--only", n], { detached: true, stdio: "ignore", env }).unref();
}
