#!/usr/bin/env node
// hyprpi — Pi agents in their own windows, grouped into rooms per hyprwrld.
// Run `hyprpi help` for commands.
import { spawn, spawnSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { request, connect } from "../lib/client.mjs";
import { ROOT, socketPath, runtimeDir, loadConfig, instanceKey, stateDir as stateDirOf } from "../lib/paths.mjs";
import * as hypr from "../lib/hypr.mjs";
import { emptiestWs } from "../lib/placement.mjs";
import { terminalCommand } from "../lib/terminal.mjs";

const HELP = `hyprpi — Pi agents in their own windows, with a room per hyprwrld

  hyprpi new [--cwd DIR] [--beside AGENT] [--workspace N] [--id ID] [--twin-of ID] [--here] [--no-focus] [-- PI_ARGS...]
                              open a Pi agent in its own terminal window (SUPER+A);
                              starts in the focused terminal's/agent's folder unless --cwd
  hyprpi room [ROOM] [--toggle]  show (or toggle) the room widget; no ROOM = current world, following it
  hyprpi search [ROOM] [--toggle]  open the search window for a room (default: current world)
  hyprpi find [--room R] [--ai] QUERY  search from the terminal (keyword, or AI with --ai)
  hyprpi list [--json]        live agents and rooms
  hyprpi post [--room R] TEXT post to a room as you (every agent there gets it)
  hyprpi send AGENT TEXT      prompt one agent directly
  hyprpi thoughts new W [--handoff FILE]   a fresh session for world W's Thoughts (the old one archived, never deleted)
  hyprpi thoughts [--room R] [--via voice] TEXT   a message to a world's Thoughts (default: the world you're on); --via voice marks it 🎤 (dictation)
  hyprpi dictate [--to hp:ID|proj:NAME] TEXT   a dictation: the focused world's Thoughts (🎤), or the agent /
                              project it starts with ("Atlas, …", "project onboarding, …")
  hyprpi tinker [W:] TEXT     drop a friction fix off in the workshop world: one free agent
                              there gets it, or a new one opens. "D: TEXT" also makes world D
                              the workshop from now on (remembered)
  hyprpi focus AGENT          jump to an agent's window
  hyprpi restart AGENT [--no-compact] [--wait]   restart an agent's pi on the same session when it's idle
                              (compacts first; frees memory, picks up the current pi); --wait prints before/after
  hyprpi mcp-gateway [install|status]   the MCP gateway (mcp-gateway/): install writes + starts its systemd --user unit
  hyprpi remote [install|status]   the phone app (remote-control/): the same for its unit
  hyprpi integration [status|install|uninstall] [NAME…]   hyprpi's home-folder wiring, piece by piece (hypr, path, bar, kitty, gateway, remote, hyprwrlds, hyprwrlds-vimarchy; "recommended")
  hyprpi finder [--list]      find an agent or project (the Omarchy menu; the finder add-on, SUPER+SHIFT+SPACE)
  hyprpi move AGENT... --to WS|WORLD   move agents' windows (focus stays); a world letter keeps
                              each one's slot (C4 -> F4). --room C moves every live agent in C
  hyprpi spinout @PROJECT --to WORLD [--keep-owner]   move a project to another world: its board card, and its
                              members (slots kept) unless they are also on another project
  hyprpi name NAME [--fg #rrggbb]   set this agent's name (herdr-name compatible)
  hyprpi whoami               this agent (inside a hyprpi agent)
  hyprpi status STATE [--quiet]  set this agent's status (bonk sets blocked; its × clears like ✓, on a click or typing in the window)
  hyprpi daemon               run the daemon in the foreground
  hyprpi ensure               start the daemon if it is not running
  hyprpi daemon restart [--reason R] [--ttl MIN]   restart the daemon once everyone is idle (returns at once; never poll for idle) · --status · --cancel
  hyprpi auth [--json]        the login watch (J136): a lapsed model login, who stopped on it, the credentials file it watches
  hyprpi stop                 stop the daemon (it saves what is open first: hyprpi restore brings it back)
  hyprpi restore [all|X] [--list] [--no]   reopen the agents and panels that were open when hyprpi
                              last went down (own workspaces, model and thinking; panels silently);
                              --list only shows them, --no lets them go

Config: ~/.config/hyprpi/config.json   Socket: ${socketPath()}`;

const args = process.argv.slice(2);
const cmd = args.shift() || "help";
const directTerminal = !!(process.stdin.isTTY && process.stdout.isTTY && !process.env.HYPRPI_ROUTER);

function die(msg, code = 1) { console.error(`hyprpi: ${msg}`); process.exit(code); }
function opt(name, dflt) {
  const i = args.indexOf(name);
  if (i < 0) return dflt;
  const v = args[i + 1];
  args.splice(i, 2);
  return v;
}
function flag(name) { const i = args.indexOf(name); if (i < 0) return false; args.splice(i, 1); return true; }

async function alive() {
  try { await request("ping", {}, { timeout: 800 }); return true; } catch { return false; }
}

// Newest modification time of the daemon's code, to restart a stale daemon.
function codeMtime() {
  let m = 0;
  for (const f of fs.readdirSync(path.join(ROOT, "lib"))) m = Math.max(m, fs.statSync(path.join(ROOT, "lib", f)).mtimeMs);
  return m;
}

async function ensureDaemon() {
  let info = null;
  try { info = await request("ping", {}, { timeout: 800 }); } catch { /* not running */ }
  // A `hyprpi new` the daemon itself spawned (open_agent, tinker "new", /move, restore) never restarts
  // it (J15): it would kill the daemon that holds the new agent's pending name and first prompt, and the
  // daemon is up anyway. Only a user-run command restarts a daemon older than lib/.
  if (info && process.env.HYPRPI_FROM_DAEMON !== "1" && (!info.started || info.started < codeMtime())) {
    // Code changed since it started: restart it (agents reconnect by themselves).
    try { await request("shutdown"); } catch { /* already gone */ }
    for (let i = 0; i < 20 && (await alive()); i++) await new Promise((r) => setTimeout(r, 100));
    info = null;
  }
  if (info) return;
  fs.mkdirSync(runtimeDir(), { recursive: true, mode: 0o700 });
  const logFile = path.join(runtimeDir(), `${instanceKey()}.log`);
  const out = fs.openSync(logFile, "a");
  const child = spawn(process.execPath, [path.join(ROOT, "bin/hyprpi"), "daemon"], { detached: true, stdio: ["ignore", out, out], env: process.env });
  child.unref();
  for (let i = 0; i < 40; i++) {
    await new Promise((r) => setTimeout(r, 100));
    if (await alive()) return;
  }
  die(`daemon did not start; see ${logFile}`);
}

function childEnv(extra) {
  const env = {};
  for (const [k, v] of Object.entries(process.env)) {
    if (/^(HERDR_|PI_SESSION|HYPRPI_AGENT_ID|HYPRPI_WORKSPACE|HYPRPI_TWIN_OF|HYPRPI_FROM_DAEMON|HYPRPI_NAME|HYPRPI_ICON)/.test(k)) continue; // never inherited: an agent's own `hyprpi new` is a user one
    env[k] = v;
  }
  return { ...env, ...extra };
}

// "Panel mode" = at least two floating hyprpi-router/-room/-search windows on that
// workspace. A new agent goes to the nearest, emptiest workspace of the same world (Angus, J18:
// the same rule as panels leaving on a summon; lib/placement.mjs).
async function awayFromPanels(ws, cfg) {
  let list;
  try { list = await hypr.clients(); } catch { return ws; }
  const panels = list.filter((c) => c.workspace?.id === ws && c.floating && /^hyprpi-(router|room|search) /.test(c.title || ""));
  if (panels.length < 2) return ws;
  return emptiestWs(list, ws, Number(cfg.worldSize) || 10, true) || ws;
}

function newId() { return "hp-" + Date.now().toString(36) + Math.random().toString(36).slice(2, 5); }

// Folder of the focused window, for "new agent here": a hyprpi agent's own
// folder, or the working directory of the newest process running inside a
// terminal window (its shell, or whatever the shell is running). Else null.
const TERMINAL_CLASSES = /^(kitty|foot|footclient|alacritty|com\.mitchellh\.ghostty|org\.wezfurlong\.wezterm|hyprpi\.agent|hyprpi\.mockup)$/i;
async function focusedFolder() {
  const w = await hypr.activeWindow().catch(() => null);
  if (!w?.pid || !TERMINAL_CLASSES.test(w.class || "")) return null;
  if (w.class === "hyprpi.agent") {
    try {
      const a = (await request("list")).agents.find((x) => x.address === w.address);
      if (a?.cwd && fs.existsSync(a.cwd)) return a.cwd;
    } catch { /* fall back to /proc */ }
  }
  // Descendants of the terminal process; newest first.
  const kids = new Map();
  for (const p of fs.readdirSync("/proc")) {
    if (!/^\d+$/.test(p)) continue;
    try {
      const st = fs.readFileSync(`/proc/${p}/stat`, "utf8");
      const f = st.slice(st.lastIndexOf(")") + 2).split(" ");
      const pp = Number(f[1]), start = Number(f[19]);
      if (!kids.has(pp)) kids.set(pp, []);
      kids.get(pp).push({ pid: Number(p), start });
    } catch { /* gone */ }
  }
  const all = [], todo = [w.pid];
  while (todo.length) for (const k of kids.get(todo.pop()) || []) { all.push(k); todo.push(k.pid); }
  all.sort((a, b) => b.start - a.start);
  for (const k of all) {
    try { const d = fs.readlinkSync(`/proc/${k.pid}/cwd`); if (d && d !== "/" && fs.existsSync(d)) return d; } catch { /* not ours / gone */ }
  }
  return null;
}

async function cmdNew() {
  const cfg = loadConfig();
  // --cwd wins; else the focused terminal's / agent's folder (cwdFromFocused,
  // default on); else config cwd (~/Work).
  let dir = opt("--cwd");
  if (!dir && cfg.cwdFromFocused !== false && !args.includes("--beside")) dir = await focusedFolder().catch(() => null);
  const cwd = (dir || cfg.cwd).replace(/^~(?=$|\/)/, process.env.HOME);
  const beside = opt("--beside");
  let workspace = Number(opt("--workspace")) || null;
  const twinOf = opt("--twin-of") || "";
  // --id: reuse a known agent id (resuming a closed agent keeps its name, room and twins).
  const wantId = opt("--id") || "";
  // --name / --icon (open_agent, J15): the agent says them in its hello, so it is named even if the
  // daemon that opened it restarted before it came up.
  const wantName = String(opt("--name") || "").slice(0, 60), wantIcon = String(opt("--icon") || "").slice(0, 16);
  if (wantId && !/^[A-Za-z0-9_.-]{3,64}$/.test(wantId)) die("bad --id");
  // --silent (restore-all): open the window straight on --workspace via Hyprland's exec_cmd
  // 'N silent', so Angus's focus and workspace never change. Implies --no-focus.
  const silent = flag("--silent");
  // --here: stay on this workspace even in panel mode. A plain flag (it used to be read with opt(),
  // which took the next argument as its value: `--here --no-focus` lost --no-focus, a final --here was ignored).
  const here = flag("--here");
  const dd = args.indexOf("--");
  const piArgs = dd >= 0 ? args.slice(dd + 1) : [];
  // J190: fail on a missing terminal BEFORE starting a daemon (a test with a broken PATH once started
  // the live daemon with that PATH).
  try { terminalCommand(cfg, { title: "pi", cwd }); } catch (e) { die(e.message); }
  await ensureDaemon();
  // The first deliberate entry point after a fresh daemon start offers to restore what was open
  // (once per daemon start; a resume / restore itself passes --id and doesn't ask).
  if (!wantId) await request("restore.offer", { from: "new" }, { timeout: 1500, timeoutMs: 4000 }).catch(() => {});

  const active = await hypr.activeWorkspace().catch(() => null);
  if (beside) {
    // Open next to another agent's window: focus it first when it is on the
    // visible workspace (Hyprland splits the focused window), otherwise the
    // daemon moves the new window to that workspace once it maps.
    let target = null;
    try {
      const list = await request("list");
      target = list.agents.find((a) => a.id === beside || a.address === beside || a.name.toLowerCase() === beside.toLowerCase());
    } catch { /* fall through */ }
    if (target?.address) {
      workspace = target.workspace;
      if (active && target.workspace === active.id) await hypr.focusWindow(target.address).catch(() => {});
    }
  }
  if (!workspace && active && Number.isInteger(active.id) && active.id > 0) workspace = active.id;
  // Panel mode (mockups/panels): that workspace is the three floating panels, so a new
  // agent would open behind them. Put it on the next free workspace of the same world.
  if (workspace && !silent && !here) workspace = await awayFromPanels(workspace, cfg);

  const id = wantId || newId();
  const ext = path.join(ROOT, "pi-extension", "index.ts");
  const env = childEnv({ HYPRPI_AGENT_ID: id, ...(workspace ? { HYPRPI_WORKSPACE: String(workspace) } : {}), ...(twinOf ? { HYPRPI_TWIN_OF: twinOf } : {}), ...(wantName ? { HYPRPI_NAME: wantName } : {}), ...(wantIcon ? { HYPRPI_ICON: wantIcon } : {}) });
  const piCmd = cfg.pi;
  const piArgv = ["-e", ext, ...(cfg.piArgs || []), ...piArgs];
  if (directTerminal) {
    process.stdout.write(`\x1b]2;pi\x07`);
    const child = spawn(piCmd, piArgv, { cwd, env, stdio: "inherit" });
    child.on("exit", (code, signal) => {
      if (signal) process.kill(process.pid, signal);
      else process.exit(code ?? 0);
    });
    child.on("error", (e) => die(e.message));
    return;
  }
  let termPrefix;
  try { termPrefix = terminalCommand(cfg, { title: "pi", cwd }); } catch (e) { die(e.message); }
  const term = [...termPrefix, piCmd, ...piArgv];
  if (silent && workspace) {
    const q = (s) => "'" + String(s).replace(/'/g, "'\\''") + "'";
    const pass = Object.entries(env).filter(([k]) => /^(HYPRPI_|XDG_RUNTIME_DIR$|XDG_STATE_HOME$|XDG_CONFIG_HOME$)/.test(k));
    const cmd = ["cd", q(cwd), "&&", "exec", "env", "-u", "PI_SESSION_FILE", "-u", "PI_SESSION_ID", ...pass.map(([k, v]) => `${k}=${q(v)}`), ...term.map(q)].join(" ");
    if (cmd.includes("]]")) die("can't open silently: the command contains ]]");
    await hypr.dispatch(`hl.dsp.exec_cmd([[${cmd}]], { workspace = "${workspace} silent" })`);
    console.log(id);
    return;
  }
  // A visible special workspace (Reprieve's parked view) swallows new windows: hide it first.
  try {
    const mons = await hypr.hyprJson("monitors");
    const special = mons.find((m) => m.focused)?.specialWorkspace?.name || "";
    if (special) {
      await hypr.dispatch(`hl.dsp.workspace.toggle_special({ name = "${special.replace(/^special:/, "")}" })`).catch(() => {});
      await new Promise((r) => setTimeout(r, 200));
    }
  } catch { /* fine */ }
  const child = spawn(term[0], term.slice(1), { cwd, env, detached: true, stdio: "ignore" });
  child.unref();
  console.log(id);
  // Jump to the new agent: its window may be on another workspace (panel mode) or still
  // being placed by the daemon, so wait for it to be listed with a window. --no-focus skips.
  if (!flag("--no-focus")) {
    for (let i = 0; i < 60; i++) {
      await new Promise((r) => setTimeout(r, 250));
      let a = null;
      try { a = (await request("list")).agents.find((x) => x.id === id); } catch { /* daemon busy */ }
      if (!a?.address) continue;
      if (a.workspace !== workspace && Number.isInteger(workspace)) continue; // let the daemon place it first
      await hypr.focusWindow(a.address).catch(() => {});
      break;
    }
  }
}

// Room windows are served by one Quickshell process per Hyprland instance,
// connected to this instance's daemon; the daemon forwards "open" to it.
// The room widget and search window are served by one Quickshell process per
// Hyprland instance, connected to this instance's daemon; the daemon forwards
// "open"/"search" to it. Start it if nobody answered.
// Is a room UI (qs -p <ui>) already running for this daemon's socket?
function pgrepUi() {
  const ui = path.join(ROOT, "ui");
  try {
    for (const pid of fs.readdirSync("/proc")) {
      if (!/^\d+$/.test(pid)) continue;
      let cmd, env;
      try { cmd = fs.readFileSync(`/proc/${pid}/cmdline`, "utf8").split("\0"); } catch { continue; }
      if (cmd[0] !== "qs" || cmd[1] !== "-p" || cmd[2] !== ui) continue;
      try { env = fs.readFileSync(`/proc/${pid}/environ`, "utf8").split("\0"); } catch { continue; }
      if (env.includes("HYPRPI_SOCKET=" + socketPath())) return true;
    }
  } catch { /* no /proc */ }
  return false;
}

async function uiRequest(method, params) {
  await ensureDaemon();
  let r = await request(method, params);
  // A running UI may just be reconnecting (it retries every 1.5 s after a
  // daemon restart); give it a moment before starting a second copy.
  if (!r.delivered && pgrepUi()) {
    for (let i = 0; i < 25 && !r.delivered; i++) {
      await new Promise((res) => setTimeout(res, 100));
      r = await request(method, { ...params, toggle: false });
    }
  }
  if (!r.delivered) {
    const child = spawn("qs", ["-p", path.join(ROOT, "ui")], { detached: true, stdio: "ignore", env: childEnv({ HYPRPI_SOCKET: socketPath() }) });
    child.unref();
    for (let i = 0; i < 60 && !r.delivered; i++) {
      await new Promise((res) => setTimeout(res, 100));
      r = await request(method, { ...params, toggle: false });
    }
    if (!r.delivered) die("hyprpi UI process did not start (qs -p " + path.join(ROOT, "ui") + ")");
  }
  return r;
}

async function cmdRoom() {
  const toggle = flag("--toggle");
  // The top bar (hyprwrlds: a click on the selected world) sends `room --toggle`: that now means
  // the current world's agents panel, jump to it or open it here (mockups/agents-here). The old
  // Quickshell room window (ui/, `hyprpi room ROOM`) is retired: kept, not developed (Angus).
  if (toggle && !args[0]) {
    const r = spawnSync(process.execPath, [path.join(ROOT, "mockups", "agents-here")], { stdio: "inherit" });
    process.exit(r.status ?? 1);
  }
  console.log((await uiRequest("ui.open", { room: args[0] || "", toggle })).room);
}

async function cmdSearch() {
  const toggle = flag("--toggle");
  console.log((await uiRequest("ui.search", { room: args[0] || "", toggle })).room);
}

async function cmdFind() {
  const room = opt("--room");
  const mode = flag("--ai") ? "ai" : "keyword";
  const query = args.join(" ");
  if (!query.trim()) die("usage: hyprpi find [--room R] [--ai] QUERY");
  const r = await request("search", { room, query, mode }, { timeoutMs: 120000 });
  if (flag("--json")) return console.log(JSON.stringify(r, null, 1));
  console.log(`${r.results.length} results in room ${r.room} (${r.sources} sources${r.scanned ? `, ${r.scanned} entries read` : ""}, ${r.ms} ms)`);
  for (const h of r.results) {
    console.log(`${new Date(h.ts).toISOString().slice(5, 16).replace("T", " ")}  ${(h.icon ? h.icon + " " : "") + h.name} [${h.role}]  ${(h.pre + h.match + h.post).slice(0, 140)}${h.why ? "\n      ↳ " + h.why : ""}`);
  }
}

// hyprpi restore [all|X] [--list] [--no]: bring back what was open when hyprpi last went down
// (agents on their own workspaces, model and thinking; panels silently), or with --list only
// show it; --no lets it go (the agents stay in the room panel's closed list).
async function cmdRestore() {
  const list = flag("--list"), no = flag("--no");
  const scope = (args[0] || "all").toUpperCase() === "ALL" ? "all" : String(args[0]).toUpperCase();
  await ensureDaemon();
  if (no) return console.log(JSON.stringify(await request("restore.decline", {}), null, 1));
  const st = await request("restore.status", { scope });
  const show = (r) => `  ${r.world}\t${r.parked ? "parked" : r.workspace ?? "?"}\t${r.icon ? r.icon + " " : ""}${r.name}${r.twinOf ? " (twin)" : ""}`;
  console.log(`To restore (${scope}): ${st.text}`);
  for (const r of st.agents) console.log(show(r));
  for (const p of st.panels) console.log(`  ${p.world}\t${p.workspace ?? p.wsName}\t${p.kind} panel${p.floating ? " (floating)" : ""}`);
  for (const m of st.missing) console.log(`  ${m.world}\t-\t${m.name}: session file missing, can't restore`);
  if (list || (!st.agents.length && !st.panels.length)) return;
  const r = await request("restore.run", { scope, by: "hyprpi restore" }, { timeoutMs: 15 * 60000 });
  console.log(r.text);
}

async function cmdList() {
  const json = flag("--json");
  const r = await request("list");
  if (json) return console.log(JSON.stringify(r, null, 1));
  for (const room of r.rooms) {
    console.log(`Room ${room.id}${room.id === r.active_room ? "  (current)" : ""}`);
    for (const a of r.agents.filter((x) => x.room === room.id)) {
      console.log(`  ${(a.icon ? a.icon + " " : "") + a.display}\t${a.status}\t${a.workspace_label || "?"}\t${a.model}\t${a.id}`);
    }
    const th = (r.thoughts || []).find((t) => t.room === room.id);
    if (th) console.log(th.sandboxed ? `  💭 ${th.name}\tin its sandbox\t(sandboxed world: reached through ${th.sandboxed}; no host Thoughts)` : `  💭 ${th.name}\t${th.running ? "running" : "starts when talked to"}\t(world agent: talk to it any time)`); // J267
  }
}

function agentId() {
  const id = opt("--agent") || process.env.HYPRPI_AGENT_ID;
  if (!id) die("not inside a hyprpi agent (no HYPRPI_AGENT_ID); pass --agent ID");
  return id;
}

async function cmdName() {
  const id = agentId();
  if (args[0] === "--clear") return console.log(JSON.stringify(await request("agent.update", { agent_id: id, name: "", icon: "", color: "" })));
  const fg = opt("--fg");
  for (const f of ["--bold", "--italic", "--dim"]) flag(f);
  const name = args[0];
  if (!name || name.startsWith("-")) die("usage: hyprpi name NAME [--fg #rrggbb]");
  const r = await request("agent.update", { agent_id: id, name, ...(fg ? { color: fg } : {}) });
  console.log(`${r.icon ? r.icon + " " : ""}${r.name}`);
}

// J190: install / status of one of hyprpi's systemd --user units (see "mcp-gateway" and "remote" below).
const UNIT_MARK = "# Written by `hyprpi";
async function serviceCmd(name, template, unitName, afterInstall = () => {}) {
  const unitDir = path.join(process.env.XDG_CONFIG_HOME || path.join(process.env.HOME || "", ".config"), "systemd", "user");
  const unit = path.join(unitDir, unitName);
  const sc = (...a) => spawnSync("systemctl", ["--user", ...a], { encoding: "utf8" });
  const probe = sc("show-environment");
  const noSystemd = probe.error || probe.status !== 0;
  const state = () => noSystemd ? "unknown (no systemd --user here)" : `${sc("is-active", unitName).stdout.trim()}, ${sc("is-enabled", unitName).stdout.trim()}`;
  const sub = args[0] || "status";
  if (sub === "install") {
    const want = `${UNIT_MARK} ${name} install\` from ${template}; rerun it after moving the checkout.\n` +
      fs.readFileSync(template, "utf8").replaceAll("%h/Work/hyprpi", ROOT);
    let cur = null; try { cur = fs.lstatSync(unit); } catch { /* none */ }
    if (cur) {
      const ours = cur.isSymbolicLink() ? path.resolve(unitDir, fs.readlinkSync(unit)) === template : fs.readFileSync(unit, "utf8").startsWith(UNIT_MARK);
      if (!ours) die(`${unit} is already there and isn't hyprpi's; move it away first (it isn't overwritten)`);
    }
    if (cur && !cur.isSymbolicLink() && fs.readFileSync(unit, "utf8") === want) console.log(`unit up to date: ${unit}`);
    else { fs.mkdirSync(unitDir, { recursive: true }); if (cur) fs.rmSync(unit); fs.writeFileSync(unit, want); console.log(`wrote ${unit} (runs ${ROOT})`); }
    afterInstall();
    if (noSystemd) { console.log(`no systemd --user session here: start it by hand with the ExecStart line in ${unit}`); return; }
    sc("daemon-reload");
    const r = sc("enable", "--now", unitName);
    if (r.status !== 0) die(`systemctl --user enable --now ${unitName} failed: ${(r.stderr || "").trim()}`);
    console.log(`${name}: ${state()}`);
    return;
  }
  if (sub === "status") {
    let link = "not installed";
    try { const st = fs.lstatSync(unit); link = st.isSymbolicLink() ? `${unit} -> ${fs.readlinkSync(unit)}` : fs.readFileSync(unit, "utf8").startsWith(UNIT_MARK) ? `${unit} (written by hyprpi)` : `${unit} (not hyprpi's)`; } catch { /* none */ }
    console.log(`unit: ${link}\nservice: ${state()}`);
    const pid = noSystemd ? "" : sc("show", "-p", "MainPID", "--value", unitName).stdout.trim();
    if (pid && pid !== "0") {
      const kids = spawnSync("ps", ["--ppid", pid, "-o", "rss=,args="], { encoding: "utf8" }).stdout.trim().split("\n").filter(Boolean);
      if (name === "mcp-gateway") console.log(`servers running: ${kids.length}${kids.map((k) => "\n  " + k.trim().replace(/^(\d+)\s+/, (_m, r) => `${Math.round(r / 1024)} MB  `).slice(0, 140)).join("")}`);
    }
    return;
  }
  die(`usage: hyprpi ${name} [install|status]`);
}

const commands = {
  // J129 / J190: the MCP gateway (mcp-gateway/) and the phone app (remote-control/) as systemd --user units.
  // install writes the unit with THIS checkout's path (wherever hyprpi is cloned) and enables it; it replaces
  // an older link to the repo's unit or a unit it wrote itself, and never overwrites anyone else's file.
  "mcp-gateway": async () => serviceCmd("mcp-gateway", path.join(ROOT, "mcp-gateway", "mcp-gateway.service"), "mcp-gateway.service", () => {
    const cfgFile = process.env.MCP_GATEWAY_CONFIG || path.join(process.env.HOME || "", ".config", "mcp-gateway", "servers.json");
    if (!fs.existsSync(cfgFile)) console.log(`note: no config yet: copy ${path.join(ROOT, "mcp-gateway", "servers.example.json")} to ${cfgFile} and list your servers`);
  }),
  // J190: the home-folder wiring as opt-in, reversible pieces (lib/integration.mjs).
  integration: async () => {
    const I = await import("../lib/integration.mjs");
    const [sub = "status", ...names0] = args;
    const names = names0.flatMap((n) => n === "recommended" ? I.RECOMMENDED : n === "all" ? I.NAMES : [n]);
    if (sub === "status") {
      for (const r of I.status(names.length ? names : I.NAMES)) console.log(`${r.name.padEnd(19)} ${r.state.padEnd(16)} ${r.what}`);
      console.log(`\nrecommended: ${I.RECOMMENDED.join(" ")}  ·  hyprpi integration install|uninstall NAME…  (what each install did: ${path.join(stateDirOf(), "integrations.json")})`);
      return;
    }
    if ((sub === "install" || sub === "uninstall") && names.length) {
      try { for (const l of (sub === "install" ? I.install(names) : I.uninstall(names))) console.log(l); }
      catch (e) { if (e.partialOutput) { console.log(e.message); process.exit(1); } die(e.message); }
      return;
    }
    die("usage: hyprpi integration status [NAME…] | install NAME… | uninstall NAME…   (NAME: " + I.NAMES.join(", ") + ", recommended, all)");
  },
  remote: async () => serviceCmd("remote", path.join(ROOT, "remote-control", "hyprpi-remote-control.service"), "hyprpi-remote-control.service"),
  help: () => console.log(HELP),
  "--help": () => console.log(HELP),
  "-h": () => console.log(HELP),
  daemon: async () => {
    // J126: `hyprpi daemon restart` files a restart the daemon runs itself once everyone is idle; it returns
    // at once (never poll for idle yourself). --status / --cancel. Plain `hyprpi daemon` runs the daemon.
    if (args[0] === "restart") {
      args.shift();
      if (!(await alive())) die("the daemon isn't running (hyprpi ensure starts it)");
      const show = (p) => p ? `pending since ${new Date(p.since).toTimeString().slice(0, 5)}, asked by ${p.reasons.map((r) => r.by + (r.reason ? ` (${r.reason})` : "")).join(", ")}; waiting on: ${p.waiting_on.join(", ") || "nobody (restarts within ~30 s)"}; expires ${new Date(p.expires).toTimeString().slice(0, 5)}` : "no restart pending";
      if (flag("--status")) { console.log(show((await request("daemon.restartStatus")).pending)); return; }
      if (flag("--cancel")) { const r = await request("daemon.restartCancel", { agentId: process.env.HYPRPI_AGENT_ID || "" }); console.log(r.cancelled ? "cancelled" : "no restart was pending"); return; }
      flag("--when-idle"); // the only kind there is
      const reason = opt("--reason") || "", ttl = opt("--ttl");
      const r = await request("daemon.restartRequest", { agentId: process.env.HYPRPI_AGENT_ID || "", reason: reason || args.join(" "), ...(ttl ? { ttlMin: Number(ttl) } : {}) });
      console.log(`${r.merged ? "merged into the pending restart" : "restart queued"}: ${show(r)}. The daemon restarts itself when everyone is idle; you don't need to wait (end your turn). You (the asker) are told when it has happened; anyone else who must act after it: the wake_me tool (event restart), or Thoughts' wake_agent.`);
      return;
    }
    const { runDaemon } = await import("../lib/daemon.mjs"); await runDaemon();
  },
  // J136: what the daemon's login watch knows (never a token).
  auth: async () => {
    const s = await request("auth.status");
    if (flag("--json")) { console.log(JSON.stringify(s, null, 1)); return; }
    const L = Object.entries(s.lapses || {});
    console.log(L.length ? L.map(([p, l]) => `${p}: login LAPSED since ${new Date(l.since).toTimeString().slice(0, 5)}; stopped: ${l.stalled.map((x) => x.name).join(", ") || "none yet"}`).join("\n") : "no lapsed login");
    const W = Object.entries(s.warned || {}).filter(([, w]) => w.active);
    for (const [p, w] of W) console.log(`${p}: login ends ${new Date(w.expires).toLocaleString()}`);
    const R = Object.entries(s.recent || {}).filter(([, l]) => l.length);
    for (const [p, l] of R) console.log(`${p}: recent login errors from ${l.join(", ")} (not enough to call it)`);
    console.log(`watching ${s.authFile}; bar mark: ${s.alertFile}`);
  },
  ensure: async () => { await ensureDaemon(); console.log(socketPath()); },
  stop: async () => { if (await alive()) await request("shutdown"); },
  restore: cmdRestore,
  new: cmdNew,
  room: cmdRoom,
  search: cmdSearch,
  find: cmdFind,
  list: cmdList,
  post: async () => {
    const room = opt("--room");
    const via = opt("--via") || "cli";
    const text = args.join(" ");
    if (!text.trim()) die("usage: hyprpi post [--room R] TEXT");
    const r = await request("room.post", { room, text, as_human: true, via });
    console.log(`Room ${r.room} #${r.sequence} → ${r.delivered.length ? r.delivered.join(", ") : "no agents"}`);
  },
  // J98: a message to a world's Thoughts (default: the world you're on), e.g. dictation: --via voice marks it 🎤.
  thoughts: async () => {
    // J116: hyprpi thoughts new W [--handoff FILE]: a fresh session for world W's Thoughts (old one archived).
    if (args[0] === "new" && /^[A-Za-z][A-Za-z0-9]*$/.test(args[1] || "")) {
      const handoff = opt("--handoff") || "";
      const r = await request("thoughts.fresh", { room: args[1].toUpperCase(), ...(args.includes("--force") ? { force: true } : {}), ...(handoff ? { handoff: path.resolve(handoff.replace(/^~(?=\/)/, process.env.HOME)) } : {}) }, { timeoutMs: 20000 });
      console.log(`Thoughts-${r.room}: new session; ${r.files} file(s) archived in ${r.archived}${r.carried ? `; the last ${r.carried} turn(s) still shown above the divider` : ""}${r.handoff ? `; reading ${r.handoff}` : ""}`);
      return;
    }
    const room = opt("--room"), via = opt("--via") || "";
    const text = args.join(" ");
    if (!text.trim()) die("usage: hyprpi thoughts [--room R] [--via voice|phone] TEXT");
    const r = await request("thoughts.send", { ...(room ? { room } : {}), text, ...(via ? { via } : {}) });
    console.log(`Thoughts-${r.room}${r.busy ? " (thinking)" : ""}`);
  },
  // J98 v2: a dictation (voice-agent): the focused world's Thoughts, or a spoken addressee at the start
  // ("Knock, …" / "project system, …"), or --to hp:<id> | proj:<name> (the picker's sticky target). 🎤
  dictate: async () => {
    const to = opt("--to") || "", room = opt("--room");
    const text = args.join(" ");
    if (!text.trim()) die("usage: hyprpi dictate [--to hp:ID|proj:NAME] [--room R] TEXT");
    const r = await request("voice.dictate", { text, ...(to ? { to } : {}), ...(room ? { room } : {}) });
    console.log(r.to === "agent" ? `→ ${r.agent}` : r.to === "project" ? `→ ${r.project} (${(r.told || []).join(", ")})` : `→ ${r.thoughts}`);
  },
  // J98 v3: the voice widget's targets as JSON: the world you're on, its Thoughts, then agents and
  // projects (this world first, then the others). Built from list + board.get (no daemon change).
  "voice-targets": async () => {
    const l = await request("list"), world = l.active_room || "";
    const rooms = [...new Set([world, ...(l.rooms || []).map((r) => r.id)].filter(Boolean))];
    const first = (r) => (r === world ? 0 : 1);
    const agents = (l.agents || []).filter((a) => !a.parked).map((a) => ({ id: "hp:" + a.id, name: a.display, icon: a.icon || "🤖", room: a.room, status: a.status, ws: a.workspace_label || "" }))
      .sort((x, y) => first(x.room) - first(y.room) || String(x.room).localeCompare(String(y.room)) || x.name.localeCompare(y.name));
    const projects = [];
    for (const r of rooms) {
      const b = await request("board.get", { room: r }).catch(() => null);
      for (const p of b?.projects || []) if (p.status !== "archived" && b.room === r) projects.push({ id: "proj:" + p.name, name: "@" + p.name, icon: p.icon || "📋", room: r, owner: b.names?.[p.writer] || "" });
    }
    console.log(JSON.stringify({ world, thoughts: { id: "thoughts", name: `Thoughts (current world${world ? " " + world : ""})`, room: world }, agents, projects }));
  },
  send: async () => {
    const who = args.shift(); const text = args.join(" ");
    if (!who || !text.trim()) die("usage: hyprpi send AGENT TEXT");
    const r = await request("agent.prompt", { agent: who, text, via: "cli" });
    console.log(`→ ${r.name}`);
  },
  tinker: async () => {
    const text = args.join(" ");
    if (!text.trim()) die("usage: hyprpi tinker TEXT");
    const r = await request("tinker", { text, via: "cli" });
    console.log("🔧 " + (r.set ? `workshop is world ${r.set.workshop} now${r.set.previous ? " (was " + r.set.previous + ")" : ""} · ` : "") + (r.nothing ? "nothing to fix given" : r.queued ? `queued for the workshop (room ${r.room})${r.spawning ? ", opening an agent" : ""}` : `dropped off in the workshop (room ${r.room})`));
  },
  move: async () => {
    const to = opt("--to"), room = opt("--room");
    if (!to || (!room && !args.length)) die("usage: hyprpi move AGENT... --to WS|WORLD   or   hyprpi move --room C --to F");
    const r = await request("agent.move", room ? { room, to } : { agents: args, to });
    for (const m of r.moved) console.log(`${m.agent}: ${m.from ?? "?"} -> ${m.to}`);
    for (const k of r.skipped) console.log(`${k.agent}: not moved (${k.why})`);
  },
  spinout: async () => {
    const to = opt("--to"), from = opt("--from"), keepOwner = flag("--keep-owner");
    if (!to || args.length !== 1) die("usage: hyprpi spinout @PROJECT --to WORLD [--from WORLD] [--keep-owner]");
    // J133: run inside an agent, the board credits that agent (as_agent), not Angus.
    const r = await request("project.spinout", { project: args[0], to, ...(from ? { from } : {}), ...(keepOwner ? { keep_owner: true } : {}), ...(process.env.HYPRPI_AGENT_ID ? { as_agent: process.env.HYPRPI_AGENT_ID } : {}) });
    console.log(`📋 @${r.name}: board ${r.from} -> ${r.to}`);
    for (const m of r.moved) console.log(`${m.agent}: ${m.from ?? "?"} -> ${m.to}`);
    for (const k of r.skipped) console.log(`${k.agent}: not moved (${k.why})`);
    for (const n of r.rehomed) console.log(`${n}: closed, now listed in room ${r.to}`);
    for (const n of r.shared) console.log(`${n}: shared with another project, not moved`);
    for (const n of r.kept || []) console.log(`${n}: stays on it (--keep-owner), no new owner agent`);
  },
  finder: () => { // the finder add-on (mockups/finder; README "Add-ons")
    const r = spawnSync(process.execPath, [path.join(ROOT, "mockups", "finder"), ...args], { stdio: "inherit" });
    process.exit(r.status ?? 1);
  },
  focus: async () => { const r = await request("agent.focus", { agent: args[0] }); console.log(r.address); },
  // J87: restart an agent's pi on the same session (compacts first unless --no-compact); --wait prints the report.
  restart: async () => {
    const who = args.find((x) => !x.startsWith("-")), compact = !args.includes("--no-compact");
    if (!who) { console.error("usage: hyprpi restart AGENT [--no-compact] [--wait]"); process.exit(2); }
    const r = await request("agent.restart", { agent: who, compact, by: "you (hyprpi restart)" });
    console.log(`${r.agent}: ${r.already ? "already restarting" : r.queued ? "restarts when its turn ends" : "restarting"}${compact ? " (compacting first)" : ""}`);
    if (!args.includes("--wait")) return;
    for (let i = 0; i < 1200; i++) { // up to 20 min (a long turn, then compaction)
      await new Promise((res) => setTimeout(res, 1000));
      const s = await request("agent.restartStatus", { agent: who }).catch(() => null);
      if (s?.done) { console.log(s.line); return; }
    }
    console.error("no report after 20 min"); process.exit(1);
  },
  name: cmdName,
  status: async () => {
    const quiet = flag("--quiet");
    // --decision "question": blocked on a decision from Angus (`ding`); it becomes a Decide item (N68).
    const decision = opt("--decision", "");
    const id = agentId();
    const status = args[0];
    if (!["idle", "working", "blocked", "done"].includes(status)) die("usage: hyprpi status idle|working|blocked|done [--quiet] [--decision TEXT]");
    const r = await request("agent.update", { agent_id: id, status, quiet, ...(decision && status === "blocked" ? { decision } : {}) });
    console.log(r.status);
  },
  // Called by the Hyprland click hook with the clicked window's address.
  seen: async () => { if (!args[0]) die("usage: hyprpi seen WINDOW_ADDRESS"); console.log(JSON.stringify(await request("agent.seen", { address: args[0] }))); },
  whoami: async () => console.log(JSON.stringify(await request("whoami", { agent_id: agentId() }), null, 1)),
};

const fn = commands[cmd];
if (!fn) die(`unknown command '${cmd}'\n\n${HELP}`, 2);
try { await fn(); } catch (e) { die(e.message); }
