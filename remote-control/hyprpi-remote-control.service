# systemd --user unit: hyprpi remote control (the phone web app). A template: `hyprpi remote install`
# writes it to ~/.config/systemd/user with %h/Work/hyprpi replaced by the checkout's real path.
[Unit]
Description=hyprpi remote control (web app over Tailscale)
After=graphical-session.target

[Service]
ExecStart=/usr/bin/env node %h/Work/hyprpi/remote-control/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
