# systemd --user unit: mcp-gateway (one shared, lazily started copy of each stdio MCP server for all
# pi agents). A template: `hyprpi mcp-gateway install` writes it to ~/.config/systemd/user with %h/Work/hyprpi
# replaced by the checkout's real path (see mcp-gateway/README.md).
[Unit]
Description=mcp-gateway: one shared, lazily started copy of each stdio MCP server for all pi agents (hyprpi)
After=default.target

[Service]
ExecStart=/usr/bin/env node %h/Work/hyprpi/mcp-gateway/gateway.mjs
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
