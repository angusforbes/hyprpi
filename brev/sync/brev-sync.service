[Unit]
Description=J494/J547 two-way sync of the laptop folders in ~/.config/hyprpi/brev-sync.conf with their Brev boxes (~/Brev, ~/Brev/Hub); each pair pauses while its box is stopped
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/Harness/hyprpi/brev/sync/brev-sync
Nice=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
