#!/usr/bin/env bash
# J494 (Angus: "a shared folder that acts as a drop box on brev / 2 way / Make sure I can see brev folder on phone too") and
# J547 (Angus: "we should make a shared folder for the hub cpu instsance, like ~/Brev/Hub or something"): two-way synced folders
# between this laptop and Brev boxes, with Unison (the same static 2.54.0 binary on both sides). Run by brev-sync.timer (systemd
# user, every 2 min). The PAIRS are in ~/.config/hyprpi/brev-sync.conf, one per line:
#     LOCAL-FOLDER  BOX  REMOTE-FOLDER  [pull] [ignore=PATH …]
#   e.g. ~/Brev      hyprpi-l40s  workspace/shared  pull ignore=Hub
#        ~/Brev/Hub  hub          workspace/shared
#   (REMOTE-FOLDER is relative to the box's home; pull: also copy brev-image's new PNGs from the box's ~/workspace/outputs into
#   LOCAL-FOLDER; ignore=PATH: a path under LOCAL-FOLDER that this pair never syncs, e.g. another pair's folder inside it.)
#   No file: the one J494 pair, ~/Brev <-> hyprpi-l40s:~/workspace/shared (pull, ignore=Hub). BREV_SYNC_BOX set (tests, a drop-in):
#   one pair from BREV_SYNC_BOX / BREV_SYNC_DIR / BREV_SYNC_REMOTE, pulling with `omnistation/world BREV_SYNC_WORLD images`.
# Each pair, each run:
#   1. asks Brev (its API, not the box) whether its box is RUNNING; if not, the pair pauses quietly (one log line when that
#      changes), so a stopped box costs nothing and is never started;
#   2. (pull) copies new generated images from the box's ~/workspace/outputs;
#   3. syncs both ways. Conflicts: the newer copy wins and the other is kept next to it ("name (conflict_on_DATE).ext");
#      overwritten or deleted files are kept in ~/.unison/backup on the side that lost them (the last 3). A whole replica gone
#      empty is never propagated (confirmbigdel stops that pair's run).
# The box-side folder is NOT ~/workspace/outputs, so files arriving from the laptop never count as box activity for an idle check
# that watches outputs and the hyprpi session files. ssh by itself doesn't count as activity there.
# Failures (J497), per pair: a failure while its box is RUNNING makes the run exit 1 (systemd shows it failed); after
# BREV_SYNC_ALERT_AFTER (3) in a row Angus gets ONE alert naming the pair (a ⚠ line in Thoughts-A + a desktop notification), and
# one "working again" when it next succeeds. A box that stops, even mid-run, is a pause, not a failure.
#   brev-sync          one run of every pair (what the timer does)
#   brev-sync status   each pair's box state, failures, the last log lines
set -uo pipefail
H="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
UNISON="${BREV_SYNC_UNISON:-$HOME/.local/lib/unison-2.54.0/unison}"
ST="${XDG_STATE_HOME:-$HOME/.local/state}/brev-sync"; mkdir -p "$ST"
CONF="${BREV_SYNC_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/hyprpi/brev-sync.conf}"
LOG="$ST/sync.log"
ALERT_AFTER="${BREV_SYNC_ALERT_AFTER:-3}"; ALERT_WORLD="${BREV_SYNC_ALERT_WORLD:-A}"
SSHARGS="-o ConnectTimeout=20 -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
[[ -f "$LOG" ]] && (( $(wc -l < "$LOG") > 2000 )) && { tail -n 1000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; }

# A pair's state folder name (HubSyncCheck547: by pair, not by box, so two pairs on one box never share a failure count):
# BOX for the usual workspace/shared; any other remote folder: "+" and a hash of box and folder (a box name never has "+", so
# the two kinds never collide)
pairkey() { if [[ "$2" == workspace/shared ]]; then echo "$1"; else echo "+$(printf '%s\0%s' "$1" "$2" | sha256sum | cut -c1-16)"; fi; }
# The pairs: lines of "LOCAL<TAB>BOX<TAB>REMOTE<TAB>OPTS"
pairs() {
  if [[ -n "${BREV_SYNC_BOX:-}" ]]; then printf '%s\t%s\t%s\t%s\n' "${BREV_SYNC_DIR:-$HOME/Brev}" "$BREV_SYNC_BOX" "${BREV_SYNC_REMOTE:-workspace/shared}" "pullworld"; return; fi
  if [[ ! -f "$CONF" ]]; then printf '%s\t%s\t%s\t%s\n' "$HOME/Brev" hyprpi-l40s workspace/shared "pull ignore=Hub"; return; fi
  local l a b c rest seen=" "
  while IFS= read -r l || [[ -n "$l" ]]; do
    l="${l%%#*}"; read -r a b c rest <<< "$l"; [[ -n "$a" && -n "$b" && -n "$c" ]] || continue
    [[ "$b" =~ ^([A-Za-z0-9._-]+@)?[A-Za-z0-9._-]+$ && "$c" =~ ^[A-Za-z0-9._/-]+$ && "$c" != *..* ]] || { log "config: bad line skipped: $l"; continue; }
    [[ "$seen" == *" $b:$c "* ]] && { log "config: $b:~/$c is already in another pair; line skipped: $l"; continue; } # one laptop folder per box folder
    seen+="$b:$c "
    printf '%s\t%s\t%s\t%s\n' "${a/#\~/$HOME}" "$b" "$c" "$rest"
  done < "$CONF"
}

if [[ "${1:-}" == status ]]; then
  ls_out="$(timeout 60 brev ls 2>/dev/null)"
  while IFS=$'\t' read -r -u 4 LOCAL BOX REMOTE OPTS; do
    P="$ST"; [[ -z "${BREV_SYNC_BOX:-}" ]] && P="$ST/pairs/$(pairkey "$BOX" "$REMOTE")"
    if [[ " $OPTS " == *" ssh=tsh "* ]]; then ts="$(timeout 20 "${BREV_SYNC_TSH:-tsh}" status 2>/dev/null)" && [[ "$ts" != *EXPIRED* ]] && bs="via Teleport, login $(sed -n 's/.*Valid until: *\(.*\)/valid until \1/p' <<< "$ts" | head -1)" || bs="via Teleport, login EXPIRED (tsh login)"; [[ "$bs" == *"login valid"* || "$bs" == *EXPIRED* ]] || bs="via Teleport, login ok"; else bs="box $(awk -v b="$BOX" '$1==b{print $2}' <<< "$ls_out")"; fi
    echo "$LOCAL <-> $BOX:~/$REMOTE${OPTS:+ ($OPTS)}: $bs; last state: $(cat "$P/state" 2>/dev/null), failures in a row: $(cat "$P/fails" 2>/dev/null || echo 0)$([[ -f "$P/alerted" ]] && echo ", alerted")"
  done 4< <(pairs)
  echo "--- log (last 12)"; tail -n 12 "$LOG" 2>/dev/null; exit 0
fi

exec 9>"$ST/lock"; flock -n 9 || exit 0   # a run still going (slow network): skip this one

alert() { # $1 = text; both channels, each best effort; fails (1) when neither delivered
  local sent=""
  hyprpi thoughts alert "$ALERT_WORLD" "$1" >/dev/null 2>&1 && sent="Thoughts-$ALERT_WORLD"
  notify-send -a brev-sync -u "${2:-critical}" "brev-sync" "$1" >/dev/null 2>&1 && sent="${sent:+$sent + }desktop"
  log "alert (${sent:-NO channel reached; tried Thoughts-$ALERT_WORLD and desktop}): $1"
  [[ -n "$sent" ]]
}

# New PNGs from the box's ~/workspace/outputs into $1 (plain names only, ones not already there). -> exit code; prints how many.
# J663 (no silent success): they arrive in a staging folder in $1 (named *.unison.tmp, which the sync ignores) and are moved in
# only when the whole copy succeeded: a copy cut off half way used to leave a truncated PNG that counted as "already there", was
# never copied again and was synced on to the box. A PNG changed in the last 10 s (still being written) waits for the next run.
pull_ssh() {
  local dest="$1" box="$2" names n new=() stage moved=0
  find "$dest" -maxdepth 1 -name '.images-*.unison.tmp' -type d -mmin +60 -exec rm -rf {} + 2>/dev/null # (a run killed mid-copy)
  names=$(timeout 120 ssh $SSHARGS "$box" "cd ~/workspace/outputs 2>/dev/null && python3 -c 'import os,re,time; [print(f) for f in sorted(os.listdir(\".\")) if re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9._-]*[.]png\", f) and os.path.isfile(f) and time.time() - os.path.getmtime(f) > 10]' || true" 2>/dev/null) || return 3
  while IFS= read -r n; do n="${n%$'\r'}"; [[ "$n" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.png$ && ! -e "$dest/$n" ]] && new+=("$n"); done <<< "$names"
  (( ${#new[@]} )) || { echo 0; return 0; }
  stage=$(mktemp -d "$dest/.images-XXXXXX.unison.tmp") || return 4
  if ! timeout 300 ssh $SSHARGS "$box" "cd ~/workspace/outputs && tar -cf - -- ${new[*]}" | tar -xf - -C "$stage"; then
    rm -rf "$stage"; echo "copying ${#new[@]} new image(s) was cut off: none kept, the next run copies them again"; return 4
  fi
  # (NssCheck) each image must really be in place, same size as staged; a failure is reported (pull failed) and its staged copy kept
  local bad=() sz
  for n in "${new[@]}"; do
    if [[ ! -f "$stage/$n" ]]; then bad+=("$n"); continue; fi
    [[ -e "$dest/$n" ]] && { rm -f "$stage/$n"; continue; }
    sz=$(stat -c %s -- "$stage/$n"); if mv -n -- "$stage/$n" "$dest/$n" 2>/dev/null && [[ -f "$dest/$n" && "$(stat -c %s -- "$dest/$n")" == "$sz" ]]; then moved=$((moved + 1)); else bad+=("$n"); fi
  done
  if (( ${#bad[@]} )); then echo "${#bad[@]} image(s) not put in place: ${bad[*]} (kept in $stage)"; return 4; fi
  rm -rf "$stage"
  echo "$moved"
}

any_failed=0
sync_pair() { # LOCAL BOX REMOTE OPTS
  local LOCAL="$1" BOX="$2" REMOTE="$3" OPTS="$4" P="$ST" TAG="" why="" rc prc=0 pulled="" out status now fails o
  [[ -z "${BREV_SYNC_BOX:-}" ]] && { P="$ST/pairs/$(pairkey "$BOX" "$REMOTE")"; TAG="[$BOX${REMOTE:+:$REMOTE}] "; [[ "$REMOTE" == workspace/shared ]] && TAG="[$BOX] "; }
  mkdir -p "$P" "$LOCAL"
  local NAME="${LOCAL/#$HOME/\~} <-> $BOX:~/$REMOTE"
  pstate() { local was; was="$(cat "$P/state" 2>/dev/null)"; [[ "$was" == "$1" ]] || { log "$TAG$1${2:+: $2}"; echo "$1" > "$P/state"; }; }
  # J550: ssh=tsh: a machine reached through Teleport (the Omnistation), not a Brev box: no `brev ls` check (it's always on);
  # Unison's ssh goes through brev/sync/tsh-ssh. An expired Teleport login is a failure (alerts once, naming the pair): only
  # Angus can renew it (`tsh login`, SSO).
  local teleport="" sshcmd=() sshargs=(-sshargs "$SSHARGS")
  [[ " $OPTS " == *" ssh=tsh "* ]] && { teleport=1; sshcmd=(-sshcmd "${BREV_SYNC_TSH_SSH:-$H/brev/sync/tsh-ssh}"); sshargs=(); }
  if [[ -z "$teleport" ]]; then
    status="$(awk -v b="$BOX" '$1==b{print $2}' <<< "$LS")"
    if [[ "$status" != RUNNING ]]; then pstate "paused" "box $BOX is ${status:-unknown (brev ls failed)}"; echo 0 > "$P/fails"; return 0; fi
  elif ! timeout 20 "${BREV_SYNC_TSH:-tsh}" status >/dev/null 2>&1; then
    why="the Teleport login has expired (or tsh failed): Angus needs to run \`tsh login\` at the desk (SSO)"; pstate "teleport-login" "$why"
  fi
  # 2. new generated images
  if [[ " $OPTS " == *" pullworld "* ]]; then
    pulled="$(HYPRPI_IMAGES_DIR="$LOCAL" timeout 300 "$H/omnistation/world" "${BREV_SYNC_WORLD:-I}" images 2>&1)"; prc=$?
    [[ $prc -eq 0 ]] && grep -q "^file://" <<< "$pulled" && log "${TAG}pulled from outputs: $(grep -c '^file://' <<< "$pulled") image(s)"
  elif [[ " $OPTS " == *" pull "* ]]; then
    pulled="$(pull_ssh "$LOCAL" "$BOX")"; prc=$?
    [[ $prc -eq 0 && "$pulled" =~ ^[1-9] ]] && log "${TAG}pulled from outputs: $pulled image(s)"
  fi
  # 3. two-way (ignore=PATH: another pair's folder inside this one)
  local ign=(); for o in $OPTS; do [[ "$o" == ignore=* && "${o#ignore=}" =~ ^[A-Za-z0-9._/-]+$ ]] && ign+=(-ignore "Path ${o#ignore=}"); done
  if [[ -n "$why" ]]; then rc=-1; out=""; else
  out="$(timeout 900 "$UNISON" "$LOCAL" "ssh://$BOX/$REMOTE" -batch -auto -times -prefer newer -copyonconflict \
    -backup 'Name *' -maxbackups 3 -confirmbigdel -ignore 'Name .*.unison.tmp' -ignore 'Name .unison.*' "${ign[@]}" \
    -servercmd .local/bin/unison "${sshargs[@]}" "${sshcmd[@]}" -logfile "$ST/unison.log" -ui text 2>&1)"; rc=$?
  fi
  # Unison: 0 = done, 1 = some skipped, 2 = non-fatal failures, 3 = fatal (e.g. no connection). Conflicts aren't failures.
  case $rc in
    -1) ;; # (not run: why is set above)
    0) pstate "ok"; local c; c="$(grep -E 'Synchronization complete' <<< "$out" | tail -1)"; [[ -n "$c" ]] && log "$TAG$c" ;;
    1|2) why="unison exit $rc (some files not synced): $(grep -E 'failed|Error|skipped' <<< "$out" | tail -n 3 | tr '\n' ' ' | cut -c1-300)"; pstate "partial" "$why"; log "$TAG$(tail -n 5 <<< "$out" | tr '\n' ' ' | cut -c1-600)" ;;
    *) if grep -q confirmbigdel <<< "$out"; then # (HubSyncCheck547) not a connection problem: Unison's safety stop
         why="one side ($LOCAL or $BOX:~/$REMOTE) is now empty, so the deletion was NOT copied to the other side (Unison's safety stop): empty the other side too, or put a file back"; pstate "both-sides-differ" "$why"
       else why="unison exit $rc: $(grep -v -E '^(Pseudo|Warning: Perm|mux_client|ControlSocket)' <<< "$out" | tail -n 3 | tr '\n' ' ' | cut -c1-300)"; pstate "unreachable" "$why"; fi ;;
  esac
  [[ -z "$why" && $prc -ne 0 ]] && { why="pulling new images failed (exit $prc): $(tail -n 2 <<< "$pulled" | tr '\n' ' ' | cut -c1-300)"; pstate "pull-failed" "$why"; }
  # J497 v2: a box that stopped (or is stopping) during the run is a pause, not a failure
  if [[ -n "$why" && -z "$teleport" ]]; then
    now="$(timeout 60 brev ls 2>/dev/null | awk -v b="$BOX" '$1==b{print $2}')"
    if [[ "$now" != RUNNING ]]; then pstate "paused" "box $BOX went ${now:-unknown (brev ls failed)} during the run"; echo 0 > "$P/fails"; return 0; fi
  fi
  fails="$(cat "$P/fails" 2>/dev/null || echo 0)"; [[ "$fails" =~ ^[0-9]+$ ]] || fails=0
  if [[ -n "$why" ]]; then
    fails=$((fails + 1)); echo "$fails" > "$P/fails"
    # one alert per outage (until a run succeeds); "alerted" only once a channel delivered
    if (( fails >= ALERT_AFTER )) && [[ ! -f "$P/alerted" ]]; then
      alert "brev-sync: $NAME has failed $fails runs in a row while the box is running. Last: $why. Details: brev-sync status, ~/.local/state/brev-sync/." && touch "$P/alerted"
    fi
    echo "brev-sync: $NAME: $why" >&2
    any_failed=1; return 1
  fi
  echo 0 > "$P/fails"
  if [[ -f "$P/alerted" ]]; then rm -f "$P/alerted"; alert "brev-sync: working again ($NAME synced)." normal; fi
  return 0
}

# J722 nss1b (Angus: "b"): `brev ls` itself failing (no answer, non-zero exit) used to be only a "paused: unknown" line per pair.
# Now: ONE alert once it has failed for BREV_SYNC_LS_ALERT_MIN (30) minutes in a row, and one "working again" when it next works.
# State in $ST: ls-failing-since (epoch s), ls-alerted. BREV_SYNC_NOW (epoch s) overrides the clock for tests.
LS_ALERT_S=$(( ${BREV_SYNC_LS_ALERT_MIN:-30} * 60 )); NOW_S="${BREV_SYNC_NOW:-$(date +%s)}"
LS="$(timeout 60 brev ls 2>/dev/null)"; LS_RC=$?
if (( LS_RC != 0 )); then
  [[ -f "$ST/ls-failing-since" ]] || { echo "$NOW_S" > "$ST/ls-failing-since"; log "brev ls failed (exit $LS_RC); will alert if it keeps failing for $((LS_ALERT_S / 60)) min"; }
  since="$(cat "$ST/ls-failing-since" 2>/dev/null)"; [[ "$since" =~ ^[0-9]+$ ]] || since="$NOW_S"
  if (( NOW_S - since >= LS_ALERT_S )) && [[ ! -f "$ST/ls-alerted" ]]; then
    alert "brev-sync: \`brev ls\` has been failing for $(( (NOW_S - since) / 60 )) min (exit $LS_RC): box states are unknown, so no pair is syncing. Check brev login / network; brev-sync status." && touch "$ST/ls-alerted"
  fi
else
  if [[ -f "$ST/ls-alerted" ]]; then rm -f "$ST/ls-alerted"; alert "brev-sync: \`brev ls\` works again." normal; fi
  rm -f "$ST/ls-failing-since"
fi
while IFS=$'\t' read -r -u 4 L B R O; do sync_pair "$L" "$B" "$R" "$O" </dev/null; done 4< <(pairs) # (ssh and unison never see the list)
exit $any_failed
