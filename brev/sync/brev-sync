#!/usr/bin/env bash
# J494 (Angus: "a shared folder that acts as a drop box on brev / 2 way / Make sure I can see brev folder on phone too"):
# ~/Brev on the laptop <-> ~/workspace/shared on the Brev box, two-way, with Unison (the same static 2.54.0 binary on both
# sides). Run by brev-sync.timer (systemd user, every 2 min). Each run:
#   1. asks Brev (its API, not the box) whether the box is RUNNING; if not, it exits quietly (one log line when that changes),
#      so a stopped box costs nothing and is never started;
#   2. pulls brev-image's new PNGs from ~/workspace/outputs into ~/Brev (omnistation/world <letter> images);
#   3. syncs ~/Brev <-> ~/workspace/shared both ways. Conflicts: the newer copy wins and the other is kept next to it
#      (copyonconflict: "name (conflict_on_DATE).ext"); overwritten or deleted files are also kept in ~/.unison/backup on the
#      side that lost them (the last 3). A whole replica gone empty is never propagated (confirmbigdel stops the run).
# The box-side folder is NOT ~/workspace/outputs, so files arriving from the laptop never touch what an idle check watches
# (outputs/*.png, ~/.hyprpi-i session and state files). ssh by itself doesn't count as activity there.
# Settings (env, e.g. in a systemd drop-in): BREV_SYNC_BOX, BREV_SYNC_WORLD, BREV_SYNC_DIR, BREV_SYNC_REMOTE, BREV_SYNC_UNISON.
#   brev-sync          one run (what the timer does)
#   brev-sync status   the box's state, the last runs, and what's in both folders
set -uo pipefail
H="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
BOX="${BREV_SYNC_BOX:-hyprpi-l40s}"; WL="${BREV_SYNC_WORLD:-I}"
LOCAL="${BREV_SYNC_DIR:-$HOME/Brev}"; REMOTE="${BREV_SYNC_REMOTE:-workspace/shared}"
UNISON="${BREV_SYNC_UNISON:-$HOME/.local/lib/unison-2.54.0/unison}"
ST="${XDG_STATE_HOME:-$HOME/.local/state}/brev-sync"; mkdir -p "$ST" "$LOCAL"
LOG="$ST/sync.log"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
# one line per change of state, not one per run (no spam while the box is stopped)
state() { local was; was="$(cat "$ST/state" 2>/dev/null)"; [[ "$was" == "$1" ]] || { log "$1${2:+: $2}"; echo "$1" > "$ST/state"; }; }
# keep the log short
[[ -f "$LOG" ]] && (( $(wc -l < "$LOG") > 2000 )) && { tail -n 1000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; }

if [[ "${1:-}" == status ]]; then
  echo "box $BOX: $(brev ls 2>/dev/null | awk -v b="$BOX" '$1==b{print $2}')"; echo "last state: $(cat "$ST/state" 2>/dev/null), failures in a row: $(cat "$ST/fails" 2>/dev/null || echo 0)$([[ -f "$ST/alerted" ]] && echo ", alerted")"
  echo "--- log (last 10)"; tail -n 10 "$LOG" 2>/dev/null; echo "--- $LOCAL"; ls -la "$LOCAL"; exit 0
fi

exec 9>"$ST/lock"; flock -n 9 || exit 0   # a run still going (slow network): skip this one

status="$(timeout 60 brev ls 2>/dev/null | awk -v b="$BOX" '$1==b{print $2}')"
if [[ "$status" != RUNNING ]]; then state "paused" "box $BOX is ${status:-unknown (brev ls failed)}"; echo 0 > "$ST/fails"; exit 0; fi

SSHARGS="-o ConnectTimeout=20 -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
# 2. new generated images (world <letter> images skips names already in ~/Brev)
pulled="$(HYPRPI_IMAGES_DIR="$LOCAL" timeout 300 "$H/omnistation/world" "$WL" images 2>&1)"; prc=$?
[[ $prc -eq 0 ]] && grep -q "^file://" <<< "$pulled" && log "pulled from outputs: $(grep -c '^file://' <<< "$pulled") image(s)"
# 3. two-way
out="$(timeout 900 "$UNISON" "$LOCAL" "ssh://$BOX/$REMOTE" -batch -auto -times -prefer newer -copyonconflict \
  -backup 'Name *' -maxbackups 3 -confirmbigdel -ignore 'Name .*.unison.tmp' -ignore 'Name .unison.*' \
  -servercmd .local/bin/unison -sshargs "$SSHARGS" -logfile "$ST/unison.log" -ui text 2>&1)"; rc=$?
# Unison: 0 = nothing to do or all done, 1 = all done but some skipped, 2 = non-fatal failures, 3 = fatal (e.g. no connection).
# Conflicts aren't failures (-prefer newer settles them and -copyonconflict keeps the other copy), so 1 and 2 are real problems.
why=""
case $rc in
  0) state "ok"; c="$(grep -E 'Synchronization complete' <<< "$out" | tail -1)"; [[ -n "$c" ]] && log "$c" ;;
  1|2) why="unison exit $rc (some files not synced): $(grep -E 'failed|Error|skipped' <<< "$out" | tail -n 3 | tr '\n' ' ' | cut -c1-300)"; state "partial" "$why"; log "$(tail -n 5 <<< "$out" | tr '\n' ' ' | cut -c1-600)" ;;
  *) why="unison exit $rc: $(grep -v -E '^(Pseudo|Warning: Perm|mux_client|ControlSocket)' <<< "$out" | tail -n 3 | tr '\n' ' ' | cut -c1-300)"; state "unreachable" "$why" ;;
esac
[[ -z "$why" && $prc -ne 0 ]] && { why="pulling new images failed (world $WL images, exit $prc): $(tail -n 2 <<< "$pulled" | tr '\n' ' ' | cut -c1-300)"; state "pull-failed" "$why"; }
# J497 v2: a run can take minutes; a box that stopped (or is stopping) meanwhile is a pause, not a failure
if [[ -n "$why" ]]; then
  now="$(timeout 60 brev ls 2>/dev/null | awk -v b="$BOX" '$1==b{print $2}')"
  if [[ "$now" != RUNNING ]]; then state "paused" "box $BOX went ${now:-unknown (brev ls failed)} during the run"; echo 0 > "$ST/fails"; exit 0; fi
fi

# J497 (Angus: "shouldn't we notice a failure"): a failure while the box is RUNNING makes this run fail (systemd shows it),
# and after ALERT_AFTER failures in a row Angus gets ONE alert: a ⚠ line in world ALERT_WORLD's Thoughts thread
# (hyprpi thoughts alert) and a desktop notification. One "working again" notice when a run succeeds after an alert.
# A stopped box (above) is a pause, not a failure: it neither counts nor alerts.
ALERT_AFTER="${BREV_SYNC_ALERT_AFTER:-3}"; ALERT_WORLD="${BREV_SYNC_ALERT_WORLD:-A}"
alert() { # $1 = text; both channels, each best effort; fails (1) when neither delivered
  local sent=""
  hyprpi thoughts alert "$ALERT_WORLD" "$1" >/dev/null 2>&1 && sent="Thoughts-$ALERT_WORLD"
  notify-send -a brev-sync -u "${2:-critical}" "brev-sync" "$1" >/dev/null 2>&1 && sent="${sent:+$sent + }desktop"
  log "alert (${sent:-NO channel reached; tried Thoughts-$ALERT_WORLD and desktop}): $1"
  [[ -n "$sent" ]]
}
fails="$(cat "$ST/fails" 2>/dev/null || echo 0)"; [[ "$fails" =~ ^[0-9]+$ ]] || fails=0
if [[ -n "$why" ]]; then
  fails=$((fails + 1)); echo "$fails" > "$ST/fails"
  # one alert per outage: none again until a run has succeeded (a stopped-box pause in between doesn't end the outage);
  # "alerted" only once a channel delivered, so an undelivered alert is tried again on the next failed run
  if (( fails >= ALERT_AFTER )) && [[ ! -f "$ST/alerted" ]]; then
    alert "brev-sync: ~/Brev <-> $BOX:~/$REMOTE has failed $fails runs in a row while the box is running. Last: $why. Details: brev-sync status, ~/.local/state/brev-sync/." && touch "$ST/alerted"
  fi
  echo "brev-sync: $why" >&2
  exit 1
fi
echo 0 > "$ST/fails"
if [[ -f "$ST/alerted" ]]; then rm -f "$ST/alerted"; alert "brev-sync: working again (~/Brev <-> $BOX:~/$REMOTE synced)." normal; fi
exit 0
