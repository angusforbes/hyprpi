#!/usr/bin/env bash
# brev-autostop (J498, Angus: "yes auto stop! 1"; J516: every instance, "part of our hyprpi brev install"): stop any Brev box after
# its idle minutes (default 45), so none bills for nothing. Runs every 5 min from the systemd user timer brev-autostop.timer.
# Each run:
#   1. asks Brev (its API, not the boxes) which instances are RUNNING; every RUNNING one is checked, except those the config
#      excludes; STOPPED / absent / brev ls failing: nothing. With no config file at all it does nothing (install makes one);
#   2. asks each box (one ssh command, read-only, its own connection) how long ago it last did real work:
#        - newest change to a hyprpi world's sessions, Thoughts threads and boards (~/.hyprpi-*/…), brev-image's PNGs
#          (~/workspace/outputs) and the two-way shared folder (~/workspace/shared): a file changed there recently, or its listing
#          (names, sizes, mtimes) differs from the last run, since Unison keeps a copied file's original mtime;
#        - vLLM requests: its /metrics counter of finished requests moved since the last run, or a request is running now;
#        - the GPU (J516, for a plain training box): nvidia-smi utilisation above gpu_busy_pct (10) in any of 3 samples;
#      An ssh login by itself changes none of these, so it never counts;
#   3. idle = time since the latest of: that activity, and when this timer first saw the box RUNNING (a fresh start gets its time);
#   4. idle >= its limit: `brev stop BOX` (keeps /home/ubuntu/workspace), then ONE notice naming the box: a desktop notification
#      and a ⚠ line in world A's Thoughts thread (hyprpi thoughts alert). A failed stop alerts once, then retries hourly quietly.
# A box that can't be read (ssh fails) is never stopped on a guess. Instances to leave alone go in the LIVE config only (exclude NAME). Boxes are handled independently.
# Config (J516): ~/.config/hyprpi/brev-autostop.conf, made from brev/autostop/brev-autostop.conf.example on first use:
#   default_idle_min 45 · gpu_busy_pct 10 · idle NAME MIN · default_unhealthy_min 45 · unhealthy NAME MIN · exclude NAME ·
#   box NAME (registered by setup; just the default)
# Commands: run (the timer) · status · pause [NAME] [N(m|h|d)] · resume [NAME] · install [NAME] (link + enable the timer, register
# NAME) · setup-hook BINDING.json (what `world X setup` runs: install for the binding's box when it is a Brev instance) · config.
# Env (for tests too): BREV_AUTOSTOP_CONFIG, _WORLD (Thoughts thread), _STATE (dir), _BREV / _SSH / _NOTIFY / _HYPRPI /
# _SYSTEMCTL (commands), _BIN (where install links the script), _NOW (laptop epoch), _DRY (1 = say, don't stop), _STOP_TIMEOUT.
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# J526: settings written by deploy-hub (~/.config/hyprpi/brev-autostop.env) apply to a hand run too, not just to the timer's;
# only plain KEY=VALUE lines for BREV_AUTOSTOP_* / HYPRPI_* are read, and a variable already set wins
ENVF="${BREV_AUTOSTOP_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/hyprpi/brev-autostop.env}"
if [[ -f "$ENVF" ]]; then
  while IFS= read -r l; do
    [[ "$l" =~ ^((BREV_AUTOSTOP|HYPRPI)_[A-Z_]+)=([A-Za-z0-9_./:-]*)$ ]] || continue
    [[ -n "${!BASH_REMATCH[1]:-}" ]] || export "${BASH_REMATCH[1]}=${BASH_REMATCH[3]}"
  done < "$ENVF"
fi
WORLD="${BREV_AUTOSTOP_WORLD:-A}"
ST="${BREV_AUTOSTOP_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/brev-autostop}"
CONF="${BREV_AUTOSTOP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hyprpi/brev-autostop.conf}"
BREV="${BREV_AUTOSTOP_BREV:-brev}"
SSH="${BREV_AUTOSTOP_SSH:-ssh}"
NOTIFY="${BREV_AUTOSTOP_NOTIFY:-notify-send}"
HYPRPI="${BREV_AUTOSTOP_HYPRPI:-hyprpi}"
SYSTEMCTL="${BREV_AUTOSTOP_SYSTEMCTL:-systemctl}"
mkdir -p "$ST/boxes"
now() { echo "${BREV_AUTOSTOP_NOW:-$(date +%s)}"; }
log() { printf '%s %s\n' "$(date -d "@$(now)" '+%F %T')" "$*" >> "$ST/log"; } # (trimmed to 400 lines by run, under its lock)
mins() { echo $(( ($1 + 30) / 60 )); }
NAME_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$'
rows() { awk 'h && NF>=2 {print $1, $2} $1=="NAME" && $2=="STATUS" {h=1}' <<<"$1"; } # brev ls: "NAME STATUS …" rows after its header line

# --- config ------------------------------------------------------------------------------------------------------------------
ensure_conf() { [[ -f "$CONF" ]] || { mkdir -p "$(dirname "$CONF")" && cp "$HERE/brev-autostop.conf.example" "$CONF" && log "made $CONF from the example"; }; }
cfg() { [[ -f "$CONF" ]] && tr -d '\r' < "$CONF" | grep -v '^[[:space:]]*#'; } # (CRLF-safe)
DEFAULT_IDLE="$(cfg | awk '$1=="default_idle_min" && $2~/^[0-9]+$/{v=$2+0} END{print v}')"; DEFAULT_IDLE="${DEFAULT_IDLE:-45}"
GPU_BUSY="$(cfg | awk '$1=="gpu_busy_pct" && $2~/^[0-9]+$/{v=$2+0} END{print v}')"; GPU_BUSY="${GPU_BUSY:-10}"
excluded() { cfg | awk -v b="$1" '$1=="exclude" && $2==b{f=1} END{exit !f}'; }
DEFAULT_UNH="$(cfg | awk '$1=="default_unhealthy_min" && $2~/^[0-9]+$/{v=$2+0} END{print v}')"; DEFAULT_UNH="${DEFAULT_UNH:-45}"
MARGIN=0 # (J526) extra minutes while a backup copy is acting: a primary that is in fact still working stops the box first
unhealthy_min() { local v; v="$(cfg | awk -v b="$1" '$1=="unhealthy" && $2==b && $3~/^[0-9]+$/{v=$3+0} END{print v}')"; echo $(( ${v:-$DEFAULT_UNH} + MARGIN )); }
idle_min() { local v; v="$(cfg | awk -v b="$1" '$1=="idle" && $2==b && $3~/^[0-9]+$/{v=$3+0} END{print v}')"; echo $(( ${v:-$DEFAULT_IDLE} + MARGIN )); }

# --- per-box state: $ST/boxes/<name>/ ------------------------------------------------------------------------------------------
D=""; BOX=""
use() { BOX="$1"; D="$ST/boxes/$1"; mkdir -p "$D"; }
get() { cat "$D/$1" 2>/dev/null; }
put() { printf '%s\n' "$2" > "$D/$1"; }
state() { [[ "$(get state)" == "$1" ]] || { put state "$1"; log "$2"; }; } # one log line per change of state, not one per run
paused_until() { local p; for p in "$(cat "$ST/pause" 2>/dev/null)" "$(get pause)"; do [[ -n "$p" ]] && [[ "$p" == 0 || "$p" -gt "$(now)" ]] && { echo "$p"; return 0; }; done; return 1; }
dur() { local n="${1%[mhd]}" u="${1: -1}" s; [[ "$n" =~ ^[0-9]+$ ]] || return 1; n=$((10#$n)); case "$u" in m) s=60;; h) s=3600;; d) s=86400;; *) s=60;; esac; echo $(( $(now) + n * s )); }

# --- J527 (Angus: "1 let's try it, we can always configure them off"): alerts as phone push notifications through ntfy.sh ---
# On when the config says `notify_phone on` AND the topic file exists (~/.config/hyprpi/brev-autostop.ntfy, 600: one line, the
# topic, a long random name that acts as the password; never in the repo or the log). Priority high for a failed stop / a stuck
# box / the backup taking over, default otherwise. ntfy.sh being down never affects the run (10 s timeout, errors ignored).
NTFY_FILE="${BREV_AUTOSTOP_NTFY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/hyprpi/brev-autostop.ntfy}"
NTFY_SERVER="${BREV_AUTOSTOP_NTFY_SERVER:-https://ntfy.sh}"
CURL="${BREV_AUTOSTOP_CURL:-curl}"
phone_on() { cfg | awk '$1=="notify_phone"{v=$2} END{exit !(v=="on")}'; }
topic() { local t; t="$(head -c 200 "$NTFY_FILE" 2>/dev/null | tr -d ' \r\n')"; [[ "$t" =~ ^[A-Za-z0-9_-]{20,64}$ ]] && echo "$t"; }
phone_post() { # $1 title, $2 text, $3 priority
  phone_on || return 1; local t; t="$(topic)" || return 1
  "$CURL" -fsS -m 10 -o /dev/null -H "Title: $1" -H "Priority: $3" -H "Tags: $([[ "$3" == high ]] && echo warning || echo stop_sign)" --data-binary "$2" "$NTFY_SERVER/$t" >/dev/null 2>&1
}
set_phone() { # on|off in the config (one notify_phone line)
  ensure_conf; local tmp; tmp="$(mktemp "$CONF.XXXXXX")"
  { grep -v '^[[:space:]]*notify_phone[[:space:]]' "$CONF"; echo "notify_phone $1"; } > "$tmp" && chmod --reference="$CONF" "$tmp" 2>/dev/null; mv -f "$tmp" "$CONF"
}
fwd_pause() { # (J526) a backup copy's pause / resume is the primary's too: there it matters (args already checked)
  [[ -n "${BREV_AUTOSTOP_PRIMARY:-}" && "${BREV_AUTOSTOP_PRIMARY}" =~ $NAME_RE ]] || return 0
  local a q=""; for a in "$@"; do [[ "$a" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "brev-autostop: not forwarded to $BREV_AUTOSTOP_PRIMARY (odd argument)" >&2; return 0; }; q+=" $a"; done
  if timeout -k 5 45 "$SSH" -o BatchMode=yes -o ConnectTimeout=15 -o ControlMaster=no -o ControlPath=none "$BREV_AUTOSTOP_PRIMARY" "\$HOME/.local/bin/brev-autostop$q" 2>/dev/null | sed "s/^/$BREV_AUTOSTOP_PRIMARY: /"; then :; else echo "brev-autostop: couldn't reach $BREV_AUTOSTOP_PRIMARY: only this (backup) copy is paused there; do it there too: ssh $BREV_AUTOSTOP_PRIMARY brev-autostop $*" >&2; fi
}
case "${1:-run}" in
  pause|resume)
    # pause [NAME|all] [N(m|h|d)|forever]: a NAME protects just that box (e.g. a training run); none or "all" = every box; no time or
    # "forever" = until resume. With one argument, a duration means all boxes, anything else a box name; a box whose name looks
    # like a duration needs both: `pause 24h forever`. resume [NAME|all].
    who=""; t=""
    if [[ "$1" == resume ]]; then who="${2:-}"
    elif [[ $# -ge 3 ]]; then who="$2"; t="$3"
    elif [[ -n "${2:-}" ]]; then if dur "$2" >/dev/null; then t="$2"; else who="$2"; fi; fi
    [[ "$who" == all ]] && who=""; [[ "$t" == forever ]] && t=""
    [[ -z "$who" || "$who" =~ $NAME_RE ]] || { echo "usage: brev-autostop $1 [NAME|all] [N(m|h|d)|forever]" >&2; exit 2; }
    f="$ST/pause"; [[ -n "$who" ]] && { use "$who"; f="$D/pause"; }
    if [[ "$1" == resume ]]; then fwd_pause "$@"; rm -f "$f"; log "resumed by hand${who:+: $who}"; echo "brev-autostop resumed${who:+ for $who}"; exit 0; fi
    until=0; if [[ -n "$t" ]]; then until="$(dur "$t")" || { echo "usage: brev-autostop pause [NAME|all] [N(m|h|d)|forever]" >&2; exit 2; }; fi
    fwd_pause "$@"
    printf '%s\n' "$until" > "$f"; log "paused by hand${who:+: $who} $([[ -n "$t" ]] && echo "for $t" || echo "until resume")"
    echo "brev-autostop paused ${who:-all boxes} $([[ $until -gt 0 ]] && date -d "@$until" '+until %a %H:%M' || echo "until: brev-autostop resume${who:+ $who}")"; exit 0;;
  config) ensure_conf; echo "$CONF"; exit 0;;
  phone)
    # phone on | off | test | status | topic | set-topic (stdin). With BREV_AUTOSTOP_PRIMARY (the laptop's backup copy), on / off /
    # set-topic are done on the primary too, which gets the same topic file over ssh.
    sub="${2:-status}"; prim="${BREV_AUTOSTOP_PRIMARY:-}"; [[ -z "$prim" || "$prim" =~ $NAME_RE ]] || prim=""
    onprim() { [[ -n "$prim" ]] || return 0; timeout -k 5 45 "$SSH" -o BatchMode=yes -o ConnectTimeout=15 -o ControlMaster=no -o ControlPath=none "$prim" "\$HOME/.local/bin/brev-autostop phone $1" 2>/dev/null | sed "s/^/$prim: /" || echo "brev-autostop: couldn't reach $prim (do it there too: ssh $prim brev-autostop phone $1)" >&2; }
    case "$sub" in
      on)
        if ! topic >/dev/null; then (umask 077; mkdir -p "$(dirname "$NTFY_FILE")"; t="$(head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 28)"; [[ ${#t} -ge 24 ]] && printf 'brevstop-%s\n' "$t" > "$NTFY_FILE"); chmod 600 "$NTFY_FILE"; echo "made a new topic in $NTFY_FILE (600)"; fi
        topic >/dev/null || { echo "brev-autostop: no valid topic in $NTFY_FILE" >&2; exit 1; }
        set_phone on; log "phone notifications on"; echo "phone notifications on (server $NTFY_SERVER; topic: brev-autostop phone topic)"
        if [[ -n "$prim" ]]; then timeout -k 5 45 "$SSH" -o BatchMode=yes -o ConnectTimeout=15 -o ControlMaster=no -o ControlPath=none "$prim" "\$HOME/.local/bin/brev-autostop phone set-topic" < "$NTFY_FILE" 2>/dev/null | sed "s/^/$prim: /"; onprim on; fi
        exit 0;;
      off) set_phone off; log "phone notifications off"; echo "phone notifications off"; onprim off; exit 0;;
      set-topic) (umask 077; mkdir -p "$(dirname "$NTFY_FILE")"; head -c 200 | tr -d ' \r\n' > "$NTFY_FILE.new"; echo >> "$NTFY_FILE.new"); chmod 600 "$NTFY_FILE.new"; mv -f "$NTFY_FILE.new" "$NTFY_FILE"; topic >/dev/null && echo "topic stored (600)" || { echo "brev-autostop: that topic isn't valid" >&2; exit 1; }; exit 0;;
      topic) topic || { echo "no topic yet (brev-autostop phone on)" >&2; exit 1; }; exit 0;;
      test) BOX="(test)"; if phone_post "Brev auto-stop" "Test: phone notifications from brev-autostop on $(hostname) work. You'll get one when a box is stopped or stuck." default; then echo "test sent"; log "phone: test sent"; else echo "test NOT sent ($(phone_on && echo "is ntfy.sh reachable?" || echo "phone notifications are off"))" >&2; exit 1; fi; exit 0;;
      status) echo "phone notifications: $(phone_on && echo on || echo off); topic file: $([[ -n "$(topic)" ]] && echo "$NTFY_FILE (set)" || echo "none"); server $NTFY_SERVER"; exit 0;;
      *) echo "usage: brev-autostop phone on|off|test|status|topic" >&2; exit 2;;
    esac;;
  install)
    # J516 (Angus: "part of our hyprpi brev install when we first set up a brev instance"): idempotent; prints one line per change.
    name="${2:-}"; [[ -z "$name" || "$name" =~ $NAME_RE ]] || { echo "brev-autostop install: bad name" >&2; exit 2; }
    ensure_conf
    bin="${BREV_AUTOSTOP_BIN:-$HOME/.local/bin}"; mkdir -p "$bin"
    [[ "$(readlink -f "$bin/brev-autostop" 2>/dev/null)" == "$HERE/brev-autostop" ]] || { ln -sfn "$HERE/brev-autostop" "$bin/brev-autostop"; echo "auto-stop: linked $bin/brev-autostop"; }
    if ! "$SYSTEMCTL" --user is-enabled --quiet brev-autostop.timer 2>/dev/null; then
      "$SYSTEMCTL" --user link "$HERE/brev-autostop.service" "$HERE/brev-autostop.timer" >/dev/null 2>&1
      "$SYSTEMCTL" --user enable --now brev-autostop.timer >/dev/null 2>&1 || { echo "auto-stop: couldn't enable brev-autostop.timer (see systemctl --user status brev-autostop.timer)" >&2; exit 1; }
      echo "auto-stop: enabled the laptop timer brev-autostop.timer (every 5 min)"; log "install: timer enabled"
    elif ! "$SYSTEMCTL" --user is-active --quiet brev-autostop.timer 2>/dev/null; then
      "$SYSTEMCTL" --user start brev-autostop.timer >/dev/null 2>&1 || { echo "auto-stop: brev-autostop.timer is enabled but won't start (see systemctl --user status brev-autostop.timer)" >&2; exit 1; }
      echo "auto-stop: started brev-autostop.timer"
    fi
    if [[ -n "$name" ]]; then
      if excluded "$name"; then echo "auto-stop: $name is EXCLUDED in $CONF (never stopped automatically)"; exit 0; fi
      cfg | awk -v b="$name" '($1=="box"||$1=="idle") && $2==b{f=1} END{exit !f}' || { printf 'box %s\n' "$name" >> "$CONF"; log "install: registered $name"; }
      echo "auto-stop is on for $name: stopped after $(idle_min "$name") idle minutes (config $CONF; pause: brev-autostop pause $name 24h)"
    else echo "auto-stop is on (config $CONF)"; fi
    exit 0;;
  setup-hook)
    # J516: what `world X setup` runs: the binding's Brev instance (its "brev", else the last word of its "ssh") gets auto-stop, if
    # `brev ls` lists it. Anything else (Omnistation, no brev CLI, brev ls failing) is not a Brev box: silent, exit 0.
    b="$(jq -r 'if (.brev|type)=="string" then .brev elif (.ssh|type)=="array" then .ssh[-1] else empty end' "${2:-/dev/null}" 2>/dev/null)"
    [[ "$b" =~ $NAME_RE ]] || exit 0
    command -v "$BREV" >/dev/null 2>&1 || exit 0
    out="$(timeout -k 10 60 "$BREV" ls 2>/dev/null)" || exit 0
    rows "$out" | awk -v b="$b" '$1==b{f=1} END{exit !f}' || exit 0
    exec "$0" install "$b";;
  status)
    out="$(timeout -k 10 60 "$BREV" ls 2>/dev/null)" || echo "brev ls failed"
    p="$(cat "$ST/pause" 2>/dev/null)"; [[ -n "$p" ]] && { [[ "$p" == 0 ]] && echo "ALL PAUSED until resume" || echo "ALL PAUSED until $(date -d "@$p" '+%a %H:%M')"; }
    echo "config $CONF: default ${DEFAULT_IDLE} min, GPU busy above ${GPU_BUSY}%"
    echo "phone notifications: $(phone_on && [[ -n "$(topic)" ]] && echo on || echo off)"
    [[ -n "${BREV_AUTOSTOP_PRIMARY:-}" ]] && echo "BACKUP of the copy on $BREV_AUTOSTOP_PRIMARY: $(cat "$ST/role" 2>/dev/null || echo "not run yet") (acts only when that copy hasn't run for ${BREV_AUTOSTOP_STALE_MIN:-15} min)"
    [[ -f "$ST/heartbeat" ]] && echo "this copy last ran $(( ($(now) - $(cat "$ST/heartbeat")) / 60 )) min ago"
    for b in $( { rows "$out" | awk '{print $1}'; ls "$ST/boxes" 2>/dev/null; } | sort -u); do
      [[ "$b" =~ $NAME_RE ]] || continue; use "$b"
      st="$(rows "$out" | awk -v b="$b" '$1==b{print $2}')"; la="$(get last_act)"
      printf '%s: %s · %s · state %s%s%s\n' "$b" "${st:-not listed}" "$(excluded "$b" && echo excluded || echo "idle limit $(idle_min "$b") min")" "$(get state)" \
        "$([[ -n "$la" ]] && echo " · last activity $(date -d "@$la" '+%a %H:%M') ($(get last_why))")" "$(p="$(get pause)"; [[ -n "$p" ]] && { [[ "$p" == 0 ]] && echo " · PAUSED until resume" || echo " · PAUSED until $(date -d "@$p" '+%a %H:%M')"; })"
    done
    echo "log ($ST/log):"; tail -n 15 "$ST/log" 2>/dev/null; exit 0;;
  run) ;;
  *) echo "usage: brev-autostop [run|status|pause [NAME] [N(m|h|d)]|resume [NAME]|install [NAME]|setup-hook BINDING.json|config|phone on|off|test|status|topic]" >&2; exit 2;;
esac

alert() { # $1 = text, $2 = urgency: every channel, each best effort; says which reached (never the phone topic)
  local sent=""
  "$HYPRPI" thoughts alert "$WORLD" "$1" >/dev/null 2>&1 && sent="Thoughts-$WORLD"
  "$NOTIFY" -a brev-autostop -u "${2:-normal}" "Brev box $BOX" "$1" >/dev/null 2>&1 && sent="${sent:+$sent + }desktop"
  phone_post "Brev box $BOX" "$1" "$([[ "${2:-normal}" == critical ]] && echo high || echo default)" && sent="${sent:+$sent + }phone"
  log "notice (${sent:-no channel reached}): $1"
}

# One run at a time (a hand run next to the timer's): a second one just leaves.
exec 9>"$ST/lock"; flock -n 9 || exit 0
[[ -f "$ST/log" && $(wc -l < "$ST/log") -gt 500 ]] && { tail -n 400 "$ST/log" > "$ST/log.tmp" && mv "$ST/log.tmp" "$ST/log"; }
[[ -f "$ST/pause" ]] && { p="$(cat "$ST/pause")"; [[ "$p" != 0 && "$p" -le "$(now)" ]] && { rm -f "$ST/pause"; log "pause (all boxes) ended"; }; }

# J526 (Angus: "brev guards"): the main copy runs on the always-on Brev box "hub", so boxes are stopped while the laptop sleeps.
# A copy with BREV_AUTOSTOP_PRIMARY=<ssh host> (the laptop's) is only its backup: each run it asks the primary how long ago its
# copy last ran (its heartbeat; the age is computed there, so the clocks don't matter). Under BREV_AUTOSTOP_STALE_MIN (15): it
# stands by and does nothing. Stale, missing or unreachable: it acts as usual and says so ONCE; one more notice when the primary
# is back. So the two never both act unless the laptop can't reach a hub that is in fact fine.
PRIMARY="${BREV_AUTOSTOP_PRIMARY:-}"
if [[ -n "$PRIMARY" ]]; then
  [[ "$PRIMARY" =~ $NAME_RE ]] || { log "bad BREV_AUTOSTOP_PRIMARY: nothing done"; exit 0; }
  STALE_MIN="${BREV_AUTOSTOP_STALE_MIN:-15}"
  hb="$(timeout -k 5 45 "$SSH" -o BatchMode=yes -o ConnectTimeout=15 -o ControlMaster=no -o ControlPath=none "$PRIMARY" 'f=$HOME/.local/state/brev-autostop/heartbeat; if [ -f "$f" ]; then echo "age $(( $(date +%s) - $(cat "$f") ))"; else echo "age none"; fi' 2>/dev/null | awk '$1=="age"{print $2}' | tail -1)"
  BOX="(backup)"
  if [[ "$hb" =~ ^-?[0-9]+$ ]] && (( hb < STALE_MIN * 60 )); then
    rm -f "$ST/unreach_since"
    if [[ -f "$ST/primary_down" ]]; then rm -f "$ST/primary_down"; alert "Brev auto-stop: the copy on $PRIMARY is running again; the laptop's backup copy stands by." normal; fi
    [[ "$(cat "$ST/role" 2>/dev/null)" == standby ]] || { echo standby > "$ST/role"; log "backup: $PRIMARY's copy ran $(( hb / 60 )) min ago: standing by"; }
    exit 0
  fi
  if ! [[ "$hb" =~ ^[0-9]+$ ]] && [[ "$hb" != none ]]; then # unreachable: give it STALE_MIN before acting (a network blip is not an outage)
    [[ -f "$ST/unreach_since" ]] || now > "$ST/unreach_since"
    if (( $(now) - $(cat "$ST/unreach_since") < STALE_MIN * 60 )); then [[ "$(cat "$ST/role" 2>/dev/null)" == waiting ]] || { echo waiting > "$ST/role"; log "backup: can't reach $PRIMARY: waiting ${STALE_MIN} min before acting"; }; exit 0; fi
  else rm -f "$ST/unreach_since"; fi
  why="$([[ "$hb" =~ ^[0-9]+$ ]] && echo "hasn't run for $(( hb / 60 )) min" || { [[ "$hb" == none ]] && echo "has never run (no heartbeat)" || echo "can't be reached over ssh"; })"
  if [[ ! -f "$ST/primary_down" ]]; then now > "$ST/primary_down"; alert "Brev auto-stop: the copy on $PRIMARY $why, so the laptop's backup copy is checking the Brev boxes until it's back." critical; fi
  [[ "$(cat "$ST/role" 2>/dev/null)" == acting ]] || { echo acting > "$ST/role"; log "backup: $PRIMARY's copy $why: acting"; }
  MARGIN="${BREV_AUTOSTOP_BACKUP_MARGIN_MIN:-10}" # (if the primary is only unreachable from here but working, it stops the box first and the box is no longer RUNNING when this copy would)
fi

# the box-side probe (read-only; ages computed on the box, so the two clocks don't matter)
probe='now=$(date +%s); newest() { find -H "$@" -type f -printf "%T@\n" 2>/dev/null | sort -n | tail -1 | cut -d. -f1; }
age() { local m; m=$(newest "$@"); [ -n "$m" ] && echo $((now - m)) || echo none; }
agen() { local m; m=$(find -H "$@" -printf "%T@\n" 2>/dev/null | sort -n | tail -1 | cut -d. -f1); [ -n "$m" ] && echo $((now - m)) || echo none; }
echo "sessions $(agen ~/.hyprpi-*/sessions -maxdepth 2 -type f -name "*.jsonl")"
echo "thread $(agen ~/.hyprpi-*/state/thoughts -maxdepth 1 -type f -name "*.thread.jsonl")"
echo "boards $(agen ~/.hyprpi-*/state/boards -maxdepth 1 -type f -name "*.jsonl")"
echo "outputs $(agen ~/workspace/outputs -maxdepth 1 -type f -name "*.png")"
echo "shared $(age ~/workspace/shared)"
echo "shared_sig $(cd ~/workspace/shared 2>/dev/null && find . -path ./.unison -prune -o -printf "%P %s %T@\n" 2>/dev/null | sort | md5sum | cut -c1-16 || echo none)"
mt=$(curl -fsS -m 5 http://127.0.0.1:8000/metrics 2>/dev/null)
if [ -n "$mt" ]; then echo "vllm_total $(printf "%s\n" "$mt" | awk "/^vllm:request_success_total/{s+=\$2} END{printf \"%d\", s}")"; echo "vllm_running $(printf "%s\n" "$mt" | awk "/^vllm:num_requests_running/{s+=\$2} END{printf \"%d\", s}")"; else echo "vllm_total none"; fi
g=none; if command -v nvidia-smi >/dev/null 2>&1; then for i in 1 2 3; do u=$(timeout 10 nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | tr -dc "0-9\n" | sort -n | tail -1); [ -n "$u" ] && { [ "$g" = none ] || [ "$u" -gt "$g" ]; } && g=$u; [ $i -lt 3 ] && sleep 1; done; fi
echo "gpu $g"
echo ok'

check_box() { # $1 = a RUNNING instance; never exits the script (each box on its own)
  use "$1"; local IDLE_MIN T res best why a k sg ps vt vr prev gu la rs from ref idle sf sout
  IDLE_MIN="$(idle_min "$BOX")"
  T="$(now)"
  [[ -n "$(get running_since)" ]] || { put running_since "$T"; log "box $BOX is RUNNING: watching (idle limit ${IDLE_MIN} min)"; }
  if [[ -f "$D/pause" ]]; then local p; p="$(get pause)"; [[ "$p" != 0 && "$p" -le "$T" ]] && { rm -f "$D/pause"; log "pause ended: $BOX"; }; fi
  if paused_until >/dev/null; then state "paused" "paused: not stopping $BOX"; return 0; fi
  # (J512) its own connection, never Brev's shared one (ControlMaster auto, ControlPersist 10m): when this ssh had to START the shared
  # master under `timeout` inside $(…), the capture waited for the backgrounded master and every first probe after a quiet spell failed
  res="$(timeout -k 10 90 "$SSH" -o BatchMode=yes -o ConnectTimeout=20 -o ControlMaster=no -o ControlPath=none "$BOX" "bash -s" <<<"$probe" 2>/dev/null)"
  if ! grep -qx ok <<<"$res"; then state "probe-failed" "couldn't read $BOX's activity over ssh: not stopping on a guess"; return 0; fi
  val() { awk -v k="$1" '$1==k{print $2}' <<<"$res"; }
  best=""; why=""
  for k in sessions thread boards outputs shared; do
    a="$(val "$k")"; [[ "$a" =~ ^-?[0-9]+$ ]] || continue; (( a < 0 )) && a=0
    if [[ -z "$best" || "$a" -lt "$best" ]]; then best="$a"; why="$k"; fi
  done
  sg="$(val shared_sig)"; ps="$(get shared_sig)"
  if [[ -n "$sg" && "$sg" != none ]]; then
    [[ -n "$ps" && "$sg" != "$ps" ]] && { best=0; why="shared folder changed"; }
    put shared_sig "$sg"
  fi
  vt="$(val vllm_total)"; vr="$(val vllm_running)"; prev="$(get vllm_total)"
  if [[ "$vt" =~ ^[0-9]+$ ]]; then
    if [[ "${vr:-0}" =~ ^[0-9]+$ && "${vr:-0}" -gt 0 ]]; then best=0; why="vLLM request running"
    elif [[ -n "$prev" && "$vt" != "$prev" ]]; then best=0; why="vLLM requests ($prev → $vt)"; fi
    put vllm_total "$vt"
  fi
  gu="$(val gpu)"; if [[ "$gu" =~ ^[0-9]+$ ]] && (( 10#$gu > GPU_BUSY )); then best=0; why="GPU busy (${gu}%)"; fi
  la="$(get last_act)"; [[ -n "$la" ]] || la=0 # the latest real activity seen so far (kept: a vLLM count change is seen only once)
  if [[ -n "$best" && $(( T - best )) -gt "$la" ]]; then la=$(( T - best )); put last_act "$la"; put last_why "$why"; fi
  rs="$(get running_since)"; from="$la"; ref="$(get last_why)"
  if [[ "$rs" -gt "$from" ]]; then from="$rs"; ref="the box started (first seen RUNNING)"; fi
  idle=$(( T - from ))
  # idle long enough: stop it, tell Angus once
  if (( idle < IDLE_MIN * 60 )); then state "active" "$BOX active (last: $ref): watching"; return 0; fi
  sf="$(get stop_failed)"
  if [[ -n "$sf" ]] && (( T - sf < 3600 )); then state "stop-failed" "$BOX still idle; the stop failed: retrying hourly, no new alert"; return 0; fi
  if paused_until >/dev/null; then state "paused" "paused (during this run): not stopping $BOX"; return 0; fi # a pause given while the probe ran still counts
  if excluded "$BOX"; then return 0; fi # (re-read: the config may have changed during the probe)
  if [[ "${BREV_AUTOSTOP_DRY:-}" == 1 ]]; then log "DRY: would stop $BOX (idle $(mins "$idle") min, last: $ref)"; return 0; fi
  log "stopping $BOX: idle $(mins "$idle") min (last: $ref)"
  if sout="$(timeout -k 15 "${BREV_AUTOSTOP_STOP_TIMEOUT:-300}" "$BREV" stop "$BOX" 2>&1)"; then
    put state "stopped"; rm -f "$D/stop_failed" "$D/running_since" "$D/vllm_total" "$D/shared_sig" "$D/last_act" "$D/last_why"
    alert "Brev auto-stop: stopped $BOX after $(mins "$idle") idle minutes. Its workspace is kept; ask an agent to start it again (brev start $BOX)." normal
  else
    put stop_failed "$T"; put state "stop-failed"
    [[ -n "$sf" ]] && { log "stop of $BOX failed again: $(tr '\n' ' ' <<<"$sout" | cut -c1-200)"; return 1; } # alerted once already
    alert "Brev auto-stop: $BOX has been idle $(mins "$idle") min but 'brev stop' failed: $(tr '\n' ' ' <<<"$sout" | cut -c1-200). It is still billing; stop it by hand: brev stop $BOX" critical
    return 1
  fi
}

# No config (exclusions unknown): never probe or stop anything; say so once. `brev-autostop install` makes it.
if [[ ! -f "$CONF" ]]; then [[ "$(cat "$ST/state" 2>/dev/null)" == no-config ]] || { echo no-config > "$ST/state"; log "no config at $CONF: nothing done (run brev-autostop install)"; }; exit 0; fi
# J523 (Angus: "if it's unhealthy stop it and alert me"): a box stuck UNHEALTHY (or in a failed stop) may still bill. After
# unhealthy_min (default 45) without a break: ONE `brev stop`, then ONE alert with the status brev ls gives right after. If the
# stop fails, or the box later lands in a failed-stop state (J512: a stop on a wedged box can end in stopping_failed), ONE more
# alert; after that it retries at most hourly and says nothing more until the box is STOPPED (then one "now stopped" notice).
# A paused box is never stopped: it only gets the one alert. Excluded boxes are never touched (the loop skips them).
UNH_FILES=(unh_since unh_tried unh_paused_alerted unh_failed_alerted)
bad_state() { [[ "${1^^}" == UNHEALTHY || "${1^^}" =~ FAIL ]]; }
unhealthy_box() { # $1 = name, $2 = its status (UNHEALTHY or a failed state)
  use "$1"; local st="$2" T since lim tried out2 after sout
  T="$(now)"; lim="$(unhealthy_min "$BOX")"
  rm -f "$D/running_since" "$D/vllm_total" "$D/shared_sig" "$D/last_act" "$D/last_why" "$D/stop_failed" # (its idle watch starts over)
  since="$(get unh_since)"; [[ -n "$since" ]] || { since="$T"; put unh_since "$T"; }
  if [[ -n "$(get unh_tried)" && "${st^^}" =~ FAIL && -z "$(get unh_failed_alerted)" ]]; then
    put unh_failed_alerted "$T"; alert "Brev auto-stop: $BOX is now '$st' after the stop it tried (a stop on a wedged box can do this). It may still bill; check the Brev console. Retrying the stop at most hourly, no more alerts." critical
  fi
  if (( T - since < lim * 60 )); then state "unhealthy" "box $BOX is $st: watching (stop after ${lim} min of this)"; return 0; fi
  if paused_until >/dev/null; then
    [[ -n "$(get unh_paused_alerted)" ]] || { put unh_paused_alerted "$T"; alert "Brev auto-stop: $BOX has been $st for $(mins $(( T - since ))) min. It is paused, so it was NOT stopped; it may still bill (brev stop $BOX by hand, or brev-autostop resume $BOX)." critical; }
    state "unhealthy-paused" "box $BOX is $st but paused: alerted, not stopping"; return 0
  fi
  tried="$(get unh_tried)"
  if [[ -n "$tried" ]] && (( T - tried < 3600 )); then state "unhealthy-tried" "box $BOX still $st: retrying the stop at most hourly"; return 0; fi
  if [[ "${BREV_AUTOSTOP_DRY:-}" == 1 ]]; then log "DRY: would stop $BOX ($st for $(mins $(( T - since ))) min)"; return 0; fi
  log "stopping $BOX: $st for $(mins $(( T - since ))) min"; put unh_tried "$T"
  local ok=1; sout="$(timeout -k 15 "${BREV_AUTOSTOP_STOP_TIMEOUT:-300}" "$BREV" stop "$BOX" 2>&1)" || ok=0
  out2="$(timeout -k 10 60 "$BREV" ls 2>/dev/null)"; after="$(rows "$out2" | awk -v b="$BOX" '$1==b{print $2}')"; after="${after:-unknown}"
  if [[ -n "$tried" ]]; then # a retry: quiet unless it worked
    [[ "${after^^}" == STOPPED ]] && { alert "Brev auto-stop: $BOX is STOPPED now (it had been $st)." normal; rm -f "${UNH_FILES[@]/#/$D/}"; put state "stopped"; }
    log "retried the stop of $BOX: $([[ $ok == 1 ]] && echo ok || echo failed), status now $after"; return 0
  fi
  if [[ $ok == 1 && "${after^^}" =~ ^(STOPPED|STOPPING)$ ]]; then
    alert "Brev auto-stop: $BOX had been $st for $(mins $(( T - since ))) min, so it ran 'brev stop $BOX'. Status now: $after." normal
  else
    put unh_failed_alerted "$T"
    alert "Brev auto-stop: $BOX had been $st for $(mins $(( T - since ))) min; 'brev stop $BOX' $([[ $ok == 1 ]] && echo "ran" || echo "failed ($(tr '\n' ' ' <<<"$sout" | cut -c1-160))"), status now: $after. It may still bill; check the Brev console. Retrying at most hourly, no more alerts." critical
  fi
  [[ "${after^^}" == STOPPED ]] && { rm -f "${UNH_FILES[@]/#/$D/}"; put state "stopped"; }
  return 0
}

# Brev's own view: every instance and its status
out="$(timeout -k 10 60 "$BREV" ls 2>/dev/null)"; rc=$?
if [[ $rc -ne 0 ]]; then
  [[ "$(cat "$ST/state" 2>/dev/null)" == brev-error ]] || { echo brev-error > "$ST/state"; log "brev ls failed (rc $rc): nothing done"; }; exit 0
fi
echo ok > "$ST/state"
now > "$ST/heartbeat" # (J526) "this copy is working" (brev ls answered and there is a config): a backup copy elsewhere reads it
declare -A seen=(); fail=0
while read -r name status _; do
  [[ "$name" =~ $NAME_RE && -n "${status:-}" ]] || continue
  seen[$name]=1
  if excluded "$name"; then continue; fi                               # never touched, never even probed
  if bad_state "$status"; then unhealthy_box "$name" "$status"; continue; fi
  use "$name"
  if [[ -n "$(get unh_tried)" ]]; then # a stop this script tried for an unhealthy spell is still being followed:
    if [[ "${status^^}" == STOPPING ]]; then state "unhealthy-stopping" "box $name is STOPPING after the stop it tried: following it"; continue; fi
    if [[ "${status^^}" == STOPPED && -n "$(get unh_failed_alerted)" ]]; then alert "Brev auto-stop: $name is STOPPED now (after the failed stop it alerted about)." normal; fi
  fi
  rm -f "${UNH_FILES[@]/#/$D/}" # (any other status ends an unhealthy spell)
  if [[ "$status" == RUNNING ]]; then check_box "$name" || fail=1; continue; fi
  rm -f "$D/running_since" "$D/vllm_total" "$D/shared_sig" "$D/last_act" "$D/last_why" "$D/stop_failed"
  state "not-running" "box $name is $status: nothing to do"
done < <(rows "$out")
for d in "$ST/boxes"/*/; do # a box that left the list (deleted): forget its watch state, quietly
  b="$(basename "$d")"; [[ -n "${seen[$b]:-}" || ! -d "$d" ]] && continue
  use "$b"; rm -f "$D/running_since" "$D/vllm_total" "$D/shared_sig" "$D/last_act" "$D/last_why" "$D/stop_failed" "${UNH_FILES[@]/#/$D/}"; state "not-listed" "box $b is not listed: nothing to do"
done
exit $fail
