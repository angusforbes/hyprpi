#!/usr/bin/env bash
# world: the laptop side of a REMOTE world (J469/J471). Any world letter can be bound to a remote machine: its agents run headless
# there (omnistation/remote.sh, under ~/.hyprpi-<letter> on that machine), and here each one is a window on that world's
# workspaces, drawn locally (omnistation/remote-client.mjs, pi's own components): typing is local, a finished message goes to the
# remote pi, its output streams back, and the window reconnects by itself after a drop or a new login.
#
#   world X setup            copy remote.sh + hbroker.mjs to the machine and install hyprpi there (copy of master, or git)
#   world X start [NAME]     start the remote daemon and agent NAME (default alpha)
#   world X new [NAME]       start a new agent remotely and open its window (start + open); the binding's "prefix" (e.g.
#                            "omni-") starts its name; no NAME: one is picked. SUPER+A on the world's workspaces runs this
#   world X rename NAME NEW  rename an agent, keeping its session
#   world X open [NAME]      open agent NAME's window on the world's first workspace, silently (your view doesn't move)
#   world X focus NAME       jump to agent NAME's window (open it first if it has none), as a local agent's focus does (J543)
#   world X status           what runs remotely
#   world X stop [NAME|all]  stop an agent remotely (its session stays: start / open resumes it)
#   world X start-mirror NAME, open-mirror NAME   the J469 fallback: pi's own terminal UI in remote tmux, mirrored over ssh
#   world X binding          print the binding as JSON (world, ssh argv, workspace, remote folder) for other tools (phone app)
#   world X recover [--dry-run] [--start-desktop]   after the machine rebooted: wait until it answers, then start and open every
#                            agent that has a session there (J473). With "desktop" in the binding and omni-cli on the laptop it first
#                            checks the desktop is running; it starts a stopped one only with --start-desktop. --dry-run only checks
#                            and prints what it would do.
#
# The binding (private, never in this repo: host, user and login tool are site-specific):
#   ~/.config/hyprpi/remote/<letter>.json   { "ssh": ["ssh", "user@host"], "label": "My server", "prefix": "srv-", "desktop": "its-hostname" }
# ("desktop", optional: the cloud desktop's hostname or UUID for omni-cli, used only by recover.)
# "ssh" is the argv that reaches the machine (plain ssh, or e.g. a Teleport `tsh ssh user@host`); the remote command is appended
# as its last argument; a "-t" in it is dropped where a pipe is needed and added where a terminal is. "label" is optional. The
# world's workspaces come from hyprpi's world layout (worldSize, default 10: world A = 1-10, B = 11-20, ...); "workspace" in the
# file overrides the first one. (The J469 file name world-<letter>.json is still read.)
set -euo pipefail
H="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
WL="${1:-}"; WL="${WL^^}"; shift || true
[[ "$WL" =~ ^[A-I]$ ]] || { echo "usage: world LETTER setup|jot|new|start|open|status|stop|start-mirror|open-mirror|binding [NAME]" >&2; exit 2; }
wl="${WL,,}"
CDIR="${XDG_CONFIG_HOME:-$HOME/.config}/hyprpi/remote"
CONF="${HYPRPI_REMOTE_CONF:-$CDIR/$wl.json}"
[[ -f "$CONF" || -n "${HYPRPI_REMOTE_CONF:-}" || ! -f "$CDIR/world-$wl.json" ]] || CONF="$CDIR/world-$wl.json"
[[ -f "$CONF" ]] || { echo "world: world $WL isn't bound to a remote machine; write $CDIR/$wl.json: { \"ssh\": [\"ssh\", \"user@host\"] }" >&2; exit 2; }
# J525 (review): a binding with "tailscale" makes setup send a secret key to the machine its "ssh" names, so before ANYTHING the
# binding names is run, it and its folders must be yours and not writable by others (brev/tailscale/ts-setup --check); the same for
# a binding with "modelsKeySource" (an inference key is sent)
if [[ "$(jq -c '.tailscale // false' "$CONF" 2>/dev/null)" != false && "$(jq -c '.tailscale // false' "$CONF" 2>/dev/null)" != null ]] || [[ -n "$(jq -r '.modelsKeySource // empty' "$CONF" 2>/dev/null)" ]]; then
  "$H/brev/tailscale/ts-setup" --check "$CONF" || exit 2
fi
mapfile -t SSH < <(jq -r '.ssh[]' "$CONF" | grep -vxE -- '-tt?')
(( ${#SSH[@]} )) || { echo "world: \"ssh\" is empty in $CONF" >&2; exit 2; }
SSHT=("${SSH[@]:0:${#SSH[@]}-1}" -t "${SSH[-1]}") # with a terminal (for the mirror window): -t before the host
size=$(node -e 'import(process.argv[1]).then(m=>console.log(m.loadConfig().worldSize||10)).catch(()=>console.log(10))' "$H/lib/paths.mjs" 2>/dev/null || echo 10)
idx=$(( $(printf '%d' "'$WL") - 64 ))
WS=$(jq -r '.workspace // empty' "$CONF"); WS="${WS:-$(( (idx - 1) * size + 1 ))}"
[[ "$WS" =~ ^[0-9]{1,3}$ ]] || { echo "world: bad workspace" >&2; exit 2; }
LABEL=$(jq -r '.label // empty' "$CONF")
PREFIX=$(jq -r '.prefix // empty' "$CONF"); [[ -z "$PREFIX" || "$PREFIX" =~ ^[a-z][a-z0-9-]{0,11}$ ]] || { echo "world: bad \"prefix\" in $CONF" >&2; exit 2; }
cmd="${1:-status}"; NAME="${2:-alpha}"
# J471 v2 (Angus: "let's pick better names, maybe they can start with 'omni-'"): the binding's "prefix" starts every new agent's
# name; `new` without a name picks one (prefix + three letters, like a host agent's "pi" + letters)
if [[ "$cmd" == new ]]; then
  if [[ -z "${2:-}" ]]; then abc=abcdefghijklmnopqrstuvwxyz; NAME="${PREFIX:-r-}${abc:RANDOM%26:1}${abc:RANDOM%26:1}${abc:RANDOM%26:1}"; elif [[ -n "$PREFIX" && "$NAME" != "$PREFIX"* ]]; then NAME="$PREFIX$NAME"; fi
fi
[[ "$cmd" == recover ]] && NAME=alpha # (recover takes flags, not a name)
[[ "$NAME" =~ ^[a-z][a-z0-9-]{0,30}$ || "$NAME" == all ]] || { echo "world: a name is lowercase letters, digits and -" >&2; exit 2; }
R="HYPRPI_REMOTE_WS=$WS bash ~/.hyprpi-$wl/remote.sh"
# J532 (Angus: "the colors of the agents and TUIs don't match the world colors"): the panels there read the theme from a copy of the
# laptop's Omarchy colours (~/.hyprpi-<x>/theme/colors.toml, remote.sh points them at it). Sent in the background, only when the
# laptop's colours changed since the last copy, so it never slows a window down.
push_theme() {
  local src="$HOME/.local/state/omarchy/current/theme/colors.toml" mark="${XDG_CACHE_HOME:-$HOME/.cache}/hyprpi-remote/theme-$wl-$(printf '%s ' "${SSH[@]}" | sha256sum | cut -c1-12).sha" # (review) per destination
  [[ -f "$src" ]] || return 0
  local sum; sum=$(sha256sum "$src" | cut -c1-64)
  [[ "${1:-}" != force && "$(cat "$mark" 2>/dev/null)" == "$sum" ]] && return 0
  mkdir -p "$(dirname "$mark")"
  local send='mkdir -p ~/.hyprpi-'"$wl"'/theme && cat > ~/.hyprpi-'"$wl"'/theme/colors.toml.new && mv ~/.hyprpi-'"$wl"'/theme/colors.toml.new ~/.hyprpi-'"$wl"'/theme/colors.toml'
  if [[ "${1:-}" == sync || "${1:-}" == force ]]; then "${SSH[@]}" "$send" < "$src" >/dev/null 2>&1 && echo "$sum" > "$mark"; return 0; fi # (a panel: before it starts there)
  ( "${SSH[@]}" "$send" < "$src" >/dev/null 2>&1 && echo "$sum" > "$mark" ) </dev/null >/dev/null 2>&1 &
  disown || true
}
# J559 (Angus "15b"): /jot-* in this world's agent windows writes to the LAPTOP's notes. The machine gets pi-jot (this laptop's
# committed copy, ~/Harness/pi-jot or HYPRPI_PIJOT_DIR) as a pi package and the laptop's jot.json (same kinds and folders); its agents
# run it in relay mode (remote.sh's pi-entry sets PI_JOT_RELAY=1), so every jot file access goes back through the laptop window.
jot_setup() {
  local pj="${HYPRPI_PIJOT_DIR:-$HOME/Harness/pi-jot}" jc="${PI_JOT_CONFIG:-$HOME/.pi/agent/jot.json}"
  [[ -d "$pj/.git" && -f "$pj/src/extension.ts" ]] || { echo "world: no pi-jot at $pj: /jot-* in this world's windows stays off"; return 0; }
  git -C "$pj" archive --format=tar HEAD | "${SSH[@]}" "set -e; d=\$HOME/.hyprpi-$wl/pi-jot; rm -rf \"\$d.new\"; mkdir -p \"\$d.new\"; tar -x -C \"\$d.new\"; test -f \"\$d.new/src/extension.ts\"; rm -rf \"\$d.old\"; [ ! -e \"\$d\" ] || mv \"\$d\" \"\$d.old\"; mv \"\$d.new\" \"\$d\"; rm -rf \"\$d.old\""
  [[ -f "$jc" ]] && "${SSH[@]}" "mkdir -p \$HOME/.pi/agent && cat > \$HOME/.pi/agent/jot.json.new && mv \$HOME/.pi/agent/jot.json.new \$HOME/.pi/agent/jot.json" < "$jc"
  "${SSH[@]}" "export PATH=\$HOME/.local/bin:\$PATH; node -e 'const fs=require(\"fs\"),p=process.env.HOME+\"/.pi/agent/settings.json\",pkg=process.env.HOME+\"/.hyprpi-$wl/pi-jot\";let j={};try{j=JSON.parse(fs.readFileSync(p,\"utf8\"))}catch{};const a=Array.isArray(j.packages)?j.packages:[];if(!a.includes(pkg)){j.packages=[...a,pkg];fs.writeFileSync(p,JSON.stringify(j,null,2)+\"\\n\")}'"
  echo "world: pi-jot $(git -C "$pj" rev-parse --short HEAD) installed for world $WL's agents: their /jot-* notes go to this laptop's $(jq -r '.root // "~/Obsidian"' "$jc" 2>/dev/null || echo ~/Obsidian) (agents started before this pick it up on their next start)"
}
case "$cmd" in
  binding) jq -n --arg w "$WL" --argjson ws "$WS" --arg label "$LABEL" --arg dir "~/.hyprpi-$wl" --arg conf "$CONF" --args '{world:$w, ssh:$ARGS.positional, workspace:$ws, label:$label, remoteDir:$dir, conf:$conf}' "${SSH[@]}" ;;
  setup)
    push_theme force # J532: setup always copies it (a rebuilt or new machine)
    # J516 (Angus: auto-stop "should be part of our hyprpi brev install when we first set up a brev instance"): a Brev box gets the
    # laptop's idle auto-stop first (timer enabled if missing, the instance registered, one line saying so); not a Brev box: silent
    "$H/brev/autostop/brev-autostop" setup-hook "$CONF" || echo "world: couldn't turn on Brev auto-stop (brev-autostop install by hand)" >&2
    "${SSH[@]}" "mkdir -p ~/.hyprpi-$wl && chmod 700 ~/.hyprpi-$wl && cat > ~/.hyprpi-$wl/remote.sh" < "$H/omnistation/remote.sh"
    "${SSH[@]}" "cat > ~/.hyprpi-$wl/hbroker.mjs.new && mv ~/.hyprpi-$wl/hbroker.mjs.new ~/.hyprpi-$wl/hbroker.mjs" < "$H/omnistation/hbroker.mjs"
    # hyprpi itself: this checkout's committed master as a tar (the remote may not reach the git host); a git clone there is updated
    # instead. (Ledger) ~/hyprpi is replaced only on an explicit "copy" answer: a failed probe (ssh error) changes nothing
    # (review) "copy" only for an empty place or a copy this script made (its .version marker); anything else there is left alone
    kind=$("${SSH[@]}" 'if [ -d ~/hyprpi/.git ]; then echo git; elif [ ! -e ~/hyprpi ] || [ -f ~/hyprpi/.version ]; then echo copy; else echo foreign; fi' 2>/dev/null | tr -d '\r' | tail -1) || kind=""
    [[ "$kind" != foreign ]] || { echo "world: ~/hyprpi on the remote machine is neither a git clone nor a copy made by this script; move it away first" >&2; exit 3; }
    [[ "$kind" == git || "$kind" == copy ]] || { echo "world: couldn't reach the remote machine (is the login still valid?); nothing changed" >&2; exit 3; }
    if [[ "$kind" == copy ]]; then
      ver=$(git -C "$H" rev-parse --short master)
      { git -C "$H" archive --format=tar master; } | "${SSH[@]}" "set -e; n=\$(mktemp -d \"\$HOME/hyprpi.new.XXXXXX\"); trap 'rm -rf \"\$n\"' EXIT; tar -x -C \"\$n\"; test -f \"\$n/bin/hyprpi\"; echo $ver > \"\$n/.version\"; if [ -e \"\$HOME/hyprpi.old\" ]; then [ -f \"\$HOME/hyprpi.old/.version\" ] || { echo 'world: ~/hyprpi.old exists and is not ours; move it away' >&2; rm -rf \"\$n\"; exit 3; }; rm -rf \"\$HOME/hyprpi.old\"; fi; [ ! -e \"\$HOME/hyprpi\" ] || mv \"\$HOME/hyprpi\" \"\$HOME/hyprpi.old\"; mv \"\$n\" \"\$HOME/hyprpi\"; trap - EXIT"  # (review) a unique staging folder; only our own marked copies are ever removed; the previous one stays as ~/hyprpi.old
    fi
    # J480: the human's name (this laptop's) and the binding's optional "thoughtsModel" go to the remote config
    un=$(node -e 'import(process.argv[1]).then(m=>console.log(m.userName())).catch(()=>{})' "$H/lib/policy.mjs" 2>/dev/null | tr -cd "A-Za-z .'-")
    tm=$(jq -r '.thoughtsModel // empty' "$CONF" | tr -cd 'A-Za-z0-9._/:-')
    nt=$(node "$H/bin/hyprpi" ntfy config --json 2>/dev/null | tr -d '\n')  # J528: the laptop's phone push settings go along
    # J547: a brev-sync pair for this machine (~/.config/hyprpi/brev-sync.conf, its BOX = the binding's ssh host, e.g. "hub") tells
    # the machine's agents where hand-offs go: "REMOTE-FOLDER|LAPTOP-FOLDER"; none = no such note there
    sc="${XDG_CONFIG_HOME:-$HOME/.config}/hyprpi/brev-sync.conf"; shr=""
    [[ -f "$sc" ]] && shr=$(awk -v b="${SSH[-1]}" '{sub(/#.*/, "")} $2==b && NF>=3 {print $3 "|" $1; exit}' "$sc" | tr -cd 'A-Za-z0-9._/~|-')
    "${SSH[@]}" "HYPRPI_REMOTE_PREFIX=$(printf %q "$PREFIX") HYPRPI_REMOTE_USER_NAME=$(printf %q "$un") HYPRPI_REMOTE_THOUGHTS_MODEL=$(printf %q "$tm") HYPRPI_REMOTE_NTFY=$(printf %q "$nt") HYPRPI_REMOTE_SHARED=$(printf %q "$shr") $R install"
    # J525 (Angus: Tailscale "as part of our hyprpi brev setup? or at least as an option for direct remote control"): off unless the
    # binding has "tailscale" (true, or { "hostname": …, "ssh": true|false, "authKeyFile": … }). The machine joins Angus's tailnet
    # (brev/tailscale/ts-join.sh) with an auth key from a laptop secrets file, sent over ssh on stdin, never printed or kept
    # there; a machine already in the tailnet needs no key (idempotent). Tailscale SSH is on unless "ssh": false.
    "$H/brev/tailscale/ts-setup" "$CONF" "$wl" "${SSH[@]}" || echo "world: Tailscale setup failed (above); the rest goes on" >&2
    # (node there trusts the system CA bundle, as remote.sh does: Omnistation inspects TLS)
    # J499/J500 (Angus: "a script so that it sets those up on any brev instance", "a similar config for models in omnistation"):
    # the NVIDIA Inference Hub models this world offers, from its config file: the binding's "models" (a path in this repo, e.g.
    # omnistation/models.jsonc for H), else brev/models.jsonc. It's resolved HERE (the "laptop" preset reads this laptop's scoped
    # list) and applied on the machine by lib/nv-models.mjs with the machine's own key: the binding's "modelsKeyFile", else a
    # Brev box's ~/workspace/.secrets/nv_inference_key (none there = it says so and changes nothing)
    mcfg=$(jq -r '.models // "brev/models.jsonc"' "$CONF"); [[ "$mcfg" =~ ^[A-Za-z0-9._/-]+\.jsonc?$ && "$mcfg" != *..* ]] || { echo "world: bad \"models\" in $CONF" >&2; exit 2; }
    mkey=$(jq -r '.modelsKeyFile // "~/workspace/.secrets/nv_inference_key"' "$CONF"); [[ "$mkey" =~ ^~?/?[A-Za-z0-9._/-]+$ ]] || { echo "world: bad \"modelsKeyFile\" in $CONF" >&2; exit 2; }
    # J525 (Angus: "get nv-inf keys etc"): the binding's optional "modelsKeySource" is a laptop file holding the machine's own,
    # dedicated Inference Hub key (Angus puts it there; 600 in a 700 folder). When the machine has no key yet, it's sent once, on
    # stdin, into "modelsKeyFile" there (600 in a 700 folder), never printed; a machine that has a key keeps it.
    msrc=$(jq -r '.modelsKeySource // empty' "$CONF"); msrc="${msrc/#\~/$HOME}"
    if [[ -n "$msrc" ]]; then
      if [[ ! -f "$msrc" ]]; then echo "world: no key at $msrc yet: the machine's hosted models wait for it" >&2
      elif (( (8#$(stat -c %a "$msrc") & 077) || (8#$(stat -c %a "$(dirname "$msrc")") & 077) )); then echo "world: $msrc must be 600 in a 700 folder; not sent" >&2
      elif ! "$H/brev/tailscale/ts-setup" --check "$CONF"; then echo "world: not sending the key (binding not safe)" >&2
      else
        kq=$(printf %q "$mkey"); kq="${kq/#\\~/\$HOME}"
        # (review) a unique private staging file, removed on any exit or signal; the transfer's failure is reported, setup goes on
        if ! "${SSH[@]}" "f=$kq; [ -s \"\$f\" ] && { cat >/dev/null; echo 'world: the machine already has its inference key (kept)'; exit 0; }; umask 077; d=\"\$(dirname \"\$f\")\"; mkdir -p \"\$d\" && chmod 700 \"\$d\" || exit 3; t=\"\$(mktemp \"\$d/.key.XXXXXX\")\" || exit 3; trap 'rm -f \"\$t\"' EXIT HUP INT TERM; tr -d '\r' > \"\$t\" && [ -s \"\$t\" ] && chmod 600 \"\$t\" && mv \"\$t\" \"\$f\" && echo 'world: inference key placed on the machine' || { echo 'world: placing the inference key failed'; exit 4; }" < "$msrc"; then
          echo "world: sending the inference key failed; the rest of setup goes on" >&2
        fi
      fi
    fi
    if nvm=$(node "$H/lib/models-resolve.mjs" --config "$H/$mcfg"); then
      printf '%s\n' "$nvm" | "${SSH[@]}" "cat > ~/.hyprpi-$wl/nv-models.json"
      "${SSH[@]}" "cat > ~/.hyprpi-$wl/nv-models.mjs && export PATH=\$HOME/.local/bin:\$HOME/.npm-global/bin:\$PATH; [ -n \"\${NODE_EXTRA_CA_CERTS:-}\" ] || [ ! -r /etc/ssl/certs/ca-certificates.crt ] || export NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt; HYPRPI_REMOTE_THOUGHTS_MODEL=$(printf %q "$tm") node ~/.hyprpi-$wl/nv-models.mjs --check --key-file $(printf %q "$mkey") --models ~/.hyprpi-$wl/nv-models.json" < "$H/lib/nv-models.mjs"
    else echo "world: $mcfg didn't resolve (above); the machine's nv-inference models are unchanged" >&2; fi
    jot_setup ;;
  jot) jot_setup ;; # (J559: just pi-jot + jot.json, also part of setup)
  start|status|stop) "${SSH[@]}" "$R $cmd $NAME" ;;
  rename) NEW="${3:-}"; [[ "$NEW" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || { echo "world: rename NAME NEW" >&2; exit 2; }
    "${SSH[@]}" "$R rename $NAME $NEW" && echo "renamed $NAME to $NEW (same session); reopen its window: world $WL open $NEW" ;;
  recover)
    # J473: bring the world back after the remote machine rebooted. Never powers anything on unless --start-desktop is given.
    dry=0; startdesk=0; for a in "${@:2}"; do case "$a" in --dry-run) dry=1 ;; --start-desktop) startdesk=1 ;; *) echo "world: recover [--dry-run] [--start-desktop]" >&2; exit 2 ;; esac; done
    say() { echo "recover $WL: $*"; }
    DESK=$(jq -r '.desktop // empty' "$CONF")
    if [[ -n "$DESK" ]] && command -v omni-cli >/dev/null; then
      [[ "$DESK" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || { echo "world: bad \"desktop\" in $CONF" >&2; exit 2; }
      # (its hostname or UUID: omni-cli desktop get doesn't take the display name); any failure reads as "unknown", never an exit
      dstate() { local j; j=$(AI_PIM_UTILS_TELEMETRY_DISABLED=1 omni-cli desktop get "$DESK" --json 2>/dev/null) || j=""; printf '%s' "$j" | jq -r '[.data.state, .data.desktop.state] | map(select(. != null)) | first // "unknown"' 2>/dev/null | tr "[:upper:]" "[:lower:]" | grep . || echo unknown; }
      st=$(dstate); say "desktop $DESK is $st"
      if [[ "$st" != running ]]; then
        if [[ "$st" == stopped ]] && (( startdesk )); then
          if (( dry )); then say "would start desktop $DESK (omni-cli desktop start)"; else say "starting desktop $DESK"; AI_PIM_UTILS_TELEMETRY_DISABLED=1 omni-cli desktop start "$DESK" >/dev/null; fi
        elif [[ "$st" == stopped ]]; then echo "world: desktop $DESK is stopped; start it yourself, or run recover --start-desktop" >&2; exit 3
        elif [[ "$st" == unknown ]]; then say "can't read the desktop's state (omni-cli login? VPN?); waiting for ssh only"
        fi
        if (( ! dry )) && [[ "$st" != unknown ]]; then for _ in $(seq 60); do st=$(dstate); [[ "$st" == running ]] && break; sleep 15; done; say "desktop $DESK is $st"; [[ "$st" == running ]] || { echo "world: desktop $DESK isn't running after 15 min" >&2; exit 3; }; fi
      fi
    elif [[ -n "$DESK" ]]; then say "omni-cli isn't installed here: no power check, waiting for ssh only"
    fi
    ok=0; for _ in $(seq $(( dry ? 1 : 40 ))); do if "${SSH[@]}" true </dev/null >/dev/null 2>&1; then ok=1; break; fi; sleep 15; done
    (( ok )) || { echo "world: the machine doesn't answer over ssh (login? VPN? still booting?)" >&2; exit 3; }
    say "the machine answers over ssh"
    mapfile -t NAMES < <("${SSH[@]}" "ls -1 ~/.hyprpi-$wl/sessions 2>/dev/null" </dev/null | tr -d '\r' | grep -xE '[a-z][a-z0-9-]{0,30}' || true)
    (( ${#NAMES[@]} )) || { say "no agent has a session there: nothing to start"; exit 0; }
    for n in "${NAMES[@]}"; do
      if (( dry )); then say "would run: world $WL start $n; world $WL open $n"; else "$0" "$WL" start "$n" && "$0" "$WL" open "$n"; fi
    done ;;
  start-mirror) "${SSH[@]}" "HYPRPI_REMOTE_MIRROR=1 $R start $NAME" ;;
  # J478 (Angus: "open the window first … then fill in the details as the agent becomes live"): the window opens at once and its
  # client's first connect starts the agent remotely (remote.sh connect), showing "starting NAME…" until it's live, or why it didn't start
  new) exec "$0" "$WL" open "$NAME" ;;
  open|open-mirror)
    if [[ "$cmd" == open ]]; then
      # J479: one window per agent: a window already running for it (its client keeps reconnecting and waits for a stopped agent
      # by itself) is reused, focusing nothing; recover and SUPER+A go through here too
      if pgrep -u "$(id -u)" -f "omnistation/remote-client\.mjs $WL $NAME\$" >/dev/null; then echo "agent $NAME already has a window (world $WL); not opening another"; exit 0; fi
      # the client's dependencies: pi's own packages, pinned to the laptop's pi version, in a cache folder
      DEPS="${HYPRPI_REMOTE_DEPS:-$HOME/.cache/hyprpi-remote}"; PIV=$(pi --version 2>/dev/null | tail -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true)
      PJ="$DEPS/node_modules/@earendil-works/pi-coding-agent/package.json"
      if [[ ! -f "$PJ" ]] || { [[ -n "$PIV" ]] && ! grep -q "\"version\": \"$PIV\"" "$PJ"; }; then
        mkdir -p "$DEPS"; [[ -f "$DEPS/package.json" ]] || echo '{"name":"hyprpi-remote-client","private":true}' > "$DEPS/package.json"
        (cd "$DEPS" && npm install --silent "@earendil-works/pi-coding-agent@${PIV:-latest}") || { echo "world: couldn't install the client's packages into $DEPS" >&2; exit 3; }
      fi
      run="env HYPRPI_REMOTE_DEPS=$(printf %q "$DEPS") HYPRPI_REMOTE_CONF=$(printf %q "$CONF") HYPRPI_REMOTE_WS=$WS node $(printf %q "$H/omnistation/remote-client.mjs") $WL $NAME"
    else
      run="$(printf '%q ' "${SSHT[@]}")$(printf '%q' "$R attach $NAME")"
    fi
    # (J471 v2) the same kitty setup as every hyprpi agent window (lib/terminal.mjs: your kitty.conf, then hyprpi's pi.conf); the
    # open-url world map knows the window by its class. The local window sets its own title ("📡 H: π - alpha - work", like G's)
    kc=(); uk="${KITTY_CONFIG_DIRECTORY:-${XDG_CONFIG_HOME:-$HOME/.config}/kitty}/kitty.conf"; [[ -f "$uk" ]] && kc+=(--config "$uk")
    [[ -f "$H/terminal-helpers/kitty/pi.conf" ]] && kc+=(--config "$H/terminal-helpers/kitty/pi.conf")
    [[ "$cmd" == open ]] && ttl=() || ttl=(--title "📡 $WL: $NAME")
    # J553 (2): a link Ctrl+clicked in this window names something on the REMOTE machine (file:///home/aforbes/…): this window's
    # kitty hands every link to laptop-act's `url` (http(s) opens here; a file:// path is copied from the machine to
    # ~/Downloads/hyprpi-<x>/ and opened, a type that could run something only gets its folder opened; anything else is refused)
    nd=$(command -v node || echo node)
    kc+=(-o "open_url_with=$(printf '%q ' "$nd" "$H/omnistation/laptop-act.mjs" "$WL")url")
    line="kitty --class=hyprpi.$wl-agent $(printf '%q ' "${kc[@]}" "${ttl[@]}")-- $run"
    [[ "$line" != *"]]"* ]] || { echo "world: can't open: the command contains ]]" >&2; exit 2; }
    # J532: on the workspace SUPER+A was pressed on (bin/hyprpi passes it), if it's one of this world's; else the world's first
    OWS="${HYPRPI_OPEN_WS:-$WS}"; [[ "$OWS" =~ ^[0-9]{1,3}$ ]] && (( OWS >= WS && OWS < WS + size )) || OWS="$WS"
    hyprctl dispatch "hl.dsp.exec_cmd([[${line}]], { workspace = \"$OWS silent\" })" >/dev/null
    push_theme # J532: the panels there draw in this world's colour
    # (J471 v2) the world's agents listed on the laptop like any world's (summon, pop-ups, agents panel): one status helper per world
    setsid -f node "$H/omnistation/world-status.mjs" "$WL" </dev/null >/dev/null 2>&1 || true
    echo "opened agent $NAME on workspace $OWS (world $WL${LABEL:+, $LABEL})" ;;
  images)
    # J483: copy the remote machine's new generated images (~/workspace/outputs: brev-image's PNGs) to ~/Brev and
    # print each as a file:// link. Only plain names (letters, digits, . _ -; brev-image makes no others) are copied.
    dest="${HYPRPI_IMAGES_DIR:-$HOME/Brev}"; mkdir -p "$dest"
    names=$("${SSH[@]}" "cd ~/workspace/outputs 2>/dev/null && python3 -c 'import os,re; [print(f) for f in sorted(os.listdir(\".\")) if re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9._-]*[.]png\", f) and os.path.isfile(f)]' || true" 2>/dev/null) || { echo "world: couldn't reach world $WL's machine (ssh failed)" >&2; exit 3; }  # (review) whole names only: one with a newline in it never matches
    new=(); while IFS= read -r n; do n="${n%$'\r'}"; [[ "$n" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.png$ && ! -e "$dest/$n" ]] && new+=("$n"); done <<< "$names"
    (( ${#new[@]} )) || { echo "no new images on world $WL"; exit 0; }
    "${SSH[@]}" "cd ~/workspace/outputs && tar -cf - -- ${new[*]}" | tar -xf - -C "$dest"
    for n in "${new[@]}"; do [[ -f "$dest/$n" ]] && echo "file://$dest/$n"; done ;;
  restart-daemon) "${SSH[@]}" "$R restart-daemon" ;; # J530: by its lock file's pid only (remote.sh), the agents keep running
  thoughts-relay)
    # J530: a message (JSON on stdin) for this world's Thoughts, which lives on the remote machine; prints its answer (JSON).
    # Used by the laptop daemon for ask_agent / talk / demand to "Thoughts-X" from other worlds.
    exec "${SSH[@]}" "$R thoughts-relay" ;;
  focus)
    # J543: agent NAME's laptop window, as a local agent.focus: jump to it (a parked one comes to this workspace first); none: open it
    # (world X open, only for an agent that has a session there) and jump to it once it maps. NAME is the launch name (omni-alpha,
    # not the id h-omni-alpha). Used by the remote panels' relay (pty-relay.py) and the laptop daemon (toast clicks).
    exec node "$H/omnistation/laptop-act.mjs" "$WL" focus "$NAME" ;;
  panel)
    # J480 (Angus: "I'm tsh'ing in, why can't I connect to them remotely?"): one of the world's panels (room = Stream,
    # board = Projects, search = Thoughts, agents) in a laptop window; the panel itself runs on the remote machine against the
    # world's own daemon (remote.sh panel), over ssh -t, and panel-loop.sh brings it back after a drop or an expired login.
    # One window per world and kind: an open one is left as it is (mockups/panels moves it). HYPRPI_PANEL_WS: where it opens.
    [[ "$NAME" =~ ^(room|board|search|agents)$ ]] || { echo "world: panel room|board|search|agents" >&2; exit 2; }
    # (review) one opener at a time per world and kind: the check, the launch and the wait for the new window's loop are all under
    # one lock, so two quick opens can't both launch
    lk="${XDG_RUNTIME_DIR:-/tmp}/hyprpi-panel-$wl-$NAME.lock"; exec 9>"$lk"; flock -w 15 9 || { echo "world: another open of this panel is still running" >&2; exit 3; }
    setsid -f node "$H/omnistation/world-status.mjs" "$WL" </dev/null >/dev/null 2>&1 || true # J543: the world's panels keep its status helper (auto-open of new agents, sounds) running too (one per world: its lock)
    if pgrep -u "$(id -u)" -f "omnistation/panel-loop\.sh $WL $NAME " >/dev/null; then echo "world $WL's $NAME panel is already open"; exit 0; fi
    PWS="${HYPRPI_PANEL_WS:-$WS}"; [[ "$PWS" =~ ^[0-9]{1,3}$ ]] || { echo "world: bad HYPRPI_PANEL_WS" >&2; exit 2; }
    # the same kitty keys as the host's panels (mockups/room-tui): Shift/Ctrl clicks reach the TUI, CSI-u for Shift+Space/Enter;
    # in the Thoughts panel, as on the host, SUPER+V (Shift+Insert) reaches the panel (J543), which pastes the laptop's clipboard
    # through the relay, images included; the other panels let kitty paste text
    ko=(-o copy_on_select=clipboard -o "mouse_map=shift+left click grabbed" -o "mouse_map=shift+left press grabbed" -o "mouse_map=shift+left doublepress grabbed" -o "mouse_map=shift+left triplepress grabbed" -o "mouse_map=ctrl+left press grabbed" -o "mouse_map=ctrl+left release grabbed" -o "mouse_map=ctrl+shift+left press grabbed mouse_selection normal" -o "mouse_map=ctrl+shift+left doublepress grabbed mouse_selection word" -o "mouse_map=ctrl+shift+left triplepress grabbed mouse_selection line" -o 'map shift+space send_text all \x1b[32;2u' -o 'map shift+enter send_text all \x1b[13;2u' -o 'map ctrl+enter send_text all \x1b[13;5u' -o 'map ctrl+insert copy_or_noop' -o 'map ctrl+tab send_text all \x1b[9;5u' -o 'map ctrl+shift+tab send_text all \x1b[9;6u' -o "map shift+insert $([[ $NAME == search ]] && echo no_op || echo paste_from_clipboard)")
    kt=$([[ $NAME == agents ]] && echo router || echo "$NAME")
    line="kitty --class=hyprpi.$wl-panel --title $(printf %q "hyprpi-$kt $WL") $(printf '%q ' "${ko[@]}")-- env HYPRPI_REMOTE_WS=$WS $(printf %q "$H/omnistation/panel-loop.sh") $WL $NAME $(printf '%q ' "${SSHT[@]}")"
    [[ "$line" != *"]]"* ]] || { echo "world: can't open: the command contains ]]" >&2; exit 2; }
    push_theme sync # J532: before the panel starts there
    hyprctl dispatch "hl.dsp.exec_cmd([[${line}]], { workspace = \"$PWS silent\" })" >/dev/null
    for _ in $(seq 40); do pgrep -u "$(id -u)" -f "omnistation/panel-loop\.sh $WL $NAME " >/dev/null && break; sleep 0.25; done  # hold the lock until it runs
    echo "opened world $WL's $NAME panel on workspace $PWS" ;;
  *) echo "usage: world LETTER setup|new|start|open|focus|status|stop|start-mirror|open-mirror|binding|recover|panel|images [NAME]" >&2; exit 2 ;;
esac
