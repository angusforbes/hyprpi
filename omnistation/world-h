#!/usr/bin/env bash
# world-h: the laptop side of a remote world (J469, world H). Its agents run headless on a remote machine (omnistation/remote.sh);
# here each one is just a kitty window on world H's workspaces, attached over ssh to the agent's tmux session.
#
#   world-h setup            copy remote.sh to the remote machine and install hyprpi there (git clone + pi)
#   world-h start [NAME]     start the remote daemon and agent NAME (default alpha)
#   world-h new NAME         start agent NAME remotely and open its window (start + open)
#   world-h open [NAME]      open a window for agent NAME on world H's first workspace, silently (your view doesn't move)
#   world-h status           what runs remotely
#   world-h stop [NAME|all]  stop an agent remotely (its session stays)
#
# Private settings (never in this repo: the host, the user and the login tool are site-specific):
#   ~/.config/hyprpi/remote/world-h.json   { "ssh": ["ssh", "-t", "me@my-server"], "workspace": 71 }
# "ssh" is the argv that reaches the machine with a terminal (plain ssh, or e.g. a Teleport `tsh ssh -t user@host`); the remote
# command is appended as its last argument.
set -euo pipefail
H="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CONF="${HYPRPI_REMOTE_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/hyprpi/remote/world-h.json}"
[[ -f "$CONF" ]] || { echo "world-h: no $CONF yet; write { \"ssh\": [\"ssh\", \"-t\", \"user@host\"], \"workspace\": 71 }" >&2; exit 2; }
mapfile -t SSH < <(jq -r '.ssh[]' "$CONF"); WS=$(jq -r '.workspace // 71' "$CONF")
(( ${#SSH[@]} )) || { echo "world-h: \"ssh\" is empty in $CONF" >&2; exit 2; }
[[ "$WS" =~ ^[0-9]{1,3}$ ]] || { echo "world-h: bad workspace" >&2; exit 2; }
cmd="${1:-status}"; NAME="${2:-alpha}"
[[ "$NAME" =~ ^[a-z][a-z0-9-]{0,30}$ || "$NAME" == all ]] || { echo "world-h: a name is lowercase letters, digits and -" >&2; exit 2; }
R='bash ~/.hyprpi-h/remote.sh'
case "$cmd" in
  setup)
    # (no -t for the copy: stdin carries the script)
    plain=(); for a in "${SSH[@]}"; do [[ "$a" == "-t" ]] || plain+=("$a"); done
    "${plain[@]}" 'mkdir -p ~/.hyprpi-h && chmod 700 ~/.hyprpi-h && cat > ~/.hyprpi-h/remote.sh' < "$H/omnistation/remote.sh"
    # hyprpi itself: this checkout's committed master as a tar (the remote may not reach the git host); a git clone there is updated instead
    if ! "${plain[@]}" 'test -d ~/hyprpi/.git'; then
      ver=$(git -C "$H" rev-parse --short master)
      { git -C "$H" archive --format=tar master; } | "${plain[@]}" "rm -rf ~/hyprpi.new && mkdir -p ~/hyprpi.new && tar -x -C ~/hyprpi.new && echo $ver > ~/hyprpi.new/.version && rm -rf ~/hyprpi && mv ~/hyprpi.new ~/hyprpi"
    fi
    "${SSH[@]}" "$R install" ;;
  start|status|stop) "${SSH[@]}" "$R $cmd $NAME" ;;
  new) "${SSH[@]}" "$R start $NAME" && exec "$0" open "$NAME" ;;  # start agent NAME remotely, then its window
  open)
    q() { printf '%q ' "$@"; }
    line="kitty --class=hyprpi.h-agent --title='🛰 H: $NAME' -- $(q "${SSH[@]}")$(printf '%q' "$R attach $NAME")"
    [[ "$line" != *"]]"* ]] || { echo "world-h: can't open: the command contains ]]" >&2; exit 2; }
    hyprctl dispatch "hl.dsp.exec_cmd([[${line}]], { workspace = \"$WS silent\" })" >/dev/null
    echo "opened agent $NAME on workspace $WS (world H)" ;;
  *) echo "usage: world-h setup | new NAME | start [NAME] | open [NAME] | status | stop [NAME|all]" >&2; exit 2 ;;
esac
