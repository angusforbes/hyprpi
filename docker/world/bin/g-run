#!/usr/bin/env node
// Runs, inside the sandbox, what bin/kitty saved under TOKEN (J262): the host's new window calls
// `sbx exec -it <sandbox> g-run TOKEN`. A launch file is used once and deleted.
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawn } from "node:child_process";
const tok = process.argv[2] || "";
if (!/^[0-9a-f]{24}$/.test(tok)) { console.error("g-run: bad token"); process.exit(2); }
const f = path.join(os.homedir(), ".hyprpi-g", "launch", `${tok}.json`);
let spec; try { spec = JSON.parse(fs.readFileSync(f, "utf8")); fs.unlinkSync(f); } catch { console.error("g-run: no such launch"); process.exit(2); }
try { process.chdir(spec.cwd); } catch { /* stay */ }
// J362: never two pi processes on one agent (session): a reopen while the old pi still runs inside the sandbox (its
// window closed, it wasn't ended) would put two writers on the same session. Refuse, and say so in the window.
const agentId = /^[A-Za-z0-9._-]{1,80}$/.test(String(spec.env?.HYPRPI_AGENT_ID || "")) ? String(spec.env.HYPRPI_AGENT_ID) : "";
// (GrunReview) an agent-scoped KERNEL lock held for this g-run's whole life makes the check atomic: two g-runs started
// at the same moment can't both pass, and the kernel drops it when this g-run dies (even SIGKILL), so no stale lock.
const locked = agentId ? await lockAgent(agentId) : "free";
if (agentId && locked === "none") console.error(`g-run: couldn't take the lock for ${agentId} (flock); only the running-pi check guards against a second pi`);
const running = locked === "held" ? ["its window's g-run"] : agentId ? otherPiFor(agentId) : [];
if (running.length) {
  process.stdout.write(`g-run: ${agentId} is already running in this sandbox (${running.map((x) => typeof x === "number" ? `pid ${x}` : x).join(", ")}), so a second pi isn't started on its session.\r\nClose the other window, or end that pi, then reopen. Press Enter to close this window.\r\n`);
  if (process.stdin.isTTY) { process.stdin.setRawMode?.(false); process.stdin.once("data", () => process.exit(3)); setTimeout(() => process.exit(3), 120000).unref(); }
  else process.exit(3);
} else start();
// "free" (this g-run now holds it until it exits), "held" (another live g-run holds it), or "none" (no lock
// possible here: the /proc pi scan still guards). `flock` keeps the lock while its stdin (a pipe from this
// process) is open; the pipe closes when this process exits, whatever the reason.
function lockAgent(id) {
  const dir = path.join(os.homedir(), ".hyprpi-g", "run"), f = path.join(dir, `agent-${id}.lock`);
  try { fs.mkdirSync(dir, { recursive: true, mode: 0o700 }); } catch { /* */ }
  return new Promise((resolve) => {
    let l; try { l = spawn("flock", ["--nonblock", "--conflict-exit-code", "75", f, "sh", "-c", "echo LOCKED; exec cat >/dev/null"], { stdio: ["pipe", "pipe", "ignore"] }); } catch { return resolve("none"); }
    let done = false; const end = (r) => { if (!done) { done = true; resolve(r); } };
    l.stdout.on("data", (d) => { if (/LOCKED/.test(String(d))) { l.unref(); l.stdout.unref?.(); l.stdin.unref?.(); end("free"); } });
    l.on("exit", (code) => end(code === 75 ? "held" : "none"));
    l.on("error", () => end("none"));
    setTimeout(() => end("none"), 5000).unref();
  });
}
function otherPiFor(id) {
  const out = [];
  let ents = []; try { ents = fs.readdirSync("/proc"); } catch { return out; }
  for (const p of ents) {
    if (!/^\d+$/.test(p) || Number(p) === process.pid) continue;
    try {
      const argv0 = path.basename((fs.readFileSync(`/proc/${p}/cmdline`, "utf8").split("\0")[0] || "").trim().split(/\s+/)[0] || ""); // (pi sets process.title: "pi" padded with spaces)
      const comm = fs.readFileSync(`/proc/${p}/comm`, "utf8").trim();
      if (argv0 !== "pi" && comm !== "pi") continue;
      if (fs.readFileSync(`/proc/${p}/environ`, "utf8").split("\0").includes(`HYPRPI_AGENT_ID=${id}`)) out.push(Number(p));
    } catch { /* gone or not ours */ }
  }
  return out;
}
// J362: the inbox where world-helper writes closed-<token>. `sbx exec -it … g-run` doesn't source g-env.sh, so
// HYPRPI_G_IN was unset and g-run watched /nonexistent: a closed window left its pi running. Take it from this
// process, else the launch's own environment (the inner daemon's, which has it), else ~/.hyprpi-g/host.env.
function inboxDir() {
  const ok = (d) => typeof d === "string" && path.isAbsolute(d) && !d.includes("\0") ? d : "";
  let fromHost = "";
  try { fromHost = (/^G_HYPR_INBOX=(.*)$/m.exec(fs.readFileSync(path.join(os.homedir(), ".hyprpi-g", "host.env"), "utf8")) || [])[1] || ""; } catch { /* */ }
  return ok(process.env.HYPRPI_G_IN) || ok(spec.env?.HYPRPI_G_IN) || ok(fromHost.trim());
}
function start() {
const c = spawn(spec.argv[0], spec.argv.slice(1), { stdio: "inherit", env: { ...spec.env, PI_HYPERLINKS: "1" } });
c.on("exit", (code, sig) => process.exit(sig ? 1 : code ?? 0));
c.on("error", (e) => { console.error(`g-run: ${e.message}`); process.exit(1); });
for (const s of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(s, () => c.kill(s));
// When the host window closes, `sbx exec` leaves this session (and its pty) alive inside the sandbox, so
// nothing in here can tell (J262). The host's world-helper notices the window closing and writes
// closed-<token> into the read-only inbox; then this program is ended (SIGHUP, then SIGKILL).
const inbox = inboxDir();
if (!inbox) console.error("g-run: no inbox path (HYPRPI_G_IN / host.env): a closed window won't end this program");
const closed = inbox ? path.join(inbox, `closed-${tok}`) : "";
let ending = false;
if (closed) setInterval(() => {
  if (ending || !fs.existsSync(closed)) return;
  ending = true;
  try { c.kill("SIGHUP"); } catch { /* */ }
  setTimeout(() => { try { c.kill("SIGKILL"); } catch { /* */ } process.exit(1); }, 3000);
}, 2000).unref();
}
