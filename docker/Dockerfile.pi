# Plain pi-sandbox image (per pi docs/containerization.md). The pi version is pinned in ONE place,
# docker/PI_VERSION, shared with hyprpi's installer (`hyprpi integration install pi`).
FROM node:24-bookworm-slim
COPY PI_VERSION /etc/pi-version
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git ripgrep procps curl wget python3 jq file unzip \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@"$(cat /etc/pi-version)"
WORKDIR /workspace
ENTRYPOINT ["pi"]
